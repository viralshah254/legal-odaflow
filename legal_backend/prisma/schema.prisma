  eventType         String
  matterProfileHash String
  practiceArea      String
  subPracticeArea   String?
  nature            String
  documentId        String?
  documentKind      String?
  tenantId          String?
  userId            String?
  createdAt         DateTime @default(now())

  @@index([matterProfileHash, eventType])
  @@index([practiceArea, subPracticeArea])
  @@index([tenantId, createdAt])
}

model MatterIntelligenceReview {
  id                 String    @id @default(cuid())
  tenantId           String?
  entityType         String
  entityId           String?
  profileSnapshot    Json
  correction         Json?
  recommendationMode String
  status             String    @default("pending")
  reviewerId         String?
  createdAt          DateTime  @default(now())
  reviewedAt         DateTime?

  @@index([status, createdAt])
  @@index([tenantId])
}

// ─── Matter Budget ────────────────────────────────────────────────────────────

model MatterBudget {
  id                 String   @id @default(cuid())
  tenantId           String
  matterId           String   @unique
  currency           String
  phases             Json // [{ phase, estimatedHours, estimatedFees, actualHours, actualFees }]
