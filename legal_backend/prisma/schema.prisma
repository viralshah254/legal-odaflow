generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  firebaseUid            String?   @unique
  phone                  String?
  name                   String?
  passwordHash           String?
  whatsappMarketingOptIn Boolean   @default(false)
  whatsappOptOutAt       DateTime?
  userType               String    @default("CONSUMER")
  countryCode            String?
  jurisdiction           String?
  isActive               Boolean   @default(true)
  mustChangePassword     Boolean   @default(false)
  firstLoginAt           DateTime?
  // Invitation tracking
  invitationToken        String?   @unique
  invitationStatus       String? // PENDING | ACCEPTED | EXPIRED | REVOKED
  invitedAt              DateTime?
  invitationExpiresAt    DateTime?
  invitationAcceptedAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  consumerProfile             ConsumerProfile?
  tenantUsers                 TenantUser[]
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]
  consumerCases               ConsumerCase[]
  consumerDocuments           ConsumerDocument[]
  consumerReports             ConsumerLegalReport[]
  createdTemplates            DocumentTemplate[]           @relation("TemplateCreatedBy")
  draftingSessions            DraftingSession[]
  lawyerProfile               LawyerProfile?
  aiOutputs                   AIOutput[]
  aiUsageLogs                 AIUsageLog[]
  matterAccess                MatterAccess[]
  copilotSessions             CopilotSession[]
  uploadedDocuments           Document[]                   @relation("DocumentUploader")
  portalDocumentRequests      PortalDocumentRequest[]      @relation("PortalRequestRequester")
  portalMessages              PortalMessage[]              @relation("PortalMessageSender")
  notifications               Notification[]
  deviceTokens                DeviceToken[]
  trainingConsents            TrainingConsent[]
  documentTrainingPermissions DocumentTrainingPermission[]
  aiCreditLedger              AICreditLedger[]
  aiBudgetPolicies            AIBudgetPolicy[]
  courtDraftRecords           CourtDraftRecord[]
  lawyerLeads                 LawyerLead[]
  preferences                 UserPreferences?
  draftStyle                  UserDraftStyle?
  referralCode                ReferralCode?
  referralsGiven              Referral[]                   @relation("ReferralReferrer")
  referralReceived            Referral?                    @relation("ReferralReferee")
  deviceFingerprints          UserDeviceFingerprint[]
  matterNotes                 MatterNote[]
  leadMatters                 Matter[]                     @relation("MatterLeadAttorney")
  legalTaskPatterns           LegalTaskPattern[]
  taskPatternUsages           TaskPatternUsage[]
  adminProfile                String? // "CTO" | "CFO_CMO" — only set for SUPER_ADMIN users
  adminTodoCompletions        AdminTodoCompletion[]
  manualCitationReviews       ManualCitationReview[]
  whatsappMessages            WhatsappMessage[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tenant {
  firmKnowledgeItems FirmKnowledgeItem[]
  id                         String    @id @default(cuid())
  name                       String
  type                       String    @default("LAW_FIRM")
  primaryCountry             String
  defaultCurrency            String
  billingPlan                String?
  billingTimezone            String    @default("UTC")
  aiCreditsRemaining         Int       @default(0)
  aiModelMode                String    @default("AUTO")
  premiumModelId             String    @default("gpt-5.5")
  deepAnalysisPremiumModelId String    @default("claude-opus-4-8")
  autoTopUpEnabled           Boolean   @default(false)
  autoTopUpThresholdCredits  Int       @default(10)
  autoTopUpPackId            String    @default("pack_25")
  stripeCustomerId           String?
  stripePaymentMethodId      String?
  autoTopUpLastTriggeredAt   DateTime?
  dataRegion                 String?
  ssoConfig                  Json?
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenantUsers                 TenantUser[]
  clients                     Client[]
  matters                     Matter[]
  documents                   Document[]
  timeEntries                 TimeEntry[]
  invoices                    Invoice[]
  trustAccounts               TrustAccount[]
  tasks                       Task[]
  calendarEvents              CalendarEvent[]
  auditLogs                   AuditLog[]
  subscriptions               Subscription[]
  payments                    Payment[]
  aiOutputs                   AIOutput[]
  aiUsageLogs                 AIUsageLog[]
  meetings                    Meeting[]
  alerts                      Alert[]
  documentTemplates           DocumentTemplate[]
  draftingSessions            DraftingSession[]
  expenses                    Expense[]
  claims                      Claim[]
  fixedCosts                  FixedCost[]
  automationRules             AutomationRule[]
  notifications               Notification[]
  timelineEvents              TimelineEvent[]
  assistanceRequests          AssistanceRequest[]
  documentFolders             DocumentFolder[]
  documentVersions            DocumentVersion[]
  documentAccessRules         DocumentAccessRule[]
  firmProfile                 FirmProfile?
  documentPolicies            DocumentPolicy[]
  accessPolicies              AccessPolicy[]
  portalDocumentRequests      PortalDocumentRequest[]
  portalMessages              PortalMessage[]
  matterPlaybooks             MatterPlaybook[]
  trainingConsents            TrainingConsent[]
  documentTrainingPermissions DocumentTrainingPermission[]
  aiCreditLedger              AICreditLedger[]
  aiBudgetPolicies            AIBudgetPolicy[]
  courtDraftRecords           CourtDraftRecord[]
  lawyerLeads                 LawyerLead[]
  caseAnalysisRuns            CaseAnalysisRun[]
  matterIssues                MatterIssue[]
  matterArguments             MatterArgument[]
  matterStrategyMemos         MatterStrategyMemo[]
  matterAnalysisRuns          MatterAnalysisRun[]
  matterParties               MatterParty[]
  conflictChecks              ConflictCheck[]
  matterOutcomeAnalyses       MatterOutcomeAnalysis[]
  courtCases                  CourtCase[]
  integrationConnections      IntegrationConnection[]
  rateTables                  RateTable[]
  preBillSessions             PreBillSession[]
  trustReconciliations        TrustReconciliation[]
  suggestedTimeEntries        SuggestedTimeEntry[]
  marketplaceRevenue          MarketplaceRevenueEntry[]
  evidenceItems               EvidenceItem[]
  ethicalWallGroups           EthicalWallGroup[]
  webhookSubscriptions        WebhookSubscription[]
  publicApiKeys               PublicApiKey[]
  bulkDocReviewJobs           BulkDocumentReviewJob[]
  integrationSyncLogs         IntegrationSyncLog[]
  unifiedInboxThreads         UnifiedInboxThread[]
  questionnaires              Questionnaire[]
  matterNotes                 MatterNote[]
  matterBudgets               MatterBudget[]
  courtDeadlines              CourtDeadline[]
  jurisdictionForms           JurisdictionForm[]
  eSignEnvelopes              ESignEnvelope[]
  savedDocumentReviews        SavedDocumentReview[]
  savedResearch               SavedResearch[]
  monitors                    Monitor[]
  legalTaskPatterns           LegalTaskPattern[]
  taskPatternUsages           TaskPatternUsage[]
  platformRevenue             PlatformRevenueEntry[]
  smartWorkspaces             SmartWorkspace[]
  manualCitationReviewTasks   ManualCitationReviewTask[]
  manualCitationReviews       ManualCitationReview[]
}

model TenantUser {
  id                    String    @id @default(cuid())
  tenantId              String
  userId                String
  role                  String
  status                String    @default("ACTIVE")
  practiceAreas         Json? // string[] of practice-area slugs this user handles
  specialtyLevel        Json? // { [slug]: "Junior" | "Senior" | "Partner" | "Consultant" }
  displayTitle          String? // e.g. "Senior IP Associate", "Head of Conveyancing"
  seatPlan              String?   @default("STARTER") // per-seat billing plan: STARTER | PROFESSIONAL | PRO_PLUS
  seatPlanUpdatedAt     DateTime? // last time the seat plan was changed
  // AI credit allocation
  monthlyCreditLimit    Int? // null=unlimited; 0=AI blocked; >0=monthly cap in credits
  creditCycleOverrideAt DateTime? // manual cycle reset: effective start = max(calendarMonthStart, this)
  // Seat billing (separate from AI credit allocation)
  isBillableSeat        Boolean   @default(true)
  billingStatus         String    @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED | EXEMPT
  activatedAt           DateTime  @default(now())
  deactivatedAt         DateTime?
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([userId])
}

model ConsumerProfile {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  countryCode               String
  stateOrCounty             String?
  preferredLanguage         String    @default("en")
  subscriptionStatus        String    @default("FREE")
  aiCreditsRemaining        Int       @default(100)
  aiModelMode               String    @default("AUTO")
  premiumModelId            String    @default("gpt-5.5")
  autoTopUpEnabled          Boolean   @default(false)
  autoTopUpThresholdCredits Int       @default(10)
  autoTopUpPackId           String    @default("pack_25")
  stripeCustomerId          String?
  stripePaymentMethodId     String?
  autoTopUpLastTriggeredAt  DateTime?
  governanceSettings        Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsumerCase {
  id              String                @id @default(cuid())
  userId          String
  countryCode     String
  jurisdiction    String?
  issueType       String
  title           String
  facts           String?
  desiredOutcome  String?
  urgencyLevel    String                @default("LOW")
  riskScore       Float?
  planningAnswers Json?
  matterProfile   Json?
  matterGraph     Json?
  matterTaskGraph Json?
  status          String                @default("DRAFT")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       ConsumerDocument[]
  reports         ConsumerLegalReport[]
  reviewRequests  LawyerReviewRequest[]

  @@index([userId])
  @@index([countryCode, issueType])
}

model ConsumerDocument {
  id             String       @id @default(cuid())
  userId         String
  consumerCaseId String
  fileName       String
  fileUrl        String
  mimeType       String?
  fileSizeBytes  Int?
  documentType   String?
  extractedText  String?
  aiSummary      String?
  ocrStatus      String       @default("PENDING")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumerCase   ConsumerCase @relation(fields: [consumerCaseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consumerCaseId])
}

model ConsumerLegalReport {
  id                 String       @id @default(cuid())
  userId             String
  consumerCaseId     String
  countryCode        String
  reportType         String
  title              String
  contentMarkdown    String
  citations          Json?
  riskLevel          String?
  requiresLawyer     Boolean      @default(false)
  lawyerReviewStatus String       @default("NOT_REQUESTED")
  reviewedByLawyerId String?
  isPreview          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumerCase       ConsumerCase @relation(fields: [consumerCaseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consumerCaseId])
}

model LawyerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  tenantId             String?
  countryCode          String
  barNumber            String?
  verified             Boolean  @default(false)
  verificationStatus   String   @default("PENDING")
  practiceAreas        Json
  jurisdictions        Json
  languages            Json
  consultationFee      Decimal? @db.Decimal(10, 2)
  currency             String
  acceptsLeads         Boolean  @default(true)
  specialtyLevel       Json? // { [slug]: "Junior" | "Senior" | "Partner" | "Consultant" }
  jurisdictionLicenses Json? // { KE: "LSK/12345", US: "CA Bar 67890", GB: "SRA 123", IN: "BCI/456" }
  yearsExperience      Int?
  bio                  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LawyerReviewRequest {
  id               String       @id @default(cuid())
  consumerCaseId   String
  consumerReportId String?
  userId           String
  countryCode      String
  jurisdiction     String?
  issueType        String
  status           String       @default("OPEN")
  assignedLawyerId String?
  assignedTenantId String?
  price            Decimal      @db.Decimal(10, 2)
  currency         String
  createdAt        DateTime     @default(now())
  completedAt      DateTime?
  consumerCase     ConsumerCase @relation(fields: [consumerCaseId], references: [id], onDelete: Cascade)

  @@index([countryCode, issueType, status])
}

model Client {
  id                     String                  @id @default(cuid())
  tenantId               String
  clientCode             String
  name                   String
  email                  String?
  phone                  String?
  address                String?
  type                   String                  @default("INDIVIDUAL")
  contactPeople          Json? // Array of {name, role, email, phone} for Company/NGO/Partnership contacts
  countryCode            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matters                Matter[]
  documents              Document[]
  kycChecklists          KycChecklist[]
  kycDocuments           KycDocument[]
  documentFolders        DocumentFolder[]
  portalDocumentRequests PortalDocumentRequest[]
  portalMessages         PortalMessage[]
  savedDocumentReviews   SavedDocumentReview[]
  savedResearch          SavedResearch[]
  smartWorkspaces        SmartWorkspace[]

  @@unique([tenantId, clientCode])
  @@index([tenantId])
  @@index([tenantId, email]) // service-level dedupe enforces uniqueness; index aids lookup
}

model Matter {
  firmKnowledgeItems FirmKnowledgeItem[]
  id                     String                   @id @default(cuid())
  tenantId               String
  clientId               String?
  leadAttorneyId         String?
  title                  String
  countryCode            String
  jurisdiction           String?
  courtName              String?
  courtLevel             String?
  caseNumber             String?
  practiceArea           String
  matterType             String
  status                 String                   @default("OPEN")
  stage                  String?
  factsSummary           String?
  legalIssues            Json?
  desiredOutcome         String?
  opposingParty          String?
  planningAnswers        Json?
  draftWorkspace         Json?
  matterProfile          Json?
  matterGraph            Json?
  matterTaskGraph        Json?
  riskScore              Float?
  aiConfidenceScore      Float?
  retainerBalance        Decimal?                 @db.Decimal(12, 2)
  retainerCurrency       String?
  sourceLeadId           String?
  consumerCaseId         String?
  closedAt               DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                 Client?                  @relation(fields: [clientId], references: [id])
  leadAttorney           User?                    @relation("MatterLeadAttorney", fields: [leadAttorneyId], references: [id], onDelete: SetNull)
  facts                  MatterFact[]
  documents              Document[]
  timeEntries            TimeEntry[]
  invoices               Invoice[]
  tasks                  Task[]
  calendarEvents         CalendarEvent[]
  matterAccess           MatterAccess[]
  meetings               Meeting[]
  expenses               Expense[]
  claims                 Claim[]
  timelineEvents         TimelineEvent[]
  assistanceRequests     AssistanceRequest[]
  documentFolders        DocumentFolder[]
  portalDocumentRequests PortalDocumentRequest[]
  portalMessages         PortalMessage[]
  matterIssues           MatterIssue[]
  matterArguments        MatterArgument[]
  matterStrategyMemos    MatterStrategyMemo[]
  matterAnalysisRuns     MatterAnalysisRun[]
  matterParties          MatterParty[]
  outcomeAnalyses        MatterOutcomeAnalysis[]
  courtCases             CourtCase[]
  evidenceItems          EvidenceItem[]
  bulkDocReviewJobs      BulkDocumentReviewJob[]
  matterNotes            MatterNote[]
  budget                 MatterBudget?
  courtDeadlines         CourtDeadline[]
  eSignEnvelopes         ESignEnvelope[]
  savedDocumentReviews   SavedDocumentReview[]
  savedResearch          SavedResearch[]
  matterFactsV2          MatterFactV2[]           @relation("MatterFactV2")
  smartWorkspaces        SmartWorkspace[]
  formAttachments        MatterFormAttachment[]
  analysisSnapshots      MatterAnalysisSnapshot[]

  @@index([tenantId, sourceLeadId])
  @@index([tenantId, consumerCaseId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, leadAttorneyId])
}

model MatterPlaybook {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  matterType    String?
  countryCode   String?
  jurisdiction  String?
  practiceArea  String?
  taskTemplates Json
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isEnabled])
  @@index([tenantId, matterType, countryCode])
}

model MatterAccess {
  id          String   @id @default(cuid())
  tenantId    String
  matterId    String
  userId      String
  accessLevel String   @default("READ_ONLY")
  grantedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId])
  @@index([tenantId, userId])
  @@index([matterId])
}

model MatterFact {
  id               String   @id @default(cuid())
  tenantId         String
  matterId         String
  factText         String
  sourceType       String
  sourceId         String?
  confidence       Float    @default(0.5)
  isDisputed       Boolean  @default(false)
  approvedByLawyer Boolean  @default(false)
  createdAt        DateTime @default(now())
  matter           Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([tenantId, matterId])
}

model Document {
  id                      String               @id @default(cuid())
  tenantId                String
  matterId                String?
  clientId                String?
  folderId                String?
  documentCode            String               @unique @default(cuid())
  fileName                String
  fileUrl                 String
  mimeType                String?
  extractedText           String?
  htmlContent             String?
  visibility              String               @default("PRIVATE")
  status                  String               @default("ACTIVE")
  uploadedById            String?
  retentionUntil          DateTime?
  version                 Int                  @default(1)
  generatedFromTemplateId String?
  aiDraftStatus           String?
  docxUrl                 String?
  pdfUrl                  String?
  sourceConsumerDocId     String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter                  Matter?              @relation(fields: [matterId], references: [id])
  client                  Client?              @relation(fields: [clientId], references: [id])
  folder                  DocumentFolder?      @relation(fields: [folderId], references: [id])
  uploadedBy              User?                @relation("DocumentUploader", fields: [uploadedById], references: [id])
  versions                DocumentVersion[]
  accessRules             DocumentAccessRule[]
  workspaceDocs           WorkspaceDocument[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([matterId])
  @@index([clientId])
  @@index([folderId])
  @@index([generatedFromTemplateId])
}

model TimeEntry {
  id                String   @id @default(cuid())
  tenantId          String
  matterId          String?
  userId            String
  date              DateTime
  minutes           Int
  narrative         String?
  billable          Boolean  @default(true)
  rate              Decimal? @db.Decimal(10, 2)
  status            String   @default("DRAFT")
  utbmsPhaseCode    String? // e.g. "L100" Investigation, "L200" Pleadings
  utbmsTaskCode     String? // e.g. "L110" Fact Investigation
  utbmsActivityCode String? // e.g. "A101" Plan and prepare
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter            Matter?  @relation(fields: [matterId], references: [id])

  @@index([tenantId])
}

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  clientId      String?
  matterId      String?
  invoiceNumber String
  amount        Decimal   @db.Decimal(10, 2)
  currency      String
  status        String    @default("DRAFT")
  billingModel  String? // HOURLY | FIXED | CONTINGENCY | MILESTONE | SUBSCRIPTION
  metadata      Json?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter        Matter?   @relation(fields: [matterId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, matterId])
}

model TrustAccount {
  id        String             @id @default(cuid())
  tenantId  String
  name      String
  balance   Decimal            @default(0) @db.Decimal(12, 2)
  currency  String
  createdAt DateTime           @default(now())
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   TrustLedgerEntry[]

  @@index([tenantId])
}

model TrustLedgerEntry {
  id           String       @id @default(cuid())
  accountId    String
  matterId     String?
  type         String
  amount       Decimal      @db.Decimal(12, 2)
  description  String?
  status       String       @default("COMPLETED")
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  account      TrustAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([matterId])
}

model Task {
  id             String            @id @default(cuid())
  tenantId       String
  matterId       String?
  title          String
  description    String?
  notes          String?
  status         String            @default("TODO")
  priority       String            @default("MEDIUM")
  dueDate        DateTime?
  assigneeId     String?
  createdAt      DateTime          @default(now())
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter         Matter?           @relation(fields: [matterId], references: [id])
  participants   TaskParticipant[]
  comments       TaskComment[]
  calendarEvents CalendarEvent[]

  @@index([tenantId])
}

model TaskParticipant {
  id              String  @id @default(cuid())
  tenantId        String
  taskId          String
  participantType String // USER | CLIENT
  userId          String?
  clientId        String?
  role            String  @default("COLLABORATOR") // ASSIGNEE | COLLABORATOR | WATCHER | CLIENT
  task            Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@unique([taskId, clientId])
  @@index([tenantId])
  @@index([taskId])
  @@index([userId])
  @@index([clientId])
}

model TaskComment {
  id             String   @id @default(cuid())
  tenantId       String
  taskId         String
  body           String
  authorUserId   String?
  authorClientId String?
  createdAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([tenantId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  tenantId    String
  matterId    String?
  taskId      String?
  userId      String?
  clientId    String?
  title       String
  description String?
  type        String   @default("MEETING")
  startAt     DateTime
  endAt       DateTime
  reminderMinutes Int?
  reminderAt      DateTime?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter      Matter?  @relation(fields: [matterId], references: [id])
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([reminderAt])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, clientId])
  @@index([taskId])
}

model LegalAuthority {
  id              String                      @id @default(cuid())
  corpusProvisionId String?                   @unique
  countryCode     String
  jurisdiction    String?
  authorityType   String
  title           String
  citation        String?
  neutralCitation String?
  court           String?
  courtLevel      String?
  decisionDate    DateTime?
  sourceUrl       String?
  sourceName      String
  sourceLicense   String?
  fullText        String?
  summary         String?
  holding         String?
  topics          Json
  practiceAreas   Json
  draftKinds      String[]                    @default([])
  embeddingStatus String                      @default("PENDING")
  /// Treatment status: good_law | overruled | distinguished | superseded | repealed
  treatmentStatus String                      @default("good_law")
  reviewedByHuman Boolean                     @default(false)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  isRepealed      Boolean                     @default(false)
  repealNotes     String?
  citations       AICitation[]
  sectionProfiles StatuteSectionProfile[]
  translations    LegalAuthorityTranslation[]
  corpusProvision LegalCorpusProvision?       @relation(fields: [corpusProvisionId], references: [id], onDelete: SetNull)

  @@index([countryCode, jurisdiction])
  @@index([countryCode, authorityType])
  @@index([citation])
  @@index([treatmentStatus])
  @@index([countryCode, treatmentStatus])
}

/// Persistent act-level PDF cache metadata for write-through ingest.
model StatuteActCache {
  id            String   @id
  countryCode   String   @default("IN")
  pdfSha256     String
