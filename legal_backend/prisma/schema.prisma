model ESignEnvelope {
  id                String    @id @default(cuid())
  tenantId          String
  createdBy         String
  provider          String // docusign | adobe_sign
  remoteEnvelopeId  String
  status            String    @default("SENT") // SENT | DELIVERED | COMPLETED | DECLINED | VOIDED
  documentName      String
  subject           String
  message           String?
  signers           Json // [{ name, email, routingOrder }]
  matterId          String?
  documentId        String? // link to our Document record
