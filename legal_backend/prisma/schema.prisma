  matter             Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Court Deadlines ──────────────────────────────────────────────────────────

model CourtDeadline {
  id              String    @id @default(cuid())
  tenantId        String
  matterId        String
  title           String
  deadlineType    String // LIMITATION | FILING | HEARING | RESPONSE | APPEAL | CUSTOM
  dueDate         DateTime
  calculatedFrom  DateTime?
  ruleReference   String? // e.g. "Limitation Act 1980 s.2"
  notes           String?
  status          String    @default("PENDING") // PENDING | MET | MISSED | EXTENDED
  calendarEventId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter          Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([matterId])
  @@index([dueDate])
  @@index([status])
