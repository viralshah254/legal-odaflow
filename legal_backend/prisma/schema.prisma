  matter            Matter?   @relation(fields: [matterId], references: [id])

  @@index([tenantId])
  @@index([matterId])
  @@index([status])
  @@index([remoteEnvelopeId])
}

model SavedDocumentReview {
  id            String   @id @default(cuid())
  tenantId      String
  clientId      String?
  matterId      String?
  fileName      String
  documentType  String?
  reviewJson    Json
  extractedText String?  @db.Text
  createdAt     DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])
  matter Matter? @relation(fields: [matterId], references: [id])

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, matterId])
}

model SavedResearch {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  clientId     String
  matterId     String?
  aiOutputId   String?
  title        String
  query        String
  countryCode  String?
  researchJson Json
  createdAt    DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client  @relation(fields: [clientId], references: [id])
  matter Matter? @relation(fields: [matterId], references: [id])

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, matterId])
  @@index([tenantId, userId])
}

// ── Monitors (Regulatory Intelligence) ──────────────────────────────────────

model Monitor {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  jurisdiction String
  topics       String[] // e.g. ["employment", "data_privacy"]
  sources      String[] // e.g. ["courtlistener", "india_kanoon", "legislation_gov_uk"]
  frequency    String    @default("DAILY") // DAILY | WEEKLY
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hits   MonitorHit[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model MonitorHit {
  id             String    @id @default(cuid())
  monitorId      String
  tenantId       String
  title          String
  sourceUrl      String?
  sourceName     String?
  aiSummary      String?   @db.Text
  severity       String    @default("INFO") // INFO | WARNING | CRITICAL
  relevanceScore Float     @default(0.5)
  status         String    @default("NEW") // NEW | READ | DISMISSED | SAVED
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([tenantId])
  @@index([tenantId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1-B: Workflow Persistence Models (TODO-008, 009)
// ─────────────────────────────────────────────────────────────────────────────

model WorkflowRun {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  feature          String // research | drafting | issue_analysis | document_review | contract_review | matter_intelligence | strategy | hearing_prep | verification | copilot
  status           String    @default("QUEUED") // QUEUED | RUNNING | WAITING_FOR_INPUT | VERIFYING | REPAIRING | COMPLETED | PARTIAL | FAILED | CANCELLED
  progress         Int       @default(0) // 0-100
  currentStage     String?
  objective        String?
  matterId         String?
  inputRef         String? // JSON stored in object storage or inline JSON
  resultRef        String? // JSON stored in object storage
  errorCode        String?
