  sourceDocumentReference String?
  sourceHash              String?
  exactPassage            String?
  pinpoint                String?
  evidenceKind            ManualCitationEvidenceKind?
  replacementCitation     String?
  reviewedAt              DateTime                     @default(now())

  task     ManualCitationReviewTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  aiOutput AIOutput                 @relation(fields: [aiOutputId], references: [id], onDelete: Restrict)
  reviewer User                     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([tenantId, aiOutputId, reviewedAt])
  @@index([taskId, reviewedAt])
  @@index([reviewerId])
}

