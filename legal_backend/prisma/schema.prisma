/// Manually curated registry of verified legal authorities for citation auditing.
/// Seeded with common Supreme Court cases so the citation verifier can confirm
/// frequently cited authorities without a live retrieval pass.
model LegalAuthorityRecord {
  id                 String    @id @default(cuid())
  jurisdiction       String
  subJurisdiction    String?
  authorityType      String
  title              String
  citation           String?
  neutralCitation    String?
