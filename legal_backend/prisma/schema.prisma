  status         String    @default("pending")
  rowCount       Int       @default(0)
  holdoutScore   Float?
  errorMessage   String?
  /// Alias key registered in AiModelAlias after successful deploy
  modelAlias     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([status])
  @@index([documentKind, sectionType])
}

model DocumentScanLog {
