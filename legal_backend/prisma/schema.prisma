  createdAt    DateTime         @default(now())
  matter       Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  form         JurisdictionForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([matterId, formId])
  @@index([tenantId, matterId])
  @@index([formId])
}

model MatterAnalysisSnapshot {
