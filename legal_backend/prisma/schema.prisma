}

// ─── Smart Research Workspace (LiquidText+) ──────────────────────────────────

model SmartWorkspace {
  id         String   @id @default(cuid())
  tenantId   String
  matterId   String?
  clientId   String?
  title      String
  layoutJson Json     @default("{}")
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter Matter? @relation(fields: [matterId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  workspaceDocs WorkspaceDocument[]
  annotations   DocumentAnnotation[]
  links         WorkspaceLink[]
  canvasNodes   CanvasNode[]

  @@index([tenantId])
  @@index([matterId])
  @@index([clientId])
}

model WorkspaceDocument {
  id          String @id @default(cuid())
  workspaceId String
  documentId  String
  orderIndex  Int    @default(0)
  paneState   Json?

  workspace SmartWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, documentId])
  @@index([workspaceId])
}

model DocumentAnnotation {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  type        String // highlight | note | excerpt | ink
  anchor      Json // { startOffset, endOffset, page?, bbox?, quote }
  content     Json?
  color       String   @default("#FDE68A")
  createdBy   String
  aiMetadata  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace SmartWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceLinks WorkspaceLink[] @relation("AnnotationSourceLinks")
  targetLinks WorkspaceLink[] @relation("AnnotationTargetLinks")

  @@index([workspaceId])
  @@index([workspaceId, documentId])
}

model WorkspaceLink {
  id          String @id @default(cuid())
  workspaceId String
  sourceType  String // annotation | canvas_node
  sourceId    String
  targetType  String // annotation | canvas_node
  targetId    String
  style       Json?

  workspace        SmartWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceAnnotation DocumentAnnotation? @relation("AnnotationSourceLinks", fields: [sourceId], references: [id])
  targetAnnotation DocumentAnnotation? @relation("AnnotationTargetLinks", fields: [targetId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, sourceId])
  @@index([workspaceId, targetId])
}

model CanvasNode {
  id                  String   @id @default(cuid())
  workspaceId         String
  type                String // note | excerpt_card | timeline | image | research_result
  positionX           Float    @default(0)
  positionY           Float    @default(0)
  width               Float    @default(280)
  height              Float?
  content             Json
  linkedAnnotationIds String[] @default([])
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace SmartWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── First-party site analytics ───────────────────────────────────────────────

model SiteVisitSession {
  id            String   @id @default(cuid())
  visitorId     String // localStorage legal_analytics_distinct_id
  userId        String? // set when visitor identifies after login/signup
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  activeSeconds Int      @default(0)
  pageViewCount Int      @default(1)
  landingPath   String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  deviceType    String? // "mobile" | "desktop"
  countryCode   String?

  events SiteAnalyticsEvent[]

  @@index([visitorId])
  @@index([firstSeenAt])
  @@index([utmCampaign])
  @@index([userId])
}

model SiteAnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String
  visitorId  String
  eventName  String
  path       String?
  properties Json?
  createdAt  DateTime @default(now())

  session SiteVisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([visitorId])
  @@index([eventName])
  @@index([createdAt])
}

model IssueCheckerSearchLog {
  id           String   @id @default(cuid())
  facts        String
  issueType    String?
  countryCode  String?
  jurisdiction String?
  mode         String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([countryCode])
}

model AdminTodoTemplate {
  id           String   @id @default(cuid())
  adminProfile String // "CTO" | "CFO_CMO"
  title        String
  description  String?
  category     String // "engineering" | "marketing" | "finance" | "ops"
  dayOfWeek    Int? // 0=Sun..6=Sat, null=every day
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  completions AdminTodoCompletion[]

  @@index([adminProfile, dayOfWeek])
}

model AdminTodoCompletion {
  id          String    @id @default(cuid())
  userId      String
  templateId  String?
  title       String
  description String?
  category    String    @default("ops")
  dueDate     DateTime  @db.Date
  completed   Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template AdminTodoTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([userId, templateId, dueDate])
  @@index([userId, dueDate])
}
