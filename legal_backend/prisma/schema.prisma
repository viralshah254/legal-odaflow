  inputRef     String?
  outputRef    String?
  errorCode    String?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  workflow WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  key         String
  tenantId    String
  route       String
  requestHash String
  responseRef String? // stored response JSON
  statusCode  Int?
  status      String   @default("processing") // processing | completed | failed
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  eventType     String
  tenantId      String
  aggregateId   String
  aggregateType String
  payload       Json
  published     Boolean   @default(false)
  publishedAt   DateTime?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([published, createdAt])
  @@index([tenantId, aggregateId])
}

model WorkflowCostLedger {
  id               String   @id @default(cuid())
  workflowId       String   @unique
  tenantId         String
  userId           String
  feature          String
  retrievalCostUsd Float    @default(0)
  modelCostUsd     Float    @default(0)
  storageCostUsd   Float    @default(0)
  ocrCostUsd       Float    @default(0)
  exportCostUsd    Float    @default(0)
  repairCostUsd    Float    @default(0)
  cacheSavingsUsd  Float    @default(0)
  totalCostUsd     Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, feature])
  @@index([tenantId, createdAt])
}

// ─── Phase 2: Research Engine v3 + Knowledge Graph ───────────────────────────

model SearchSourceRegistry {
  id              String    @id @default(cuid())
  name            String
  sourceType      String // official_statute | case_law | court_rules | forms | secondary | firm_knowledge | matter_documents
  jurisdictions   String[] // ['IN', 'US', 'KE', 'GB', 'GLOBAL']
  authorityWeight Float     @default(0.5) // 0.0 to 1.0
  updateFrequency String    @default("monthly") // daily | weekly | monthly | on_change
  licensingNotes  String?
  accessMethod    String    @default("internal") // internal | api | scrape | manual
  status          String    @default("active") // active | inactive | pending | deprecated
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sourceType, status])
  @@index([status])
}

model LegalSearchDocument {
  id              String    @id @default(cuid())
  canonicalId     String    @unique
  corpusExpressionId String? @unique
  title           String
  documentType    String // statute | case | rule | form | secondary | practice_direction
  jurisdiction    String // IN | US | KE | GB
  region          String?
  court           String?
  authority       String? // supreme_court | high_court | district_court
  citation        String?
  publicationDate DateTime?
  effectiveDate   DateTime?
  expiryDate      DateTime?
  sourceUrl       String?
  sourceType      String
  authorityWeight Float     @default(0.5)
  checksum        String?
  status          String    @default("active") // active | superseded | repealed | draft
  treatmentStatus String    @default("good_law") // good_law | overruled | distinguished | superseded | repealed
  language        String    @default("en")
  rawText         String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  chunks           LegalSearchChunk[]
  corpusExpression LegalCorpusExpression? @relation(fields: [corpusExpressionId], references: [id], onDelete: SetNull)

  @@index([jurisdiction, documentType, status])
  @@index([canonicalId])
  @@index([citation])
  @@index([treatmentStatus])
}

enum LegalCorpusAuthorityLevel {
  OFFICIAL_PRIMARY
  OFFICIAL_PROSPECTIVE
  OFFICIAL_ADMINISTRATIVE
  SECONDARY
}

enum LegalCorpusDocumentType {
  CONSTITUTION
  ACT
  REGULATION
  RULE
  ORDER
  LEGAL_NOTICE
  GAZETTE_NOTICE
  COUNTY_ACT
  BILL
  JUDGMENT
  PRACTICE_DIRECTION
  TREATY
  EAC_INSTRUMENT
  REGULATOR_MATERIAL
  FORM
  OTHER
}

enum LegalCorpusStatus {
  IN_FORCE
  PARTIALLY_IN_FORCE
  REPEALED
  SPENT
  PROSPECTIVE
  SUPERSEDED
  UNKNOWN
}

enum LegalCorpusVerificationStatus {
  PENDING
  VERIFIED
  QUARANTINED
  REJECTED
}

enum LegalCorpusExtractionMethod {
  XML
  HTML
  PDF_TEXT
  OCR
  API
  MANUAL
}

enum LegalCorpusRelationType {
  AMENDS
  AMENDED_BY
  REPEALS
  REPEALED_BY
  COMMENCES
  MADE_UNDER
  HAS_SUBSIDIARY
  SUPERSEDES
  CITES
  APPEALS_FROM
  TREATED_BY
  ENACTS_BILL
}

enum GazetteLegalEventType {
  COMMENCEMENT
  AMENDMENT
  REGULATION
  REVOCATION
  APPOINTMENT
  PRACTICE_DIRECTION
  CORRIGENDUM
  OTHER
}

enum LegalCorpusReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Stable work-level identity. Expressions and artifacts are immutable children.
model LegalCorpusDocument {
  id                String                      @id @default(cuid())
  jurisdiction      String
  workUri           String                      @unique
  title             String
  shortTitle        String?
  capNumber         String?
  actNumber         String?
  year              Int?
  documentType      LegalCorpusDocumentType
  authorityLevel    LegalCorpusAuthorityLevel
  status            LegalCorpusStatus           @default(UNKNOWN)
  officialSource    Boolean                     @default(false)
  parentWorkUri     String?
  assentDate        DateTime?
  publicationDate   DateTime?
  commencementDate  DateTime?
  lastVerifiedAt    DateTime?
  metadata          Json?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  expressions       LegalCorpusExpression[]
  outgoingRelations LegalCorpusRelation[]       @relation("LegalCorpusRelationFrom")
  incomingRelations LegalCorpusRelation[]       @relation("LegalCorpusRelationTo")
  lawStateSnapshots KenyaLawStateSnapshot[]

  @@index([jurisdiction, documentType, status])
  @@index([jurisdiction, authorityLevel])
  @@index([capNumber])
  @@index([parentWorkUri])
}

/// A dated FRBR expression. A new source version always creates a new row.
model LegalCorpusExpression {
  id                 String                        @id @default(cuid())
  documentId         String
  expressionUri      String                        @unique
  expressionDate     DateTime?
  language           String                        @default("eng")
  sourceUrl          String
  sourceName         String
  sourceLicense      String?
  sourcePolicyId     String?
  contentSha256      String
  parserVersion      String
  extractionMethod   LegalCorpusExtractionMethod
  ocrStatus          String?
  ocrConfidence      Float?
  verificationStatus LegalCorpusVerificationStatus @default(PENDING)
  retrievedAt        DateTime                      @default(now())
  verifiedAt         DateTime?
  supersededAt       DateTime?
  normalizedText     String?
  searchText         String?
  citationSafeText   String?
  metadata           Json?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  document            LegalCorpusDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourcePolicy        LegalCorpusSourcePolicy? @relation(fields: [sourcePolicyId], references: [id], onDelete: SetNull)
  provisions          LegalCorpusProvision[]
  artifacts           LegalCorpusArtifact[]
  searchDocument      LegalSearchDocument?
  lawStateSnapshots   KenyaLawStateSnapshot[]

  @@unique([documentId, expressionDate, language])
  @@index([documentId, expressionDate])
  @@index([verificationStatus, retrievedAt])
  @@index([contentSha256])
}

/// Stable provision path inside one expression, including nested paragraphs and schedules.
model LegalCorpusProvision {
  id                 String   @id @default(cuid())
  expressionId       String
  parentId           String?
  provisionKey       String
  provisionType      String
  label              String?
  heading            String?
  ordinal            Int
  text               String
  citationSafeText   String?
  sourceAnchor       String?
  contentSha256      String
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  expression         LegalCorpusExpression @relation(fields: [expressionId], references: [id], onDelete: Cascade)
  parent             LegalCorpusProvision?  @relation("LegalCorpusProvisionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           LegalCorpusProvision[] @relation("LegalCorpusProvisionTree")
  legacyAuthority    LegalAuthority?

  @@unique([expressionId, provisionKey])
  @@index([expressionId, provisionType, ordinal])
  @@index([parentId])
}

model LegalCorpusArtifact {
  id               String   @id @default(cuid())
  expressionId     String
  representation   String
  storageUri       String?
  mediaType        String
  contentSha256    String
  byteLength       Int?
  inlineContent    Bytes?
  retrievedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  expression LegalCorpusExpression @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  @@unique([expressionId, representation, contentSha256])
  @@index([contentSha256])
}

model LegalCorpusRelation {
  id             String                  @id @default(cuid())
  fromDocumentId String
  toDocumentId   String
  relationType   LegalCorpusRelationType
  effectiveDate  DateTime?
  sourceUrl      String?
  confidence     Float?
  verified       Boolean                 @default(false)
  metadata       Json?
  createdAt      DateTime                @default(now())

  fromDocument LegalCorpusDocument @relation("LegalCorpusRelationFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument   LegalCorpusDocument @relation("LegalCorpusRelationTo", fields: [toDocumentId], references: [id], onDelete: Cascade)

  @@unique([fromDocumentId, toDocumentId, relationType, effectiveDate])
  @@index([toDocumentId, relationType])
}

/// Operational and contractual controls for each external source.
model LegalCorpusSourcePolicy {
  id                         String   @id @default(cuid())
  sourceKey                  String   @unique
  displayName                String
  baseUrl                    String
  jurisdiction               String
  accessMethod               String
  enabled                    Boolean  @default(false)
  productionApproved         Boolean  @default(false)
  permissionReference        String?
  attributionText            String?
  robotsSnapshot             Json?
  termsSnapshot              Json?
  maxConcurrency             Int      @default(1)
  requestsPerMinute          Int      @default(10)
  retryBudget                Int      @default(3)
  emergencyDisabledAt        DateTime?
  lastReviewedAt             DateTime?
  nextReviewAt               DateTime?
  metadata                   Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  expressions LegalCorpusExpression[]
  fetchAudits LegalCorpusFetchAudit[]
  gazetteIssues KenyaGazetteIssue[]

  @@index([jurisdiction, enabled])
  @@index([productionApproved, emergencyDisabledAt])
}

model LegalCorpusFetchAudit {
  id             String   @id @default(cuid())
  sourcePolicyId String
  url            String
  method         String   @default("GET")
  responseStatus Int?
  responseHash   String?
  bytesReceived  Int?
  attempt        Int      @default(1)
  outcome        String
  errorCode      String?
  startedAt      DateTime
  completedAt    DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())

  sourcePolicy LegalCorpusSourcePolicy @relation(fields: [sourcePolicyId], references: [id], onDelete: Cascade)

  @@index([sourcePolicyId, startedAt])
  @@index([outcome, startedAt])
}

model KenyaGazetteIssue {
  id                 String   @id @default(cuid())
  gazetteNumber      String
  gazetteDate        DateTime
  title              String
  sourceUrl          String   @unique
  sourcePolicyId     String?
  publicationSha256  String
  pageCount          Int?
  parserVersion      String
  verificationStatus LegalCorpusVerificationStatus @default(PENDING)
  retrievedAt        DateTime @default(now())
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sourcePolicy LegalCorpusSourcePolicy? @relation(fields: [sourcePolicyId], references: [id], onDelete: SetNull)
  pages        KenyaGazettePage[]
  notices      KenyaGazetteNotice[]

  @@unique([gazetteNumber, gazetteDate])
  @@index([gazetteDate, verificationStatus])
}

model KenyaGazettePage {
  id                   String   @id @default(cuid())
  issueId              String
  pageNumber           Int
  text                 String?
  imageStorageUri      String?
  textSha256           String?
  extractionMethod     LegalCorpusExtractionMethod
  extractionConfidence Float?
  requiresHumanReview  Boolean  @default(false)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  issue   KenyaGazetteIssue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  notices KenyaGazetteNotice[]

  @@unique([issueId, pageNumber])
  @@index([requiresHumanReview, extractionConfidence])
}

model KenyaGazetteNotice {
  id                   String   @id @default(cuid())
  issueId              String
  pageId               String?
  noticeNumber         String   @default("")
  title                String?
  extractedText        String
  textSha256           String
  extractionConfidence Float
  requiresHumanReview  Boolean  @default(false)
  verificationStatus   LegalCorpusVerificationStatus @default(PENDING)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  issue  KenyaGazetteIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  page   KenyaGazettePage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  events KenyaGazetteLegalEvent[]

  @@unique([issueId, noticeNumber, textSha256])
  @@index([noticeNumber])
  @@index([requiresHumanReview, verificationStatus])
}

model KenyaGazetteLegalEvent {
  id                   String   @id @default(cuid())
  noticeId             String
  eventType            GazetteLegalEventType
  affectedWorkUris     String[]
  effectiveDate        DateTime?
  extractedText        String
  extractionConfidence Float
  requiresHumanReview  Boolean  @default(false)
  verified             Boolean  @default(false)
  verifiedBy           String?
  verifiedAt           DateTime?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  notice KenyaGazetteNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([eventType, effectiveDate])
  @@index([verified, requiresHumanReview])
}

model KenyaLawStateSnapshot {
  id                String   @id @default(cuid())
  documentId        String
  asOfDate          DateTime
  status            LegalCorpusStatus
  expressionId      String?
  supportingEventIds String[]
  evidence          Json
  computedAt        DateTime @default(now())
  algorithmVersion  String

  document   LegalCorpusDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  expression LegalCorpusExpression? @relation(fields: [expressionId], references: [id], onDelete: SetNull)

  @@unique([documentId, asOfDate, algorithmVersion])
  @@index([asOfDate, status])
}

model LegalCorpusReviewTask {
  id             String   @id @default(cuid())
  jurisdiction   String
  reviewType     String
  subjectType    String
  subjectId      String
  sourceKey      String?
  confidence     Float?
  reason         String
  payload        Json
  status         LegalCorpusReviewStatus @default(PENDING)
  assignedTo     String?
  decisionNote   String?
  version        Int      @default(0)
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([reviewType, subjectType, subjectId])
  @@index([jurisdiction, status, reviewType])
  @@index([assignedTo, status])
}

model LegalSearchChunk {
  id              String                       @id @default(cuid())
  documentId      String
  headingPath     String?
  text            String
  startOffset     Int
  endOffset       Int
  pageNumber      Int?
  sectionLabel    String?
  propositionType String? // rule | exception | definition | holding | procedure | penalty
  tokenCount      Int                          @default(0)
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())

  document LegalSearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ResearchWorkspace {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  matterId      String?
  workflowId    String?
  title         String?
  objective     String
  jurisdiction  String?
  region        String?
  mode          String   @default("quick") // quick | deep | matter_aware | update
  status        String   @default("pending") // pending | planning | retrieving | synthesizing | verifying | completed | failed
