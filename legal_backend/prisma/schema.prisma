}

/// Stores AI-detected section correction signals for Super Admin review.
/// Created when a research answer is corrected after similar-case cross-check + primary-law confirmation.
/// Status: pending → approved | rejected. Only approved signals influence future research.
model SectionCorrectionSignal {
  id                       String    @id @default(cuid())
  countryCode              String
  /// Fingerprint of the query that triggered the correction (SHA-256 first 16 chars of query).
  queryFingerprint         String
  /// Original (possibly wrong) section cited in the AI answer.
  wrongSection             String
  /// Correction suggested by similar-case cross-check.
  correctSection           String
  /// ID of the primary-law LegalAuthority that confirmed the correct section.
  primarySourceAuthorityId String?
  /// JSON array of LegalAuthority IDs that are similar cases supporting the correction.
  supportingCaseIds        Json      @default("[]")
  /// Original AI output that triggered the signal.
  aiOutputId               String?
  /// Confidence score 0-1 based on frequency in similar cases and primary-law match quality.
  confidence               Float     @default(0)
  /// pending | approved | rejected
  status                   String    @default("pending")
  /// Notes from the reviewer.
  reviewNotes              String?
  /// User ID of the Super Admin who reviewed.
  reviewedByUserId         String?
  reviewedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([countryCode, status])
  @@index([status])
  @@index([aiOutputId])
}

