// ── AI Model Registry (UMB-014) ──────────────────────────────────────────────
// Stores provider model configuration in the database so that model prices,
// context limits, capabilities, and routing aliases can be updated by admins
// without requiring a code deployment.

model AiModel {
  id              String  @id @default(cuid())
  provider        String // openai | anthropic | deepseek | self_hosted
  providerModelId String // official API model ID (e.g. "gpt-5.4-mini")
  internalAlias   String? // optional short name used in config (e.g. "umbrella-economy-default")
  displayName     String
  tier            String // cheap | mid | premium | reasoning
  enabled         Boolean @default(true)

  supportsStreaming     Boolean @default(false)
  supportsJsonSchema    Boolean @default(false)
  supportsToolCalling   Boolean @default(false)
  supportsVision        Boolean @default(false)
  supportsReasoning     Boolean @default(false)
  supportsPromptCaching Boolean @default(false)

  contextWindowTokens BigInt?
  maxOutputTokens     BigInt?

  inputPricePerMillionUsd       Decimal? @db.Decimal(12, 6)
  cachedInputPricePerMillionUsd Decimal? @db.Decimal(12, 6)
  outputPricePerMillionUsd      Decimal? @db.Decimal(12, 6)

  dataRegion              String?
  retentionPolicy         String?
  trainingOptOutSupported Boolean?
  enterpriseApproved      Boolean  @default(false)

  qualityScore      Decimal? @db.Decimal(6, 3)
  legalQualityScore Decimal? @db.Decimal(6, 3)
  citationScore     Decimal? @db.Decimal(6, 3)
  latencyScore      Decimal? @db.Decimal(6, 3)
  costScore         Decimal? @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases AiModelAlias[]

  @@unique([provider, providerModelId])
  @@index([tier, enabled])
  @@index([provider, enabled])
}

model AiModelAlias {
  id               String   @id @default(cuid())
  alias            String   @unique // e.g. "umbrella-economy-default"
  aiModelId        String
  jurisdiction     String? // optional: "IN" | "KE" | "US"
  taskType         String? // optional: maps to AITaskType enum values
  subscriptionTier String? // optional: "free" | "individual" | "lawyer" | "law_firm" | "enterprise"
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  model AiModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)

  @@index([alias, enabled])
  @@index([taskType, subscriptionTier])
}

model AiQualityFeedback {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  feature        String // drafting | research | strategy | document_review
  taskType       String // section_type, document_type, etc.
  modelUsed      String
  jurisdiction   String?
  editType       String // accept | minor_edit | major_edit | reject
  editRatio      Float    @default(0)
  editDistance   Int      @default(0)
  originalLength Int      @default(0)
  editedLength   Int      @default(0)
  costUsd        Float    @default(0)
  latencyMs      Int?
  createdAt      DateTime @default(now())

  @@index([tenantId, feature, taskType, modelUsed])
  @@index([createdAt])
}

/// Explicit per-section feedback from lawyers on AI-generated draft sections.
/// Text fields always store REDACTED content (PII stripped before insert).
model DraftSectionFeedback {
  id                  String   @id @default(cuid())
  tenantId            String
  userId              String
  documentKind        String
  sectionType         String
  jurisdiction        String?
  /// accepted | minor_edit | major_edit | rejected
  rating              String
  /// Comma-separated edit categories: missing_citation,wrong_law,poor_structure,factual_error,style,other
  editCategories      String[]
  /// Redacted AI-generated text (PII removed)
  aiGeneratedText     String   @db.Text
  /// Redacted user-edited text (PII removed). Null if rating is "accepted".
  userEditedText      String?  @db.Text
  editDistance        Int      @default(0)
  editRatio           Float    @default(0)
  /// True once this row has been consumed by the nightly training pipeline job
  usedAsTraining      Boolean  @default(false)
  courtDraftRecordId  String?
  draftSectionV3Id    String?
  draftJobSectionId   String?
  /// verified | needs_review | limited_sources | unknown
  verificationOutcome String?
  /// Model that generated the section (for routing + fine-tune attribution)
  modelUsed           String?
  createdAt           DateTime @default(now())

  @@index([tenantId, documentKind, sectionType])
  @@index([tenantId, usedAsTraining])
  @@index([rating])
  @@index([createdAt])
}

/// Per-tenant learned drafting preferences, updated nightly from DraftSectionFeedback.
/// Injected into section prompts to progressively personalise generation.
model FirmDraftPreference {
  id               String   @id @default(cuid())
  tenantId         String
  documentKind     String
  sectionType      String
  /// Country the preference was learned for. "" means jurisdiction-agnostic (legacy rows).
  countryCode      String   @default("")
  /// JSON array of up to 3 accepted example texts (redacted)
  exampleTexts     Json     @default("[]")
  /// Phrases/patterns that users consistently remove or flag
  avoidPatterns    String[]
  /// Accuracy-focused patterns distilled from editCategories + verification outcomes
  accuracyPatterns String[] @default([])
  /// Short redacted anti-examples of rejected AI text (JSON string array)
  antiExamples     Json     @default("[]")
  /// LLM-distilled style notes (tone, structure, vocabulary preferences)
  styleNotes       String?  @db.Text
  acceptanceRate   Float    @default(0)
  sampleCount      Int      @default(0)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, documentKind, sectionType, countryCode], map: "FirmDraftPreference_tenant_kind_section_country_key")
  @@index([tenantId])
}

/// Per-(country, legal domain) research corrections distilled from verifier failures,
/// retrieval gaps and reviewed section corrections. The research counterpart of
/// FirmDraftPreference: re-injected into synthesis so the same mistake is not repeated.
model ResearchPromptPreference {
  id             String   @id @default(cuid())
  countryCode    String
  /// "" means the preference applies to every legal domain in the country.
  legalDomain    String   @default("")
  /// Instructions the researcher must follow for this country/domain.
  guidance       String[] @default([])
  /// Behaviours observed to produce unsupported or wrong output.
  avoidPatterns  String[] @default([])
  /// Sources that repeatedly had to be retrieved late; search them earlier.
  retrievalHints String[] @default([])
  /// Number of underlying signals the preference was distilled from.
  sampleCount    Int      @default(0)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([countryCode, legalDomain])
  @@index([countryCode])
}

/// Raw per-run research verification signals. Distilled into ResearchPromptPreference
/// by the research learning loop; the research counterpart of DraftVerificationOutcome.
model ResearchVerificationOutcome {
  id                 String   @id @default(cuid())
  tenantId           String?
  countryCode        String
  legalDomain        String   @default("")
  taskKind           String   @default("")
  /// Verifier verdict for the run: verified | verified_with_limitations | needs_review | failed.
  verificationStatus String
  /// Claims the verifier could not tie to a retrieved source.
  unsupportedClaims  Json?
  /// Citations removed or marked as an authority gap during sanitisation.
  strippedCitations  Json?
  /// Domain-completeness requirements still unmet when the run finished.
  unmetRequirements  String[] @default([])
  /// Retrieval hops the agentic loop had to take before it had enough authority.
  hopPurposes        String[] @default([])
  authoritiesUsed    Int      @default(0)
  usedAsTraining     Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([countryCode, legalDomain, usedAsTraining], map: "ResearchVerificationOutcome_country_domain_training_idx")
  @@index([createdAt], map: "ResearchVerificationOutcome_createdAt_idx")
}

/// Persisted verify/repair outcomes for training signals (even without user thumbs).
model DraftVerificationOutcome {
  id                 String   @id @default(cuid())
  tenantId           String
  userId             String?
  documentKind       String
  jurisdiction       String?
  courtDraftRecordId String?
  draftJobId         String?
  /// verified | needs_review | limited_sources
  verificationStatus String
  findings           Json     @default("[]")
  strippedCitations  Json     @default("[]")
  claimFailures      Json     @default("[]")
  repairAttempted    Boolean  @default(false)
  repairSucceeded    Boolean  @default(false)
  regenAttempts      Int      @default(0)
  modelUsed          String?
  /// True once consumed by nightly training pipeline
  usedAsTraining     Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([tenantId, documentKind])
  @@index([tenantId, usedAsTraining])
  @@index([createdAt])
}

/// Citation/section corrections learned from drafting (mirrors SectionCorrectionSignal for research).
model DraftCorrectionSignal {
  id                 String    @id @default(cuid())
  tenantId           String?
  documentKind       String
  jurisdiction       String?
  countryCode        String    @default("IN")
  wrongCitation      String
  correctCitation    String
  wrongSection       String?
  correctSection     String?
  authorityIdWrong   String?
  authorityIdCorrect String?
  courtDraftRecordId String?
  confidence         Float     @default(0)
  /// pending | approved | rejected
  status             String    @default("pending")
  reviewNotes        String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([countryCode, status])
  @@index([documentKind, status])
  @@index([status])
  @@index([tenantId])
}

/// Per-authority trust scores derived from verification strips and user corrections.
model AuthorityTrustScore {
  id               String   @id @default(cuid())
  authorityId      String
  countryCode      String   @default("IN")
  timesCited       Int      @default(0)
  timesVerified    Int      @default(0)
  timesStripped    Int      @default(0)
  timesUserRemoved Int      @default(0)
  timesUserReadded Int      @default(0)
  /// Computed trust in [-1, 1]; positive = boost, negative = penalty
  trustScore       Float    @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([authorityId, countryCode])
  @@index([countryCode, trustScore])
}

/// Tracks Azure OpenAI fine-tuning jobs for drafting models.
model AzureFineTuneJob {
  id             String    @id @default(cuid())
