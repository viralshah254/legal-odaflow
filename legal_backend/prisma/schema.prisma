// ─── Unified Drafting Engine ──────────────────────────────────────────────────

model DraftJob {
  id                     String    @id @default(cuid())
  tenantId               String
  userId                 String
  matterId               String?
  profile                String // DraftProfile: india_court | matter_workspace | template_automation | legal_notice | contract | legal_opinion
  documentKind           String
  qualityTier            String // express | standard | premium
  status                 String    @default("queued") // DraftJobStatus
  currentStage           String    @default("queued")
  idempotencyKey         String
  operation              String    @default("draft_generate")
  requestFingerprint     String?
  dispatchStatus         String    @default("pending_dispatch")
  reservedCredits        Int       @default(0)
  consumedCredits        Int       @default(0)
  estimatedCostUsd       Float     @default(0)
  actualCostUsd          Float     @default(0)
  blockedReason          String?
  failureReason          String?
  // Serialized stage outputs for resumability
  normalizedMatterJson   Json?
  proceduralResultJson   Json?
  sourceRegistryJson     Json?
  executionPlanJson      Json?
  verificationReportJson Json?
  assembledDraftJson     Json?
  // Linking to legacy records
  courtDraftRecordId     String?
  workspaceV3Id          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?

  @@unique([tenantId, userId, operation, idempotencyKey])
  sections     DraftJobSection[]
  stageResults DraftJobStageResult[]
  issues       DraftJobIssue[]
  repairs      DraftJobRepair[]
  auditEvents  DraftJobAuditEvent[]
  modelUsages  DraftJobModelUsage[]

  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@index([idempotencyKey])
  @@index([courtDraftRecordId])
  @@index([createdAt])
}

model DraftJobSection {
  id           String   @id @default(cuid())
  jobId        String
  sectionKey   String
  title        String
  sectionType  String
  content      String   @default("") @db.Text
  status       String   @default("planned") // planned | generating | generated | verified | repair_needed | repaired | user_modified | approved
  model        String?
  version      Int      @default(0)
  repairCount  Int      @default(0)
  inputTokens  Int?
  outputTokens Int?
  durationMs   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job     DraftJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  repairs DraftJobRepair[]

  @@unique([jobId, sectionKey])
  @@index([jobId])
  @@index([jobId, sectionKey])
}

model DraftJobStageResult {
  id         String   @id @default(cuid())
  jobId      String
  stage      String
  outputJson Json?
  durationMs Int?
  costUsd    Float    @default(0)
  success    Boolean  @default(true)
  error      String?
  createdAt  DateTime @default(now())

  job DraftJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stage])
}

model DraftJobIssue {
  id                      String   @id @default(cuid())
  jobId                   String
  sectionId               String?
  paragraphId             String?
  category                String // DraftIssueCategory
  severity                String // critical | high | medium | low
  message                 String   @db.Text
  suggestedCorrection     String?  @db.Text
  sourceId                String?
  repairableAutomatically Boolean  @default(false)
  validator               String
  fingerprint             String
  resolved                Boolean  @default(false)
  resolvedByRepairId      String?
  createdAt               DateTime @default(now())

  job DraftJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, severity])
  @@index([fingerprint])
}

model DraftJobRepair {
  id               String   @id @default(cuid())
  jobId            String
  sectionId        String
  attemptNumber    Int      @default(1)
  outputConstraint String // sentence | paragraph | section
  beforeText       String   @db.Text
  afterText        String?  @db.Text
  model            String
  issueIds         String[] // DraftJobIssue IDs addressed
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Float    @default(0)
  success          Boolean  @default(false)
  failureReason    String?
  createdAt        DateTime @default(now())

  job     DraftJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  section DraftJobSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([sectionId])
}

