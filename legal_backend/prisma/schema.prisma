enum ManualCitationReviewStatus {
  PENDING   @map("pending")
  IN_REVIEW @map("in-review")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  REPLACED  @map("replaced")
}

enum ManualCitationReviewDecision {
  APPROVE
  REJECT
  REPLACE
}

enum ManualCitationEvidenceKind {
  PASSAGE
  IDENTITY_ONLY
}

/// Tenant- and output-scoped work item derived from an unresolved automated citation audit.
model ManualCitationReviewTask {
  id          String                     @id @default(cuid())
  tenantId    String
  aiOutputId  String
  matterId    String?
  citationKey String
  citation    String
  claim       String?
  auditEntry  Json
