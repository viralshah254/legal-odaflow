  version     Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiOutput AIOutput               @relation(fields: [aiOutputId], references: [id], onDelete: Cascade)
  reviews  ManualCitationReview[]

  @@unique([tenantId, aiOutputId, citationKey])
  @@index([tenantId, aiOutputId, status])
  @@index([tenantId, matterId])
}

/// Append-only lawyer decisions. Automated audit fields on AIOutput remain unchanged.
model ManualCitationReview {
  id                      String                       @id @default(cuid())
  taskId                  String
  tenantId                String
  aiOutputId              String
  reviewerId              String
