{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "legal-forms/catalog.data.json",
        "watchAssets": true
      },
      {
        "include": "../data/india-caselaw-corpus/*.json",
        "outDir": "dist/data/india-caselaw-corpus",
        "watchAssets": true
      }
    ]
  }
}

