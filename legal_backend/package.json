{
  "name": "com.dvtechventures.umbrella-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "concurrently --kill-others-on-fail --names \"api,worker\" --prefix-colors \"cyan,yellow\" \"nest start --watch\" \"bash scripts/dev-worker.sh\"",
    "dev:api": "nest start --watch",
    "start": "nest start",
    "start:dev": "npm run dev",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:integration": "jest test/integration",
    "eval:bail-regression": "jest test/unit/platform/draft-accuracy-platform.spec.ts --no-coverage",
    "benchmark:legal-research": "ts-node -r tsconfig-paths/register scripts/benchmark-legal-research.ts",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "seed:admin": "npx ts-node -r tsconfig-paths/register scripts/seed-superadmin.ts",
    "seed:admins": "npx ts-node -r tsconfig-paths/register scripts/seed-admins.ts",
    "seed:admin-todos": "npx ts-node -r tsconfig-paths/register prisma/seed-admin-todos.ts",
