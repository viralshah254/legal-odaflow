NODE_ENV=development
PORT=4000
APP_NAME="Umbrella"
APP_VERSION=0.1.0

# Set automatically in Docker/CI builds (ci-swarm.yml on push to main)
# GIT_COMMIT_SHA=
# GIT_BRANCH=
# BUILD_TIME=
# CI_WORKFLOW=
# CI_RUN_ID=
# DEPLOY_PROBE_MARKER=
# DOCKER_IMAGE_REPO=ayienda/legal-byodaflow
APP_URL=https://umbrella.okaylegal.ai
# Local dev override:
# APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Production server: API_URL=https://legal-api.odaflow.com

# Bearer token for detailed health probes (/health/db, /health/redis, /health/ai)
HEALTH_DETAIL_TOKEN=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_odaflow
# Use direct (non-pooler) URL for long CLI ingest jobs; sync scripts prefer this automatically.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_odaflow
REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me_jwt_secret
# HMAC pepper for hashing refresh tokens at rest (generate with: openssl rand -hex 32)
REFRESH_TOKEN_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
# Preferred: place service account JSON at legal_backend/firebase-service-account.json (gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=umbrella-95da1
# Firestore database ID — use (default) unless you created a named database in GCP.
FIRESTORE_DATABASE_ID=(default)
# Production (Docker): mount the JSON into /usr/app/ and use the same relative path above.
# Fallback when FIREBASE_SERVICE_ACCOUNT_PATH is unset:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Comma-separated Apple client IDs accepted on server-to-server notifications
# APPLE_NOTIFICATION_AUDIENCES=com.dvtechventures.umbrella.signin,com.dvtechventures.umbrella
SESSION_COOKIE_SECRET=change_me_session_secret

# Add production web origins (Vercel, custom domain). API host https://legal-api.odaflow.com does not need CORS for proxied /api/v1.
CORS_ORIGINS=http://localhost:3000,https://localhost:3001,https://127.0.0.1:3001,http://localhost:8080,https://legal-web-bice.vercel.app,https://legal-three-red.vercel.app,https://umbrella.okaylegal.ai

AI_PROVIDER=openai
# Comma-separated list of enabled providers: openai, deepseek, google
AI_ALLOWED_PROVIDERS=openai,deepseek,google
# direct = api.openai.com + OPENAI_API_KEY (default)
# azure  = Azure OpenAI for GPT chat + embeddings only (AZURE_OPENAI_* below)
# Whisper always uses OPENAI_API_KEY on api.openai.com (OpenAI credits).
# DeepSeek always uses DEEPSEEK_API_KEY.
OPENAI_API_MODE=direct
OPENAI_API_KEY=
# Azure OpenAI (required when OPENAI_API_MODE=azure) — GPT + embeddings only
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# JSON map: logical model id -> Azure deployment name. Required in practice on
# Azure, because a model id that is not mapped is sent as the deployment name and
# Azure returns 404. GET /health/ai lists `azure.unmappedModels` when this is
# incomplete, and reports the model as not ready.
#
# Every model referenced by the AI_LEGAL_* aliases below must appear here, plus
# the embedding model and the fallback chain targets (gpt-5.4-mini, gpt-4o-mini,
# gpt-4o) so a provider hiccup does not take research down.
#
# Example (one line, no trailing commas):
# AZURE_OPENAI_DEPLOYMENT_MAP={"gpt-5.6-luna":"gpt-56-luna","gpt-5.6-terra":"gpt-56-terra","gpt-5.6-sol":"gpt-56-sol","gpt-5.4-mini":"gpt-54-mini","gpt-5.4-nano":"gpt-54-nano","gpt-4o-mini":"gpt-4o-mini","gpt-4o":"gpt-4o","text-embedding-3-small":"text-embedding-3-small"}
AZURE_OPENAI_DEPLOYMENT_MAP=
# Deprecated — Anthropic/Claude removed; legacy claude-* IDs remap to GPT via LEGACY_MODEL_ID_ALIASES.
# ANTHROPIC_API_KEY=
# Gemini — pick ONE auth path:
# (A) Developer API key from https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# (B) Vertex AI via service account (uses GOOGLE_APPLICATION_CREDENTIALS ADC)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Document AI (separate from chat Gemini — OCR/forms)
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=

# ── DeepSeek (OpenAI-compatible API — economy tier for simple drafts) ─────────
# Obtain key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Legal Research — model capability aliases ──────────────────────────────────
# Services reference these aliases; swap models here without touching service code.
#
# Verified (DEEP) research and filing-grade drafting refuse to fall back below the
# "mid" capability tier: rather than quietly answering from an economy model they
# return 503. Keep FAST/STANDARD/COMPLEX and both verifier aliases on mid-tier or
# better models, and make sure each has an Azure deployment when running on Azure.
AI_LEGAL_FAST_MODEL=gpt-5.6-luna
AI_LEGAL_STANDARD_MODEL=gpt-5.6-terra
AI_LEGAL_COMPLEX_MODEL=gpt-5.6-sol
AI_LEGAL_COMPLEX_FALLBACK_MODEL=gpt-5.6-terra
AI_LEGAL_LIGHT_VERIFIER_MODEL=gpt-5.6-terra
AI_LEGAL_HARD_VERIFIER_MODEL=gpt-5.6-sol
AI_LEGAL_REPAIR_MODEL=gpt-5.6-terra
AI_LEGAL_ORCHESTRATOR_MODEL=gpt-5.6-luna
AI_LEGAL_BULK_MODEL=gpt-5.4-mini
AI_LEGAL_EXTRACT_MODEL=gpt-5.4-nano

# ── Legal Research — routing / versioning ──────────────────────────────────────
LEGAL_RESEARCH_MODEL_ROUTING_VERSION=v1
LEGAL_RESEARCH_PROMPT_VERSION=v7
LEGAL_RESEARCH_DEFAULT_MODE=STANDARD
LEGAL_RESEARCH_ENABLE_ULTRA=false
LEGAL_RESEARCH_MAX_AGENT_ROUNDS=2
# Disable to fall back to conservative legacy retrieval/verification behavior during rollout.
LEGAL_RESEARCH_FAST_PIPELINE_ENABLED=true

# ── Legal Research — token budgets per complexity tier ─────────────────────────
LEGAL_QUICK_MAX_INPUT_TOKENS=16000
LEGAL_QUICK_MAX_OUTPUT_TOKENS=2500
LEGAL_STANDARD_MAX_INPUT_TOKENS=32000
LEGAL_STANDARD_MAX_OUTPUT_TOKENS=4500
LEGAL_COMPLEX_MAX_INPUT_TOKENS=64000
LEGAL_COMPLEX_MAX_OUTPUT_TOKENS=10000

# ── Legal Research — retrieval concurrency ─────────────────────────────────────
LEGAL_INTERNAL_SEARCH_CONCURRENCY=6
LEGAL_EXTERNAL_SEARCH_CONCURRENCY=2
LEGAL_RERANK_TOP_N=20

# ── Legal Research — per-source timeouts (ms) ─────────────────────────────────
LEGAL_INTERNAL_SEARCH_TIMEOUT_MS=4000
LEGAL_EXTERNAL_SEARCH_TIMEOUT_MS=8000
LEGAL_STATUTE_FETCH_TIMEOUT_MS=6000
LEGAL_SYNTHESIS_TIMEOUT_MS=12000
LEGAL_VERIFIED_SYNTHESIS_TIMEOUT_MS=28000
LEGAL_VERIFIER_TIMEOUT_MS=15000

# ── Draft Engine routing flags ─────────────────────────────────────────────────
# v2: force all drafts (DRAFT_ENGINE_V2=true), route citation-heavy kinds only
# (DRAFT_ENGINE_V2_PER_KIND=true), or shadow-run for quality comparison
# (DRAFT_ENGINE_V2_SHADOW=true).
DRAFT_ENGINE_V2=false
DRAFT_ENGINE_V2_PER_KIND=true
DRAFT_ENGINE_V2_SHADOW=true
DRAFT_V2_MAX_SECTION_REPAIRS=2

# v3 Unified Drafting Engine — percentage rollout (0–100)
UNIFIED_DRAFT_ENGINE_ENABLED=true
UNIFIED_DRAFT_ENGINE_PERCENT=100

# ── DB-backed AI model registry ────────────────────────────────────────────────
# Set DB_MODEL_REGISTRY_ENABLED=true AFTER running the model registry migration.
# When false, model resolution falls back to model-costs.config.ts (static).
DB_MODEL_REGISTRY_ENABLED=false
DB_MODEL_CACHE_TTL_MS=60000

# Deepgram — real-time streaming STT for live meeting transcription
# Sign up at https://console.deepgram.com → API Keys → Create a key (free $200 credit to start)
# Required for live word-by-word captions during recording. Falls back to Chrome Web Speech API
# + Whisper batch transcription if unset or if the connection fails.
DEEPGRAM_API_KEY=

# Azure Document Intelligence (OCR) — required for scanned / image-based PDF text extraction
# Get from: Azure Portal → Document Intelligence resource → Keys and Endpoint
AZURE_OCR_ENDPOINT=
AZURE_OCR_API_KEY=
# AZURE_OCR_MODEL=prebuilt-read  # default
# Google Places API — lawyer prospect scraping from admin panel
# Enable "Places API" (Legacy) AND "Places API (New)" in Google Cloud Console
# Server-side key: restrict by IP (not HTTP referrers)
GOOGLE_PLACES_API_KEY=
# Use Places API (New) for lower cost — phone/website in searchText field mask (default: true)
GOOGLE_PLACES_USE_NEW_API=true
AI_FAST_MODEL=gpt-5.6-luna
AI_CHEAP_MODEL=gpt-5.4-mini
AI_LLM_MAX_RETRIES=6
AI_MID_MODEL=gpt-5.6-terra
AI_REASONING_MODEL=gpt-5.6-sol
AI_NANO_MODEL=gpt-5.4-nano
AI_ENABLE_MODEL_ROUTING=true
AI_BLOCK_TASK_IF_MARGIN_NEGATIVE=true
AI_ALLOW_NEGATIVE_MARGIN_FOR_FREE_PREVIEW=true
AI_MIN_GROSS_MARGIN_PERCENT=25
AI_SUBSCRIPTION_MARGIN_PERCENT=40
AI_PLATFORM_MARGIN_PERCENT=40
AI_PLATFORM_NET_MARGIN_PERCENT=20
AI_CREDIT_USD_VALUE=0.01
AI_CHARGE_MODE=token_based
AI_PREMIUM_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
ENABLE_CREDIT_RESERVATIONS=false
CREDIT_RESERVATION_TTL_MS=900000
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_MONTHLY_TENANT_COST_USD=500
AI_MAX_MONTHLY_CONSUMER_COST_USD=25
AI_REQUIRE_CITATIONS=true
AI_REQUIRE_APPROVAL_FOR_LEGAL_DRAFTS=true
AI_CONSUMER_DISCLAIMER_REQUIRED=true
# Only enforced when AI_CHARGE_MODE=flat. Token/credit mode uses wallet credits instead.
AI_DEFAULT_MAX_TASK_COST_USD=2
AI_DEFAULT_MONTHLY_USER_BUDGET_USD=10
AI_DEFAULT_MONTHLY_TENANT_BUDGET_USD=500
AI_ENABLE_RESPONSE_CACHE=true
AI_ENABLE_EMBEDDING_CACHE=true
AI_ENABLE_RAG=true
AI_ENABLE_AGENTS=true
AI_ENABLE_LEGAL_RESEARCH=true
AI_ENABLE_OUTCOME_RISK=true
AI_ENABLE_CONSUMER_GUIDANCE=true
# Restructure user prompts before research/drafting (preview & accept in web/app)
ENABLE_PROMPT_REFINEMENT=true
AI_REQUIRE_LAWYER_APPROVAL_FOR_HIGH_RISK=true

TRAINING_OPT_IN_DEFAULT=false
TRAINING_REQUIRE_EXPLICIT_CONSENT=true
TRAINING_ALLOW_FINE_TUNING=false
TRAINING_ALLOW_EVALUATION_DATASET=true
TRAINING_REQUIRE_ANONYMIZATION=true
TRAINING_DATA_REGION=us-east-1

ENABLE_LEGAL_CONNECTORS=true
# GovInfo API — free key at https://www.govinfo.gov/api-signup (US Code USLM via GPO)
GOVINFO_API_KEY=
GOVINFO_USCODE_EDITION=2024
# OLRC release path + mirrors (fallback when GovInfo unavailable)
USLM_RELEASE_PATH=119/99
USLM_MIRROR_HOSTS=usc-cdn.house.gov,uscode.house.gov
# CourtListener REST API — US case law search, dockets, citation lookup
# Token from https://www.courtlistener.com/sign-in/ → Profile → API token
# Docs: https://wiki.free.law/c/courtlistener/help/api/rest/v4/overview
COURTLISTENER_API_TOKEN=
ECOURTS_API_URL=
INDIA_KANOON_API_KEY=
# e-SCR (Supreme Court official judgments via AWS Open Data — no API key required)
ESCR_CONNECTOR_DISABLED=false
# Licensed Indian case-law APIs (Phase 4 — optional)
SCC_ONLINE_API_KEY=
SCC_ONLINE_API_URL=
MANUPATRA_API_KEY=
MANUPATRA_API_URL=
TAXMANN_API_KEY=
TAXMANN_API_URL=
# Auto-upgrade Indian case-law research to DEEP / verified mode
LEGAL_AUTO_DEEP_FOR_CASE_LAW=false
# Cross-encoder reranking (optional — improves retrieval quality)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# Set true only for dev/demo placeholder RAG rows (production uses statute section corpus)
SEED_PLACEHOLDER_AUTHORITIES=false
ENABLE_INDIA_CODE_CONNECTOR=true
# Laws.Africa Content API — optional; Kenya corpus falls back to public Kenya Law scrape
# Free API token at https://platform.laws.africa/api-keys/
# Docs: https://developers.laws.africa/content-api/content-api
LAWS_AFRICA_API_TOKEN=
# Tavily web search — used as live fallback for case law in any jurisdiction
# Sign up at https://tavily.com (generous free tier)
TAVILY_API_KEY=
LEGAL_CONNECTOR_CACHE_TTL_SECONDS=86400

VECTOR_PROVIDER=pgvector
# Enable hybrid BM25 search when OPENSEARCH_URL is configured (recommended for citation exact-match)
ENABLE_OPENSEARCH=true
# When ENABLE_OPENSEARCH=true, set cluster URL and optional auth:
OPENSEARCH_URL=
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INDEX_PREFIX=legal

# AWS (IAM user with S3 + SQS access)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
IAM_USER=

# S3 (objects are private; use presigned PUT URLs or authenticated CDN — not public bucket reads)
# Production/staging: set S3_PROVIDER=aws (or s3) — meeting recordings must not use local disk.
# Local dev: S3_PROVIDER=local writes to UPLOAD_DIR (default ./uploads).
# Ops: enable S3 Block Public Access and default bucket encryption on the bucket.
S3_PROVIDER=local
S3_BUCKET=legal-odaflow-dev
LEGAL_S3_BUCKET=legal-odaflow-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_CDN_URL=
# Optional: SSE-KMS instead of SSE-S3 (AES256)
S3_SSE_KMS_KEY_ID=
# Set true when bucket has Object Ownership enforced (ACLs disabled)
S3_SKIP_OBJECT_ACL=

# SQS
LEGAL_SQS_QUEUE_URL=

OCR_PROVIDER=azure
# Note: use AZURE_OCR_ENDPOINT and AZURE_OCR_API_KEY (defined above near Deepgram).

# Stripe — https://docs.stripe.com/keys (use test keys until go-live)
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Legacy fallback Price IDs (same as _DEVELOPED tier; used when tier-specific vars are unset)
STRIPE_PRICE_LAWYER_SOLO=price_...
STRIPE_PRICE_FIRM_STARTER=price_...
STRIPE_PRICE_FIRM_PROFESSIONAL=price_...
STRIPE_PRICE_FIRM_PRO_PLUS=price_...
# ── Market-tiered prices (run scripts/setup-stripe-billing.ts to populate) ──
# Developing nations (KE, IN, …): $25/$25/$100/$500 per user/month
STRIPE_PRICE_LAWYER_SOLO_DEVELOPING=price_...
STRIPE_PRICE_FIRM_STARTER_DEVELOPING=price_...
STRIPE_PRICE_FIRM_PROFESSIONAL_DEVELOPING=price_...
STRIPE_PRICE_FIRM_PRO_PLUS_DEVELOPING=price_...
# Developed nations (US, GB, CA, AU, …): $50/$50/$200/$1000 per user/month
STRIPE_PRICE_LAWYER_SOLO_DEVELOPED=price_...
STRIPE_PRICE_FIRM_STARTER_DEVELOPED=price_...
STRIPE_PRICE_FIRM_PROFESSIONAL_DEVELOPED=price_...
STRIPE_PRICE_FIRM_PRO_PLUS_DEVELOPED=price_...
# India native INR prices (₹1400 / ₹6000 / ₹30000 / ₹1000 consumer)
STRIPE_PRICE_LAWYER_SOLO_INR=price_...
STRIPE_PRICE_FIRM_STARTER_INR=price_...
STRIPE_PRICE_FIRM_PROFESSIONAL_INR=price_...
STRIPE_PRICE_FIRM_PRO_PLUS_INR=price_...
STRIPE_PRICE_CONSUMER_PLUS_INR=price_...
# Webhook secret from https://dashboard.stripe.com/test/webhooks or:
# stripe listen --forward-to localhost:4000/api/v1/subscriptions/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Tax — India IGST / APAC digital services (remote seller OIDAR).
# Enable after registering in Dashboard → Tax → Registrations (India).
STRIPE_TAX_ENABLED=false
# Electronically supplied services (SaaS subscriptions, AI credit packs).
STRIPE_TAX_CODE_DIGITAL=txcd_10000000
# Reject Stripe webhook events older than this many seconds (default 300)
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# India — UPI & Google Pay (Stripe Checkout, currency must be INR):
# 1. Enable UPI + Google Pay: https://dashboard.stripe.com/test/settings/payment_methods
# 2. Use test keys above; subscriptions/credit top-ups localize to INR for IN customers
# 3. Test UPI: at Checkout select UPI → scan QR → authorize on Stripe test page
# 4. Simulate India customer location: customer_email=test+location_IN@example.com
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
MPESA_WEBHOOK_SECRET=

# Razorpay — India payment gateway (alternative to Stripe for INR, UPI)
# Keys from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# DocuSign Connect HMAC secret (from Connect configuration)
DOCUSIGN_WEBHOOK_SECRET=
# Adobe Sign integration key (verified via X-AdobeSign-ClientId header)
ADOBE_SIGN_INTEGRATION_KEY=
REQUIRE_PAYMENT_METHOD_FOR_LAWYER_TRIAL=false

EMAIL_PROVIDER=resend
# REQUIRED — all transactional emails (invitations, receipts, password reset) fail without this.
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=no-reply@legalbyodaflow.com

# Error tracking — https://sentry.io (optional but strongly recommended for production)
SENTRY_DSN=
# Use 'info' or 'warn' in production; 'debug' only for local development.
LOG_LEVEL=info

# AES-256 master key for encrypting sensitive data at rest (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=

ENABLE_AUDIT_LOGS=true
ENABLE_RATE_LIMITING=true
# Cloudflare Turnstile secret for anonymous issue-checker CAPTCHA (required in production)
TURNSTILE_SECRET_KEY=
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Reject passwords found in Have I Been Pwned (k-anonymity API). Set false only for offline dev.
PASSWORD_BREACH_CHECK=true

SEED_ADMIN_EMAIL=admin@odaflow.com
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
# Set to true to reset the seeded admin password and require change on next login
SEED_ADMIN_RESET_PASSWORD=false

# Multi-admin seeding (npm run seed:admins)
ADMIN_GJAIN_PASSWORD=             # password for g.jain@okaylegal.ai
ADMIN_GARIMA_PASSWORD=            # password for garima@okaylegal.ai (when known)

ENABLE_CONSUMER_APP=true
ENABLE_LAWYER_OS=true
ENABLE_LAWYER_MARKETPLACE=true
ENABLE_LEGAL_RESEARCH=true
ENABLE_AI_AGENTS=true
ENABLE_DOCUMENT_OCR=true
# Free research previews shown to unauthenticated visitors on the issue-checker.
# Production uses 3; increase for marketing demos.
DEFAULT_CONSUMER_FREE_PREVIEWS=3
# One-time signup bonus for new consumer accounts.
CONSUMER_SIGNUP_CREDITS=100
# One-time signup bonus for new lawyer tenants (falls back to CONSUMER_SIGNUP_CREDITS).
LAWYER_SIGNUP_CREDITS=100
# Daily auto-grant for free (no subscription) consumers. Credits accumulate at midnight UTC.
# Intended production default is 5. Local/dev may use a higher value for testing.
# Cost per day ≈ DAILY_FREE_CONSUMER_CREDITS × AI_CREDIT_USD_VALUE.
DAILY_FREE_CONSUMER_CREDITS=5

# ── WhatsApp Business (Meta) ──────────────────────────────────────────────────
# Required for WA Campaigns in the admin panel. All four vars must be set on
# production or template listing and message sending will silently return empty.
#
# Find in Meta Business Suite → WhatsApp Manager → API Setup:
#   WHATSAPP_WABA_ID          — WhatsApp Business Account ID (used to list templates)
#   WHATSAPP_PHONE_NUMBER_ID  — Phone Number ID (used to send messages)
#   WHATSAPP_API_TOKEN        — System User token for app "Umbrella Legal AI" with
#                               whatsapp_business_management + whatsapp_business_messaging
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN — Arbitrary secret that matches the Webhook verify token set in Meta
#
# Verify IDs match your business: GET /{business-id}/owned_whatsapp_business_accounts
# Wrong IDs cause Meta error 400 "Object does not exist or missing permissions".
# Umbrella WABA example Phone Number ID: 1208125735714802 (+1 940-237-9507)
# Must be Connected (verified) in Meta before sends work. Worker reads these via dotenv.
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Referral program ──────────────────────────────────────────────────────────
# $USD credit reward for the referrer on first successful referee subscription.
REFERRAL_REWARD_USD=10
# Attribution window: how many days after sign-up a referral is still valid.
REFERRAL_ATTRIBUTION_DAYS=90
# Maximum rewarded referrals from a single device fingerprint (fraud cap).
REFERRAL_MAX_REWARDS_PER_FINGERPRINT=10
# Server-side salt used when hashing the client device ID. CHANGE IN PRODUCTION.
DEVICE_FINGERPRINT_SALT=change-me-in-production

# Introductory offer: 40% off first month for 7 days after first login
INTRO_OFFER_DISCOUNT_PERCENT=40
INTRO_OFFER_DAYS=7
# Stripe coupon ID for intro offer (40% off, duration: once). Run setup-stripe-billing.ts.
STRIPE_INTRO_OFFER_COUPON_ID=
# Legacy coupon env vars (fallback if STRIPE_INTRO_OFFER_COUPON_ID unset)
STRIPE_REFERRAL_COUPON_ID=
STRIPE_FIRST_PURCHASE_COUPON_ID=
