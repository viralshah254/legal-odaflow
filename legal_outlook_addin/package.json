{
  "name": "legal-outlook-addin",
  "version": "1.0.0",
  "description": "Umbrella Legal AI — Microsoft Outlook Add-In task pane",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "npm run build && node scripts/generate-production-manifest.mjs",
    "manifest:prod": "node scripts/generate-production-manifest.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "sideload": "office-addin-debugging start manifest.xml desktop --prod"
  },
  "dependencies": {
    "@microsoft/office-js": "^1.1.0",
    "axios": "^1.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.370",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "office-addin-debugging": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
