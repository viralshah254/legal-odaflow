# Copy to .env.production on a Docker/self-hosted host (not committed — gitignored).
# On Vercel: set env vars via Project → Settings → Environment Variables instead of this file.
# Never commit real values; rotate any keys that were previously in git history.

# NestJS origin for Next.js rewrites (/api/v1 → API_URL/api/v1). No /api/v1 suffix.
API_URL=https://api.okaylegal.ai

NODE_ENV=production

# Public web origin (referral links, metadata, canonical URLs)
NEXT_PUBLIC_APP_URL=https://umbrella.okaylegal.ai

# NEXT_PUBLIC_USE_DIRECT_API and NEXT_PUBLIC_API_URL must NOT be set on Vercel.
# Those vars bypass the Next.js rewrite proxy and force the browser to call the API
# directly (cross-origin), which requires CORS on the backend. Leave them unset.
# They are only needed for the Electron desktop build.
#
# NEXT_PUBLIC_USE_DIRECT_API=true
# NEXT_PUBLIC_API_URL=https://api.okaylegal.ai

# WebSocket MUST be set — Socket.IO cannot go through the Next.js rewrite proxy
# (Vercel has no persistent WebSocket support). Connect Socket.IO directly to the backend.
NEXT_PUBLIC_WS_URL=https://api.okaylegal.ai

NEXT_PUBLIC_DEFAULT_COUNTRY=
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_CONSUMER_APP=true
NEXT_PUBLIC_ENABLE_LAWYER_OS=true
NEXT_PUBLIC_ENABLE_MARKETPLACE=true
NEXT_PUBLIC_ENABLE_LEGAL_RESEARCH=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true

# Firebase Auth — required for Google/Apple sign-in buttons on /auth/sign-in and /auth/sign-up
NEXT_PUBLIC_USE_FIREBASE_AUTH=true
NEXT_PUBLIC_FIREBASE_API_KEY=
# Keep the registered Firebase auth domain until custom provider return URLs are verified.
# For first-party redirect OAuth, set this to the app host AND authorize
# https://<app-host>/__/auth/handler in every provider (Google/Apple/etc.).
# Next.js already proxies /__/auth/*; that alone does not register provider return URLs.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=umbrella-95da1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=umbrella-95da1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=umbrella-95da1.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1034275934580
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional override for the Firebase Auth handler host used by the /__/auth proxy
# (defaults to ${NEXT_PUBLIC_FIREBASE_PROJECT_ID}.firebaseapp.com)
# FIREBASE_AUTH_HANDLER_HOST=umbrella-95da1.firebaseapp.com

# Subscription confirm fallback (used when backend /subscriptions/confirm-checkout is not deployed yet).
# Must match the same values on the NestJS API (legal_backend).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (public site key for issue-checker CAPTCHA widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# CSP rollout: keep true until production QA passes, then set false to enforce
CSP_REPORT_ONLY=true
# Optional: CSP_REPORT_URI=https://your-csp-report-endpoint.example.com
