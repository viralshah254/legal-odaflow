NEXT_PUBLIC_APP_NAME="Umbrella"
# Production: set to your deployed site URL (required for correct link previews / Open Graph).
# Example: https://umbrella.okaylegal.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For Google/Apple OAuth locally, use https://localhost:3000 + `npm run dev:https` instead.
# Optional: search engine ownership verification (injected into <head> on production).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code
# Local dev: copy this file to .env and edit values there (one file only — do not create .env.local).
API_URL=http://localhost:4000
# Optional: call backend directly from the browser (requires CORS on the API). Default is proxy mode.
# NEXT_PUBLIC_USE_DIRECT_API=true
NEXT_PUBLIC_API_URL=http://localhost:4000
# Socket.IO base URL for CRM live updates (defaults to localhost:4000 in dev).
# Production: MUST be your API host (e.g. https://api.okaylegal.ai), NOT the web app URL.
# Vercel cannot proxy WebSockets — set NEXT_PUBLIC_API_URL / NEXT_PUBLIC_WS_URL to https://api.okaylegal.ai.
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Default jurisdiction fallback when IP geo is unavailable (ISO 3166-1 alpha-2).
# Leave empty to use real IP geolocation in dev. Only used as last-resort fallback.
NEXT_PUBLIC_DEFAULT_COUNTRY=
# Local dev geo (optional overrides — real IP lookup works without these):
# - By default, localhost skips 127.0.0.1 and uses ipapi.co/json/ (your public IP).
# - Backend fallback: GET http://localhost:4000/geo/client (requires API running).
# - Force a fixed country/state instead of IP:
#   DEV_GEO_COUNTRY=IN
#   DEV_GEO_REGION=MH
# - Disable dev mock entirely (ipapi only):
#   DEV_GEO_MOCK=false
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_CONSUMER_APP=true
NEXT_PUBLIC_ENABLE_LAWYER_OS=true
NEXT_PUBLIC_ENABLE_MARKETPLACE=true
NEXT_PUBLIC_ENABLE_LEGAL_RESEARCH=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# Apple Sign-In (web domain verification for umbrella.okaylegal.ai)
# Paste the JSON from Apple Developer → Services ID → domain verification.
# Served at /.well-known/apple-developer-domain-association — see firebase/APPLE_SETUP.md
# APPLE_DOMAIN_ASSOCIATION=
# Required for card setup (auto top-up) and inline Stripe payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (public site key for issue-checker CAPTCHA widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# AI policy & compliance (frontend display / feature flags)
NEXT_PUBLIC_AI_DISCLAIMER_REQUIRED=true
NEXT_PUBLIC_AI_CITATION_GUARDRAILS=true
NEXT_PUBLIC_AI_TRAINING_OPT_OUT_DEFAULT=true
NEXT_PUBLIC_AI_REQUIRE_LAWYER_APPROVAL=true
NEXT_PUBLIC_ENABLE_ADMIN_CONSOLE=true

# Firebase Auth (optional — omit to use email/password API auth only)
# Set NEXT_PUBLIC_USE_FIREBASE_AUTH=false to skip Firebase and use backend /auth/* directly.
NEXT_PUBLIC_USE_FIREBASE_AUTH=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Local dev: localhost:3000 (include port — plain localhost redirects OAuth to :80).
# Production: your app host (e.g. umbrella.okaylegal.ai), NOT *.firebaseapp.com.
# Next.js proxies /__/auth/* to the Firebase project handler for Safari redirect OAuth.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# FCM Web Push — get VAPID key from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# Leave empty to disable web push notifications.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
