  "tutorialsAutomationsHelpB2": "ಅಸಿಂಕ್ ಕೆಲಸಕ್ಕಾಗಿ AI ಏಜೆಂಟ್‌ಗಳಿಗೆ ಆಟೊಮೇಷನ್‌ಗಳನ್ನು ಲಿಂಕ್ ಮಾಡಿ.",
  "tutorialsAutomationsHelpB3": "ಪ್ರತಿ ಪಾಕವಿಧಾನ ಕಾರ್ಡ್‌ನಲ್ಲಿ ಕೊನೆಯ ರನ್ ಸ್ಥಿತಿಯನ್ನು ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡಿ.",
  "tutorialsAutomationsHelpTitle": "ಆಟೋಮೇಷನ್ಸ್",
  "tutorialsAutomationsRecipesBody": "ಒಂದು ಕ್ಲಿಕ್‌ನಲ್ಲಿ ಪರೀಕ್ಷಿತ ಆಟೊಮೇಷನ್‌ಗಳನ್ನು ಸ್ಥಾಪಿಸಿ. ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಕಳೆದುಕೊಳ್ಳದೆ ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಡೀಫಾಲ್ಟ್‌ಗೆ ಹಿಂತಿರುಗಿ.",
  "tutorialsAutomationsRecipesTitle": "ಶಿಫಾರಸು ಮಾಡಲಾದ ಪಾಕವಿಧಾನಗಳು",
  "tutorialsBillingHeaderBody": "ಇನ್‌ವಾಯ್ಸ್‌ಗಳು, ಪೂರ್ವ-ಬಿಲ್ ಪರಿಶೀಲನೆ, ಪಾವತಿಗಳು, ಹೇಳಿಕೆಗಳು ಮತ್ತು ಸಂಸ್ಥೆಯ ಚಂದಾದಾರಿಕೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗಾಗಿ ಇಲ್ಲಿ ಪ್ರಾರಂಭಿಸಿ.",
  "tutorialsBillingHeaderTitle": "ಬಿಲ್ಲಿಂಗ್ ಅವಲೋಕನ",
  "tutorialsBillingHelpB1": "ಕ್ಲೈಂಟ್‌ಗಳಿಗೆ ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ಕಳುಹಿಸುವ ಮೊದಲು ಪ್ರಿ-ಬಿಲ್ ಅನ್ನು ರನ್ ಮಾಡಿ.",
  "tutorialsBillingHelpB2": "ಪ್ರತಿ ಸಂಸ್ಥೆಯ ನೀತಿಗೆ ಟ್ರಸ್ಟ್ ಚಳುವಳಿಗಳಿಗೆ ಅನುಮೋದನೆಯ ಅಗತ್ಯವಿದೆ.",
  "tutorialsBillingHelpB3": "ನಿಖರವಾದ ಇನ್‌ವಾಯ್ಸ್‌ಗಳಿಗಾಗಿ ಸಮಯದ ನಮೂದುಗಳು ಮತ್ತು ವೆಚ್ಚಗಳನ್ನು ವಿಷಯಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡಿ.",
  "tutorialsBillingHelpTitle": "ಬಿಲ್ಲಿಂಗ್",
  "tutorialsBillingHubBody": "ಒಂದೇ ಸ್ಥಳದಿಂದ ಇನ್‌ವಾಯ್ಸ್‌ಗಳು, ಪೂರ್ವ-ಬಿಲ್ ಪರಿಶೀಲನೆ, ಪಾವತಿಗಳು ಮತ್ತು ನಂಬಿಕೆಯನ್ನು ಪ್ರವೇಶಿಸಿ.",
  "tutorialsBillingHubTitle": "ಬಿಲ್ಲಿಂಗ್ ಹಬ್",
  "tutorialsBillingInvoicesBody": "ಸ್ಥಿತಿಯ ಮೂಲಕ ಫಿಲ್ಟರ್ ಮಾಡಿ, ಸಂಖ್ಯೆಯ ಮೂಲಕ ಹುಡುಕಿ ಮತ್ತು LEDES ಅನ್ನು ಕಳುಹಿಸಲು, ರೆಕಾರ್ಡ್ ಪಾವತಿ ಮಾಡಲು ಅಥವಾ ರಫ್ತು ಮಾಡಲು ಯಾವುದೇ ಸರಕುಪಟ್ಟಿ ತೆರೆಯಿರಿ.",
  "tutorialsBillingInvoicesTitle": "ಸರಕುಪಟ್ಟಿ ಪಟ್ಟಿ",
  "tutorialsBillingLinksBody": "ಪ್ರತಿ ಕಾರ್ಡ್ ಕೇಂದ್ರೀಕೃತ ವರ್ಕ್‌ಫ್ಲೋ-ಚಂದಾದಾರಿಕೆ, ಇನ್‌ವಾಯ್ಸ್‌ಗಳು, ಪೂರ್ವ-ಬಿಲ್, ಪಾವತಿಗಳು ಅಥವಾ ಹಣಕಾಸು ವರದಿಗಳನ್ನು ತೆರೆಯುತ್ತದೆ.",
  "tutorialsBillingLinksTitle": "ಬಿಲ್ಲಿಂಗ್ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳು",
  "tutorialsCalendarCreateBody": "ಈವೆಂಟ್‌ಗಳನ್ನು ರಚಿಸಿ ಮತ್ತು ಅವುಗಳನ್ನು ವಿಷಯಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡಿ ಇದರಿಂದ ತಂಡವು ಒಟ್ಟುಗೂಡಿರುತ್ತದೆ.",
  "tutorialsCalendarCreateTitle": "ಈವೆಂಟ್‌ಗಳನ್ನು ಸೇರಿಸಿ",
  "tutorialsCalendarHelpB1": "ವಿಷಯಗಳ ನ್ಯಾಯಾಲಯದ ಗಡುವುಗಳು ಇಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಗೋಚರಿಸಬಹುದು.",
  "tutorialsCalendarHelpB2": "ನಿಮ್ಮ ಪಾತ್ರವನ್ನು ಆಧರಿಸಿ ಕ್ಯಾಲೆಂಡರ್ ಗೋಚರತೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳಿ.",
  "tutorialsCalendarHelpTitle": "ಕ್ಯಾಲೆಂಡರ್",
  "tutorialsCalendarViewBody": "ವಿಚಾರಣೆಗಳು, ಗಡುವುಗಳು ಮತ್ತು ಆಂತರಿಕ ಘಟನೆಗಳನ್ನು ಒಂದೇ ನೋಟದಲ್ಲಿ ನೋಡಿ.",
  "tutorialsCalendarViewTitle": "ಕ್ಯಾಲೆಂಡರ್",
  "tutorialsClientsCreateBody": "ವೈಯಕ್ತಿಕ ಅಥವಾ ಕಂಪನಿಯ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ರಚಿಸಿ. ಕ್ಲೈಂಟ್ ಅನ್ನು ಉಳಿಸಿದ ನಂತರ ನೀವು ವಿಷಯಗಳನ್ನು ಲಿಂಕ್ ಮಾಡಬಹುದು.",
  "tutorialsClientsCreateTitle": "ಕ್ಲೈಂಟ್ ಅನ್ನು ಸೇರಿಸಿ",
  "tutorialsClientsDetailHeaderBody": "ಸಂಪರ್ಕ ವಿವರಗಳು, KYC ಸ್ಥಿತಿ ಮತ್ತು ತ್ವರಿತ ಕ್ರಮಗಳು ದಾಖಲೆಯ ಮೇಲ್ಭಾಗದಲ್ಲಿ ಲೈವ್ ಆಗಿವೆ.",
  "tutorialsClientsDetailHeaderTitle": "ಕ್ಲೈಂಟ್ ಪ್ರೊಫೈಲ್",
  "tutorialsClientsDetailHelpB1": "KYC ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ಮುಕ್ತಾಯ ದಿನಾಂಕಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ.",
  "tutorialsClientsDetailHelpB2": "ಸುರಕ್ಷಿತ ಸಂದೇಶ ಕಳುಹಿಸುವಿಕೆ ಮತ್ತು ಡಾಕ್ಯುಮೆಂಟ್ ಹಂಚಿಕೆಗಾಗಿ ಕ್ಲೈಂಟ್ ಪೋರ್ಟಲ್ ಪ್ರವೇಶವನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ.",
  "tutorialsClientsDetailHelpB3": "ಈ ಪ್ರೊಫೈಲ್‌ನಿಂದ ನೇರವಾಗಿ ಹೊಸ ವಿಷಯವನ್ನು ರಚಿಸಿ.",
  "tutorialsClientsDetailHelpTitle": "ಗ್ರಾಹಕರ ದಾಖಲೆ",
  "tutorialsClientsDetailMattersBody": "ಈ ಕ್ಲೈಂಟ್‌ಗಾಗಿ ಎಲ್ಲಾ ಪ್ರಕರಣಗಳು ಇಲ್ಲಿ ಗೋಚರಿಸುತ್ತವೆ. ಕಾರ್ಯಗಳು, ದಾಖಲೆಗಳು ಮತ್ತು ಬಿಲ್ಲಿಂಗ್ ಅನ್ನು ನಿರ್ವಹಿಸಲು ವಿಷಯವನ್ನು ತೆರೆಯಿರಿ.",
  "tutorialsClientsDetailMattersTitle": "ಸಂಬಂಧಿತ ವಿಷಯಗಳು",
  "tutorialsClientsHelpB1": "ಬಿಲ್ಲಿಂಗ್ ಮಾಡುವ ಮೊದಲು KYC ಅನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ ಅಥವಾ ಅಗತ್ಯವಿರುವಲ್ಲಿ ವಹಿವಾಟುಗಳನ್ನು ನಂಬಿ.",
  "tutorialsClientsHelpB2": "ಡ್ರಾಫ್ಟ್ ಇನ್ಟೇಕ್ ನೋಟ್ಸ್ ಅಥವಾ ಕ್ಲೈಂಟ್ ಇತಿಹಾಸವನ್ನು ಸಾರಾಂಶ ಮಾಡಲು ಈ ಪುಟದಲ್ಲಿ Copilot ಬಳಸಿ.",
  "tutorialsClientsHelpB3": "ಹೊಸ ಕ್ಲೈಂಟ್‌ಗಳನ್ನು ಇನ್‌ಟೇಕ್ ಲೀಡ್‌ಗಳಿಂದ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪರಿವರ್ತಿಸಬಹುದು.",
  "tutorialsClientsHelpTitle": "ಗ್ರಾಹಕರು",
  "tutorialsClientsListBody": "ಕ್ಲೈಂಟ್ ದಾಖಲೆಯನ್ನು ತೆರೆಯಲು, ವಿಷಯಗಳನ್ನು ವೀಕ್ಷಿಸಲು ಮತ್ತು ಪೋರ್ಟಲ್ ಪ್ರವೇಶವನ್ನು ನಿರ್ವಹಿಸಲು ಸಾಲನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.",
  "tutorialsClientsListTitle": "ಕ್ಲೈಂಟ್ ಡೈರೆಕ್ಟರಿ",
  "tutorialsClientsNewFormBody": "ಸಂಪರ್ಕ ಮಾಹಿತಿ ಮತ್ತು ಕ್ಲೈಂಟ್ ಪ್ರಕಾರವನ್ನು ನಮೂದಿಸಿ. ನೀವು ಉಳಿಸಿದಾಗ ಸಂಘರ್ಷ ಪರಿಶೀಲನೆಗಳು ರನ್ ಆಗುತ್ತವೆ.",
  "tutorialsClientsNewFormTitle": "ಗ್ರಾಹಕರ ವಿವರಗಳು",
  "tutorialsClientsNewHelpB1": "ವೈಯಕ್ತಿಕ ಮತ್ತು ಕಂಪನಿಯು ಅಗತ್ಯವಿರುವ ಕ್ಷೇತ್ರಗಳು ಮತ್ತು ಬಿಲ್ಲಿಂಗ್ ಸೆಟಪ್‌ನ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ.",
  "tutorialsClientsNewHelpB2": "ಪ್ರೊಫೈಲ್ ರಚಿಸಿದ ನಂತರ ನೀವು ಕ್ಲೈಂಟ್ ಅನ್ನು ಪೋರ್ಟಲ್‌ಗೆ ಆಹ್ವಾನಿಸಬಹುದು.",
  "tutorialsClientsNewHelpTitle": "ಹೊಸ ಕ್ಲೈಂಟ್",
  "tutorialsClientsNewSubmitBody": "ಉಳಿಸಿದ ನಂತರ, ವಿಷಯವನ್ನು ತೆರೆಯಿರಿ ಅಥವಾ ಕ್ಲೈಂಟ್ ಪ್ರೊಫೈಲ್‌ನಿಂದ KYC ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ.",
  "tutorialsClientsNewSubmitTitle": "ಉಳಿಸಿ ಮತ್ತು ಮುಂದುವರಿಸಿ",
  "tutorialsClientsSearchBody": "ಹೆಸರು, ಇಮೇಲ್ ಅಥವಾ ಕಂಪನಿಯ ಮೂಲಕ ಹುಡುಕಿ. KYC ಬ್ಯಾಡ್ಜ್‌ಗಳು ಕಾಣೆಯಾದ ಅಥವಾ ಅವಧಿ ಮೀರಿದ ದಾಖಲೆಗಳನ್ನು ತೋರಿಸುತ್ತವೆ.",
  "tutorialsClientsSearchTitle": "ಗ್ರಾಹಕರನ್ನು ಹುಡುಕಿ",
  "tutorialsConsumerCaseDetailHelpB1": "ನಿಮ್ಮ ವಕೀಲರಿಗೆ ಪರಿಸ್ಥಿತಿಯನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡಲು ದಾಖಲೆಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ.",
  "tutorialsConsumerCaseDetailHelpB2": "ನಿಮಗೆ ಔಪಚಾರಿಕ ಸಲಹೆ ಬೇಕಾದಾಗ ವಕೀಲರ ವಿಮರ್ಶೆಯನ್ನು ವಿನಂತಿಸಿ.",
  "tutorialsConsumerCaseDetailHelpTitle": "ಕೇಸ್ ಹೋಮ್",
  "tutorialsConsumerCaseDetailTabsBody": "ಅವಲೋಕನ, ದಾಖಲೆಗಳು, ವರದಿಗಳು, ಸಂದೇಶಗಳು, ಪಾವತಿಗಳು ಮತ್ತು ಸಮ್ಮತಿಯ ನಡುವೆ ಬದಲಿಸಿ.",
  "tutorialsConsumerCaseDetailTabsTitle": "ಕೇಸ್ ವಿಭಾಗಗಳು",
  "tutorialsConsumerCasesHelpB1": "ನಿಮಗೆ ತಾಜಾ ಕೇಸ್ ಅಗತ್ಯವಿದ್ದರೆ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಿಂದ ಹೊಸ ಸಮಸ್ಯೆ ಪರಿಶೀಲನೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ.",
  "tutorialsConsumerCasesHelpB2": "ನಿಮ್ಮ ವಕೀಲರು ಕ್ರಮ ಕೈಗೊಂಡಾಗ ಪ್ರಕರಣದ ಸ್ಥಿತಿ ನವೀಕರಣಗಳು.",
  "tutorialsConsumerCasesHelpTitle": "ಪ್ರಕರಣಗಳು",
  "tutorialsConsumerCasesListBody": "ಪ್ರತಿಯೊಂದು ಪ್ರಕರಣವು ದಾಖಲೆಗಳು, ವರದಿಗಳು, ಸಂದೇಶಗಳು ಮತ್ತು ಪಾವತಿಗಳನ್ನು ಒಂದೇ ಸ್ಥಳದಲ್ಲಿ ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತದೆ.",
  "tutorialsConsumerCasesListTitle": "ಪ್ರಕರಣ ಪಟ್ಟಿ",
  "tutorialsConsumerDashboardActionsBody": "ಸಮಸ್ಯೆ ಪರಿಶೀಲನೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ, ಸಂಶೋಧನೆಯನ್ನು ರನ್ ಮಾಡಿ, ಪತ್ರವನ್ನು ಬರೆಯಿರಿ ಅಥವಾ ವಕೀಲರನ್ನು ಕಾಯ್ದಿರಿಸಿ-ಎಲ್ಲವೂ ಈ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳಿಂದ.",
  "tutorialsConsumerDashboardActionsTitle": "ಮುಂದೇನು ಮಾಡಬೇಕು",
  "tutorialsConsumerDashboardCasesBody": "ಕ್ರೆಡಿಟ್‌ಗಳು, ಸಕ್ರಿಯ ಪ್ರಕರಣಗಳು, ವರದಿಗಳು ಮತ್ತು ನ್ಯಾಯವ್ಯಾಪ್ತಿಯು ಇಲ್ಲಿ ಗೋಚರಿಸುತ್ತದೆ ಆದ್ದರಿಂದ ನೀವು ಒಂದು ನೋಟದಲ್ಲಿ ಎಲ್ಲಿ ನಿಲ್ಲುತ್ತೀರಿ ಎಂದು ನಿಮಗೆ ತಿಳಿಯುತ್ತದೆ.",
  "tutorialsConsumerDashboardCasesTitle": "ನಿಮ್ಮ ಸ್ನ್ಯಾಪ್‌ಶಾಟ್",
  "tutorialsConsumerDashboardHelpB1": "AI ಪವರ್ ಇಶ್ಯೂ ಚೆಕ್‌ಗಳು, ಸಂಶೋಧನೆ ಮತ್ತು ಡಾಕ್ಯುಮೆಂಟ್ ವಿಶ್ಲೇಷಣೆಯನ್ನು ಕ್ರೆಡಿಟ್ ಮಾಡುತ್ತದೆ.",
  "tutorialsConsumerDashboardHelpB2": "ನಿಮ್ಮ ವಕೀಲರಿಗೆ ಸಂದೇಶ ಕಳುಹಿಸಲು, ಫೈಲ್‌ಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಲು ಅಥವಾ ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ಪಾವತಿಸಲು ಪ್ರಕರಣವನ್ನು ತೆರೆಯಿರಿ.",
  "tutorialsConsumerDashboardHelpB3": "ಸುದೀರ್ಘ ಸಂಶೋಧನೆ ಅಥವಾ ವಿಮರ್ಶೆ ಸೆಷನ್‌ಗೆ ಮೊದಲು ಚಂದಾದಾರಿಕೆಯಿಂದ ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ಟಾಪ್ ಅಪ್ ಮಾಡಿ.",
  "tutorialsConsumerDashboardHelpTitle": "ಮುಖಪುಟ",
  "tutorialsConsumerDocumentDraftingHelpB1": "ಡಾಕ್ಯುಮೆಂಟ್ ಯಾರಿಗಾಗಿ ಮತ್ತು ಅದು ಏನನ್ನು ಸಾಧಿಸಬೇಕು ಎಂಬುದರ ಸ್ಪಷ್ಟ ವಿವರಣೆಯೊಂದಿಗೆ ಪ್ರಾರಂಭಿಸಿ.",
  "tutorialsConsumerDocumentDraftingHelpB2": "ಕಳುಹಿಸುವ ಅಥವಾ ಸಹಿ ಮಾಡುವ ಮೊದಲು ಪ್ರತಿಯೊಂದು ಷರತ್ತುಗಳನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಪರಿಶೀಲಿಸಿ.",
  "tutorialsConsumerDocumentDraftingHelpB3": "ಡ್ರಾಫ್ಟ್‌ಗಳನ್ನು ಕೇಸ್‌ಗೆ ಉಳಿಸಿ ಇದರಿಂದ ನಿಮ್ಮ ವಕೀಲರು ಅವುಗಳನ್ನು ಸಂಪಾದಿಸಬಹುದು.",
  "tutorialsConsumerDocumentDraftingHelpTitle": "ಡಾಕ್ಯುಮೆಂಟ್ ಡ್ರಾಫ್ಟಿಂಗ್",
  "tutorialsConsumerDocumentDraftingIntroBody": "ನಿಮಗೆ ಬೇಕಾದುದನ್ನು ವಿವರಿಸಿ - ಸೂಚನೆ, ಒಪ್ಪಂದ ಅಥವಾ ಅಪ್ಲಿಕೇಶನ್ - ಮತ್ತು ಅಂಬ್ರೆಲ್ಲಾ ಸರಿಯಾದ ಫಾರ್ಮ್ ಅನ್ನು ಸೂಚಿಸುತ್ತದೆ ಮತ್ತು ಅದನ್ನು ಭರ್ತಿ ಮಾಡಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ.",
  "tutorialsConsumerDocumentDraftingIntroTitle": "ಕರಡು ಕಾನೂನು ದಾಖಲೆಗಳು",
  "tutorialsConsumerDocumentDraftingWorkspaceBody": "ಕೆಲವು ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರಿಸಿ, AI-ರಚಿಸಿದ ಪಠ್ಯವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಸಿದ್ಧಪಡಿಸಿದ ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಅಥವಾ ಹಂಚಿಕೊಳ್ಳಿ.",
  "tutorialsConsumerDocumentDraftingWorkspaceTitle": "ಮಾರ್ಗದರ್ಶಿ ಕರಡು ರಚನೆ",
  "tutorialsConsumerDocumentReviewAnalyzeBody": "AI ಮಾದರಿಯನ್ನು ಆರಿಸಿ ಮತ್ತು ವಿಶ್ಲೇಷಿಸು ಕ್ಲಿಕ್ ಮಾಡಿ. ಫಲಿತಾಂಶಗಳು ಅಪಾಯಗಳು, ಪ್ರಮುಖ ನಿಯಮಗಳು ಮತ್ತು ಸೂಚಿಸಿದ ತಿದ್ದುಪಡಿಗಳನ್ನು ಹೈಲೈಟ್ ಮಾಡುತ್ತವೆ.",
  "tutorialsConsumerDocumentReviewAnalyzeTitle": "ವಿಶ್ಲೇಷಣೆಯನ್ನು ಚಲಾಯಿಸಿ",
  "tutorialsConsumerDocumentReviewHelpB1": "ಒಂದು ಒಪ್ಪಂದಕ್ಕೆ ಏಕ ಮೋಡ್ ಬಳಸಿ; ಅನೇಕ ಫೈಲ್‌ಗಳನ್ನು ಹೋಲಿಸಲು ಕೋಷ್ಟಕ ಮೋಡ್.",
  "tutorialsConsumerDocumentReviewHelpB2": "ಸಹಿ ಮಾಡುವ ಮೊದಲು ಮರುಭೇಟಿ ಮಾಡಲು ವಿಮರ್ಶೆಗಳನ್ನು ಉಳಿಸಿ.",
  "tutorialsConsumerDocumentReviewHelpB3": "ಹೆಚ್ಚಿನ ಹಕ್ಕನ್ನು ಹೊಂದಿರುವ ದಾಖಲೆಗಳ ಕುರಿತು ಔಪಚಾರಿಕ ಸಲಹೆಗಾಗಿ ನಿಮ್ಮ ವಕೀಲರೊಂದಿಗೆ ಫಲಿತಾಂಶಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ.",
  "tutorialsConsumerDocumentReviewHelpTitle": "ಡಾಕ್ಯುಮೆಂಟ್ ಪರಿಶೀಲನೆ",
  "tutorialsConsumerDocumentReviewUploadBody": "PDF, Word ಫೈಲ್ ಅನ್ನು ಬಿಡಿ ಅಥವಾ ಪಠ್ಯವನ್ನು ಅಂಟಿಸಿ. ಅಂಬ್ರೆಲಾ ಅಪಾಯಕಾರಿ ಷರತ್ತುಗಳನ್ನು ಫ್ಲ್ಯಾಗ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ಸುಧಾರಣೆಗಳನ್ನು ಸೂಚಿಸುತ್ತದೆ.",
  "tutorialsConsumerDocumentReviewUploadTitle": "ಅಪ್ಲೋಡ್ ಅಥವಾ ಅಂಟಿಸಿ",
  "tutorialsConsumerFindLawyerHelpB1": "ನಿಮಗೆ ಇನ್ನೊಂದು ನ್ಯಾಯವ್ಯಾಪ್ತಿಯಲ್ಲಿ ವಕೀಲರ ಅಗತ್ಯವಿದ್ದರೆ ದೇಶವನ್ನು ಬದಲಿಸಿ.",
  "tutorialsConsumerFindLawyerHelpB2": "ಬುಕಿಂಗ್ ದಾಖಲೆಯನ್ನು ರಚಿಸುತ್ತದೆ, ನಂತರ ನೀವು ಪ್ರಕರಣಕ್ಕೆ ಲಿಂಕ್ ಮಾಡಬಹುದು.",
  "tutorialsConsumerFindLawyerHelpB3": "ನಿಮ್ಮ ಸಮಸ್ಯೆ-ಪರಿಶೀಲನಾ ವರದಿಗಳು ವಕೀಲರಿಗೆ ನಿಮ್ಮ ಪರಿಸ್ಥಿತಿಯನ್ನು ವೇಗವಾಗಿ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ.",
  "tutorialsConsumerFindLawyerHelpTitle": "ವಕೀಲರನ್ನು ಹುಡುಕಿ",
  "tutorialsConsumerFindLawyerResultsBody": "ಪ್ರೊಫೈಲ್‌ಗಳು, ಅಭ್ಯಾಸ ಪ್ರದೇಶಗಳು ಮತ್ತು ನ್ಯಾಯವ್ಯಾಪ್ತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ. ನೀವು ಮಾತನಾಡಲು ಸಿದ್ಧರಾದಾಗ ಸಮಾಲೋಚನೆಯನ್ನು ಬುಕ್ ಮಾಡಿ.",
  "tutorialsConsumerFindLawyerResultsTitle": "ಹೋಲಿಸಿ ಮತ್ತು ಪುಸ್ತಕ ಮಾಡಿ",
  "tutorialsConsumerFindLawyerSearchBody": "ಹೆಸರು ಅಥವಾ ಅಭ್ಯಾಸ ಪ್ರದೇಶದ ಮೂಲಕ ಹುಡುಕಿ ಮತ್ತು ದೇಶದ ಮೂಲಕ ಫಿಲ್ಟರ್ ಮಾಡಿ. ಪಟ್ಟಿ ಮಾಡಲಾದ ಪ್ರತಿಯೊಬ್ಬ ವಕೀಲರನ್ನು ಅಂಬ್ರೆಲಾದಲ್ಲಿ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ.",
  "tutorialsConsumerFindLawyerSearchTitle": "ಸರಿಯಾದ ವಕೀಲರನ್ನು ಹುಡುಕಿ",
  "tutorialsConsumerFirAnalysisHelpB1": "ಪ್ರಕರಣದ ಮೂಲಕ ನಿಮ್ಮ ವಕೀಲರೊಂದಿಗೆ ಫಲಿತಾಂಶಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ.",
  "tutorialsConsumerFirAnalysisHelpB2": "ತುರ್ತು ಸಂದರ್ಭಗಳಲ್ಲಿ, ತಕ್ಷಣ ವಕೀಲರನ್ನು ಸಂಪರ್ಕಿಸಿ.",
  "tutorialsConsumerFirAnalysisHelpTitle": "ಎಫ್ಐಆರ್ ಸಹಾಯ",
  "tutorialsConsumerFirAnalysisIntroBody": "ವಿಧಿಸಲಾದ ಅಪರಾಧಗಳು, ಜಾಮೀನು ಆಯ್ಕೆಗಳು ಮತ್ತು ಪ್ರಾಯೋಗಿಕ ಮುಂದಿನ ಹಂತಗಳನ್ನು ನೋಡಲು ಎಫ್‌ಐಆರ್ ಅನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ.",
  "tutorialsConsumerFirAnalysisIntroTitle": "ನಿಮ್ಮ ಎಫ್ಐಆರ್ ಅನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಿ",
  "tutorialsConsumerFirAnalysisUploadBody": "FIR ಕೆಲಸಗಳ ಫೋಟೋ ಅಥವಾ PDF. ವಿಶ್ಲೇಷಣೆಯು ನಿಮ್ಮ ಖಾತೆಗೆ ಖಾಸಗಿಯಾಗಿದೆ.",
  "tutorialsConsumerFirAnalysisUploadTitle": "ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ",
  "tutorialsConsumerIndiaDraftingHelpB1": "ಭಾರತದ ಅಧಿಕಾರ ವ್ಯಾಪ್ತಿ ಮಾತ್ರ.",
  "tutorialsConsumerIndiaDraftingHelpB2": "ನಿಮ್ಮ ವಕೀಲರಿಗೆ ಸಂಪಾದಿಸಲು ಕೇಸ್‌ಗೆ ಉಳಿಸಿ.",
  "tutorialsConsumerIndiaDraftingHelpTitle": "ಭಾರತದ ಕರಡುಗಳು",
  "tutorialsConsumerIndiaDraftingIntroBody": "BNS/BNSS/BSA 2023 ರ ಅಡಿಯಲ್ಲಿ ಜಾಮೀನು, ನಿರ್ವಹಣೆ, ಗ್ರಾಹಕರ ದೂರುಗಳು ಮತ್ತು ಕಾನೂನು ಸೂಚನೆಗಳಿಗಾಗಿ ಆರಂಭಿಕ ಹಂತದ ಕರಡುಗಳು.",
  "tutorialsConsumerIndiaDraftingIntroTitle": "ಭಾರತ ನ್ಯಾಯಾಲಯದ ಕರಡುಗಳು",
  "tutorialsConsumerIndiaDraftingWorkspaceBody": "ಟೆಂಪ್ಲೇಟ್ ಅನ್ನು ಆರಿಸಿ, ನಿಮ್ಮ ಸಂಗತಿಗಳನ್ನು ವಿವರಿಸಿ ಮತ್ತು ವಕೀಲರ ಪರಿಶೀಲನೆಗಾಗಿ ಡ್ರಾಫ್ಟ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.",
  "tutorialsConsumerIndiaDraftingWorkspaceTitle": "ಒಂದು ಸ್ವರೂಪವನ್ನು ಆಯ್ಕೆಮಾಡಿ",
  "tutorialsConsumerLawyerReviewHelpB1": "ದೇಶ ಮತ್ತು ಸಂಚಿಕೆ ಪ್ರಕಾರ ಶುಲ್ಕಗಳು ಬದಲಾಗುತ್ತವೆ.",
  "tutorialsConsumerLawyerReviewHelpB2": "ಪರಿಶೀಲಿಸಿದ ವಕೀಲರು ನಿಮ್ಮ ಕೇಸ್ ಸಂದೇಶಗಳ ಮೂಲಕ ಪ್ರತಿಕ್ರಿಯಿಸುತ್ತಾರೆ.",
  "tutorialsConsumerLawyerReviewHelpB3": "ತುರ್ತು ಕಾನೂನು ಸಲಹೆಗಾರರಿಗೆ ಪರ್ಯಾಯವಲ್ಲ.",
  "tutorialsConsumerLawyerReviewHelpTitle": "ವಕೀಲರ ವಿಮರ್ಶೆ",
  "tutorialsConsumerLawyerReviewRequestBody": "ನಿಮ್ಮ ನಿರ್ದಿಷ್ಟ ಪರಿಸ್ಥಿತಿಗಾಗಿ ಪರಿಶೀಲಿಸಿದ ವಕೀಲ-ಪರಿಶೀಲಿಸಿದ ಅಭಿಪ್ರಾಯಕ್ಕೆ AI ವರದಿಯನ್ನು ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ.",
  "tutorialsConsumerLawyerReviewRequestTitle": "ಔಪಚಾರಿಕ ಪರಿಶೀಲನೆಗೆ ವಿನಂತಿಸಿ",
  "tutorialsConsumerMarketplaceHelpB1": "ಸೇವೆಯ ಆಧಾರದ ಮೇಲೆ ಬೆಲೆಗಳು ಮತ್ತು ಟರ್ನ್ಅರೌಂಡ್ ಬದಲಾಗುತ್ತವೆ.",
  "tutorialsConsumerMarketplaceHelpB2": "ಟ್ರ್ಯಾಕಿಂಗ್‌ಗಾಗಿ ನಿಮ್ಮ ಅಂಬ್ರೆಲಾ ಖಾತೆಗೆ ಖರೀದಿಗಳ ಲಿಂಕ್.",
  "tutorialsConsumerMarketplaceHelpTitle": "ಮಾರುಕಟ್ಟೆ ಸ್ಥಳ",
  "tutorialsConsumerMarketplaceSkusBody": "ಪರಿಶೀಲಿಸಿದ ವೃತ್ತಿಪರರಿಂದ ಸ್ಥಿರ ಬೆಲೆಯ ಕೊಡುಗೆಗಳನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ-ಡಾಕ್ಯುಮೆಂಟ್ ಪರಿಶೀಲನೆ, ಸಮಾಲೋಚನೆ, ಅನುಸರಣೆ ಪರಿಶೀಲನೆಗಳು.",
  "tutorialsConsumerMarketplaceSkusTitle": "ಕಾನೂನು ಸೇವೆಗಳು",
  "tutorialsConsumerPlanUsageHelpB1": "ಭಾರೀ ಸಂಶೋಧನೆ ಮತ್ತು ದಾಖಲೆ ಪರಿಶೀಲನೆಯು ತ್ವರಿತ ತಪಾಸಣೆಗಿಂತ ಹೆಚ್ಚಿನ ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ.",
  "tutorialsConsumerPlanUsageHelpB2": "ನೀವು ಕಡಿಮೆ ಚಾಲನೆಯಲ್ಲಿರುವಾಗ ಚಂದಾದಾರಿಕೆಯಿಂದ ಪ್ಯಾಕ್‌ಗಳನ್ನು ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ ಅಥವಾ ಖರೀದಿಸಿ.",
  "tutorialsConsumerPlanUsageHelpTitle": "ಯೋಜನೆ ಮತ್ತು ಬಳಕೆ",
  "tutorialsConsumerPlanUsageUsageBody": "ಉಳಿದ ಕ್ರೆಡಿಟ್‌ಗಳು, ವೈಶಿಷ್ಟ್ಯದ ಮೂಲಕ ಇತ್ತೀಚಿನ ಬಳಕೆಯನ್ನು ನೋಡಿ ಮತ್ತು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ AI ಮಾದರಿ ಅಥವಾ ಟಾಪ್-ಅಪ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಹೊಂದಿಸಿ.",
  "tutorialsConsumerPlanUsageUsageTitle": "ಕ್ರೆಡಿಟ್‌ಗಳು ಮತ್ತು ಬಳಕೆ",
  "tutorialsConsumerReportsHelpB1": "ಅವರು ರಚಿಸಲಾದ ಪ್ರಕರಣಕ್ಕೆ ವರದಿಗಳ ಲಿಂಕ್.",
  "tutorialsConsumerReportsHelpB2": "ವರದಿಯ ಕುರಿತು ಔಪಚಾರಿಕ ಸಲಹೆಗಾಗಿ ವಕೀಲರ ವಿಮರ್ಶೆಯನ್ನು ವಿನಂತಿಸಿ.",
  "tutorialsConsumerReportsHelpTitle": "ವರದಿಗಳು",
  "tutorialsConsumerReportsListBody": "ನಿಮ್ಮ ಎಲ್ಲಾ ಪ್ರಕರಣಗಳಲ್ಲಿ AI ಸಂಚಿಕೆ-ಪರಿಶೀಲನೆ ಮತ್ತು ವಿಶ್ಲೇಷಣಾ ವರದಿಗಳು - ವಕೀಲರೊಂದಿಗೆ ಓದಲು ಅಥವಾ ಹಂಚಿಕೊಳ್ಳಲು ಯಾವುದನ್ನಾದರೂ ತೆರೆಯಿರಿ.",
  "tutorialsConsumerReportsListTitle": "ನಿಮ್ಮ ವರದಿಗಳು",
  "tutorialsConsumerResearchHelpB1": "ಸಂಶೋಧನೆಯು AI ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ-ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ ನಿಮ್ಮ ಸಮತೋಲನವನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsConsumerResearchHelpB2": "ನಿಮ್ಮ ವಕೀಲರನ್ನು ಪರಿಶೀಲಿಸಲು ಪ್ರಕರಣಕ್ಕೆ ಉಪಯುಕ್ತ ಉತ್ತರಗಳನ್ನು ಉಳಿಸಿ.",
  "tutorialsConsumerResearchHelpB3": "ಇದು ಸಾಮಾನ್ಯ ಮಾಹಿತಿಯಾಗಿದೆ, ಔಪಚಾರಿಕ ಕಾನೂನು ಸಲಹೆಯಲ್ಲ-ನಿರ್ಣಯಗಳು ಮುಖ್ಯವಾದಾಗ ವಕೀಲರ ವಿಮರ್ಶೆಯನ್ನು ವಿನಂತಿಸಿ.",
  "tutorialsConsumerResearchHelpTitle": "ಕಾನೂನು ಸಂಶೋಧನೆ",
  "tutorialsConsumerResearchQueryBody": "ನಿಮ್ಮ ಪರಿಸ್ಥಿತಿಯ ಬಗ್ಗೆ ಸರಳ ಭಾಷೆಯಲ್ಲಿ ಕೇಳಿ. ಉತ್ತಮ ಉತ್ತರಗಳಿಗಾಗಿ ನಿಮ್ಮ ದೇಶ ಮತ್ತು ಪ್ರಮುಖ ಸಂಗತಿಗಳನ್ನು ಸೇರಿಸಿ.",
  "tutorialsConsumerResearchQueryTitle": "ನಿಮ್ಮ ಪ್ರಶ್ನೆಯನ್ನು ಸಂಶೋಧಿಸಿ",
  "tutorialsConsumerResearchSourcesBody": "ಯಾವ ಕಾನೂನುಗಳು ಮತ್ತು ಕೇಸ್ ಕಾನೂನನ್ನು ಹುಡುಕಬೇಕೆಂದು ಆಯ್ಕೆಮಾಡಿ. ಕಡಿಮೆ ಮೂಲಗಳು ಸಾಮಾನ್ಯವಾಗಿ ವೇಗವಾದ, ಸ್ಪಷ್ಟವಾದ ಫಲಿತಾಂಶಗಳನ್ನು ಅರ್ಥೈಸುತ್ತವೆ.",
  "tutorialsConsumerResearchSourcesTitle": "ವಿಶ್ವಾಸಾರ್ಹ ಮೂಲಗಳನ್ನು ಆರಿಸಿ",
  "tutorialsConsumerRightsCheckerHelpB1": "ಸಾಮಾನ್ಯ ಮಾರ್ಗದರ್ಶನ ಮಾತ್ರ, ಕಾನೂನು ಸಲಹೆಯಲ್ಲ.",
  "tutorialsConsumerRightsCheckerHelpB2": "ಸಮಸ್ಯೆ ಪರಿಶೀಲನೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ ಅಥವಾ ನಿಮ್ಮ ಪ್ರಕರಣಕ್ಕೆ ವಕೀಲರನ್ನು ಹುಡುಕಿ.",
  "tutorialsConsumerRightsCheckerHelpTitle": "ಹಕ್ಕು ಪರೀಕ್ಷಕ",
  "tutorialsConsumerRightsCheckerScenariosBody": "ನಿಮ್ಮ ಹಕ್ಕುಗಳು ಮತ್ತು ಶಿಫಾರಸು ಮಾಡಿದ ಹಂತಗಳನ್ನು ನೋಡಲು-ವಸತಿ, ಉದ್ಯೋಗ, ಸಾಲ, ಪೋಲೀಸ್-ಸನ್ನಿವೇಶವನ್ನು ಆರಿಸಿ.",
  "tutorialsConsumerRightsCheckerScenariosTitle": "ನಿಮ್ಮ ಹಕ್ಕುಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳಿ",
  "tutorialsConsumerSectionFinderHelpB1": "ಪೊಲೀಸ್ ವರದಿಗಳು ಮತ್ತು ಎಫ್‌ಐಆರ್‌ಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಉಪಯುಕ್ತವಾಗಿದೆ.",
  "tutorialsConsumerSectionFinderHelpB2": "ನ್ಯಾಯಾಲಯದಲ್ಲಿ ಅವಲಂಬಿಸುವ ಮೊದಲು ಅಧಿಕೃತ ಬೇರ್ ಕೃತ್ಯಗಳ ವಿರುದ್ಧ ಪರಿಶೀಲಿಸಿ.",
  "tutorialsConsumerSectionFinderHelpTitle": "ವಿಭಾಗ ಶೋಧಕ",
  "tutorialsConsumerSectionFinderWorkspaceBody": "ಸರಳ ಭಾಷೆಯಲ್ಲಿ IPC→BNS ಕ್ರಾಸ್‌ವಾಕ್‌ಗಳೊಂದಿಗೆ ಭಾರತೀಯ ದಂಡ ಮತ್ತು ಕಾರ್ಯವಿಧಾನದ ವಿಭಾಗಗಳನ್ನು ನೋಡಿ.",
  "tutorialsConsumerSectionFinderWorkspaceTitle": "ವಿಭಾಗವನ್ನು ಹುಡುಕಿ",
  "tutorialsConsumerSettingsConsentFormBody": "ನಿಮ್ಮ ಡೇಟಾವು ಪ್ರಾಂಪ್ಟ್‌ಗಳು, ಮೌಲ್ಯಮಾಪನ ಅಥವಾ ಮಾದರಿ ತರಬೇತಿಯನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ ಎಂಬುದನ್ನು ನಿಯಂತ್ರಿಸಿ.",
  "tutorialsConsumerSettingsConsentFormTitle": "ಡೇಟಾ ಮತ್ತು AI ಸಮ್ಮತಿ",
  "tutorialsConsumerSettingsConsentHelpB1": "ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಹೊರಗುಳಿಯಬಹುದು.",
  "tutorialsConsumerSettingsConsentHelpB2": "ತರಬೇತಿಯ ಒಪ್ಪಿಗೆಯಿಲ್ಲದೆ ಕೋರ್ ವೈಶಿಷ್ಟ್ಯಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ.",
  "tutorialsConsumerSettingsConsentHelpTitle": "ಡೇಟಾ ಸಮ್ಮತಿ",
  "tutorialsConsumerSettingsHelpB1": "AI ತರಬೇತಿ ಮತ್ತು ವಿಶ್ಲೇಷಣೆಗಾಗಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೇಗೆ ಬಳಸಲಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ನಿಯಂತ್ರಿಸಿ.",
  "tutorialsConsumerSettingsHelpB2": "ಸಂಪರ್ಕ ವಿವರಗಳನ್ನು ಪ್ರಸ್ತುತವಾಗಿ ಇರಿಸಿ ಇದರಿಂದ ನಿಮ್ಮ ವಕೀಲರು ನಿಮ್ಮನ್ನು ತಲುಪಬಹುದು.",
  "tutorialsConsumerSettingsHelpB3": "ಸುಧಾರಿತ AI ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವ ಮೊದಲು ಡೇಟಾ ಸಮ್ಮತಿಯನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsConsumerSettingsHelpTitle": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು",
  "tutorialsConsumerSettingsHubBody": "AI ವೈಶಿಷ್ಟ್ಯಗಳಿಗಾಗಿ ಪ್ರೊಫೈಲ್, ಪಾವತಿ ವಿಧಾನಗಳು, ಗೌಪ್ಯತೆ ಆದ್ಯತೆಗಳು ಮತ್ತು ಡೇಟಾ ಸಮ್ಮತಿಯನ್ನು ನವೀಕರಿಸಿ.",
  "tutorialsConsumerSettingsHubTitle": "ಖಾತೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು",
  "tutorialsConsumerSettingsPaymentHelpB1": "ಸೇವೆಯ ಅಡಚಣೆಗಳನ್ನು ತಪ್ಪಿಸಲು ಮಾನ್ಯವಾದ ಕಾರ್ಡ್ ಅನ್ನು ಇರಿಸಿ.",
  "tutorialsConsumerSettingsPaymentHelpB2": "ನಿಮ್ಮ ಚಂದಾದಾರಿಕೆ ಇತಿಹಾಸದಲ್ಲಿ ರಸೀದಿಗಳು ಗೋಚರಿಸುತ್ತವೆ.",
  "tutorialsConsumerSettingsPaymentHelpTitle": "ಪಾವತಿ ವಿಧಾನಗಳು",
  "tutorialsConsumerSettingsPaymentMethodsBody": "ಚಂದಾದಾರಿಕೆಗಳು ಮತ್ತು ಕ್ರೆಡಿಟ್ ಟಾಪ್-ಅಪ್‌ಗಳಿಗಾಗಿ ಕಾರ್ಡ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ. ಸ್ವಯಂ ಟಾಪ್-ಅಪ್ ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ವಿಧಾನವನ್ನು ಬಳಸುತ್ತದೆ.",
  "tutorialsConsumerSettingsPaymentMethodsTitle": "ಪಾವತಿ ವಿಧಾನಗಳು",
  "tutorialsConsumerSubscriptionHelpB1": "ವಿವರವಾದ ಕ್ರೆಡಿಟ್ ಸ್ಥಗಿತಕ್ಕಾಗಿ ಯೋಜನೆ ಮತ್ತು ಬಳಕೆಯನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsConsumerSubscriptionHelpB2": "ಗಡುವು-ಭಾರೀ ವಾರಗಳ ಮೊದಲು ಸ್ವಯಂ ಟಾಪ್-ಅಪ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ.",
  "tutorialsConsumerSubscriptionHelpB3": "ಪ್ಲಸ್ ಯೋಜನೆಗಳು ಹೆಚ್ಚು ಮಾಸಿಕ ಕ್ರೆಡಿಟ್‌ಗಳು ಮತ್ತು ಆದ್ಯತೆಯ ಬೆಂಬಲವನ್ನು ಒಳಗೊಂಡಿವೆ.",
  "tutorialsConsumerSubscriptionHelpTitle": "ಚಂದಾದಾರಿಕೆ",
  "tutorialsConsumerSubscriptionPlansBody": "ಉಚಿತ ಮತ್ತು ಪ್ಲಸ್ ಯೋಜನೆಗಳನ್ನು ಹೋಲಿಕೆ ಮಾಡಿ, ಕ್ರೆಡಿಟ್ ಪ್ಯಾಕ್‌ಗಳನ್ನು ಖರೀದಿಸಿ ಮತ್ತು ಸ್ವಯಂ ಟಾಪ್-ಅಪ್ ಅನ್ನು ನಿರ್ವಹಿಸಿ ಆದ್ದರಿಂದ AI ವೈಶಿಷ್ಟ್ಯಗಳು ಎಂದಿಗೂ ಮಧ್ಯ ಕಾರ್ಯವನ್ನು ನಿಲ್ಲಿಸುವುದಿಲ್ಲ.",
  "tutorialsConsumerSubscriptionPlansTitle": "ಯೋಜನೆಗಳು ಮತ್ತು ಕ್ರೆಡಿಟ್‌ಗಳು",
  "tutorialsContractsDashboardBody": "ಒಂದು ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ ಒಪ್ಪಂದದ ಸ್ಥಿತಿ, ನವೀಕರಣಗಳು, ಕಟ್ಟುಪಾಡುಗಳು ಮತ್ತು ಲಿಂಕ್ ಮಾಡಿದ ವಿಷಯಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ.",
  "tutorialsContractsDashboardTitle": "ಒಪ್ಪಂದದ ಜೀವನಚಕ್ರ",
  "tutorialsContractsHelpB1": "ಪ್ರಮುಖ ದಿನಾಂಕಗಳ AI ಹೊರತೆಗೆಯುವಿಕೆಗಾಗಿ ಕಾರ್ಯಗತಗೊಳಿಸಿದ ಒಪ್ಪಂದಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ.",
  "tutorialsContractsHelpB2": "ತಪ್ಪಿದ ಗಡುವನ್ನು ತಪ್ಪಿಸಲು ನವೀಕರಣ ಎಚ್ಚರಿಕೆಗಳನ್ನು ಹೊಂದಿಸಿ.",
  "tutorialsContractsHelpTitle": "ಒಪ್ಪಂದಗಳು",
