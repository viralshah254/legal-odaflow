  "legalDataConsentConsumerLink": "ಗ್ರಾಹಕ ಡೇಟಾ ಸಮ್ಮತಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು (ನಿಮ್ಮ ಖಾತೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು)",
  "legalDataConsentContactBody": "AI ಡೇಟಾ ಸಂಸ್ಕರಣೆ, ಸಮ್ಮತಿ ಅಥವಾ ಸಮ್ಮತಿ ದಾಖಲೆಗಳ ನಕಲನ್ನು ವಿನಂತಿಸಲು ಕುರಿತು ಪ್ರಶ್ನೆಗಳಿಗೆ: support@odaflow.com. ನಾವು 10 ವ್ಯವಹಾರ ದಿನಗಳಲ್ಲಿ ಪ್ರತಿಕ್ರಿಯಿಸುವ ಗುರಿಯನ್ನು ಹೊಂದಿದ್ದೇವೆ.",
  "legalDataConsentContactHeading": "11. AI ಡೇಟಾ ವಿಚಾರಣೆಗಾಗಿ ಸಂಪರ್ಕಿಸಿ",
  "legalDataConsentCountryDPDPBody": "ಭಾರತ (DPDP ಕಾಯಿದೆ 2023): AI ತರಬೇತಿಗಾಗಿ ಡಿಜಿಟಲ್ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಲು ಡೇಟಾ ಪ್ರಿನ್ಸಿಪಾಲ್‌ನಿಂದ ಸ್ಪಷ್ಟವಾದ ಒಪ್ಪಿಗೆಯ ಅಗತ್ಯವಿದೆ. ಸಮ್ಮತಿಯ ದಾಖಲೆಗಳನ್ನು ನಿರ್ವಹಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಖಾತೆಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಮೂಲಕ ಪರಿಶೀಲಿಸಬಹುದು ಅಥವಾ ಹಿಂಪಡೆಯಬಹುದು.",
  "legalDataConsentCountryGDPRBody": "EU / UK (GDPR / UK GDPR): ಕಾನೂನು ಅಥವಾ ಅದೇ ರೀತಿಯ ಮಹತ್ವದ ಪರಿಣಾಮಗಳನ್ನು ಉಂಟುಮಾಡುವ ಸ್ವಯಂಚಾಲಿತ ಪ್ರಕ್ರಿಯೆಗೆ ಆರ್ಟ್ ಅಡಿಯಲ್ಲಿ ಮಾನ್ಯವಾದ ಕಾನೂನು ಆಧಾರ ಅಗತ್ಯವಿದೆ. 22 GDPR. ಅಂಬ್ರೆಲಾ ಬಳಕೆದಾರರ ಬಗ್ಗೆ ಬೈಂಡಿಂಗ್ ಸ್ವಯಂಚಾಲಿತ ನಿರ್ಧಾರಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುವುದಿಲ್ಲ. AI ವಿಶ್ಲೇಷಣೆಯು ಗಮನಾರ್ಹ ಫಲಿತಾಂಶಗಳ ಮೇಲೆ ಪ್ರಭಾವ ಬೀರಿದರೆ, ಬಳಕೆದಾರರಿಗೆ ಸೂಚನೆ ನೀಡಲಾಗುತ್ತದೆ ಮತ್ತು ಮಾನವ ವಿಮರ್ಶೆ ಲಭ್ಯವಿದೆ.",
  "legalDataConsentCountryHeading": "6. ದೇಶ-ನಿರ್ದಿಷ್ಟ ಅವಶ್ಯಕತೆಗಳು",
  "legalDataConsentCountryKenyaBody": "ಕೀನ್ಯಾ (ಡೇಟಾ ಪ್ರೊಟೆಕ್ಷನ್ ಆಕ್ಟ್ 2019): ಸ್ವಯಂಚಾಲಿತ ಪ್ರಕ್ರಿಯೆ ಮತ್ತು ಪ್ರೊಫೈಲಿಂಗ್ ಅನ್ನು ಬಹಿರಂಗಪಡಿಸಬೇಕು; ಡೇಟಾ ವಿಷಯಗಳು ಆಕ್ಷೇಪಿಸುವ ಹಕ್ಕನ್ನು ಹೊಂದಿವೆ. ಯಾವುದೇ AI ತರಬೇತಿ ಬಳಕೆಗೆ ಸಮ್ಮತಿಯನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಪಡೆಯಲಾಗುತ್ತದೆ ಮತ್ತು ದಾಖಲಿಸಲಾಗುತ್ತದೆ.",
  "legalDataConsentCountryUSBody": "ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್: CCPA/CPRA ಬಳಕೆದಾರರು ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯ ಮಾರಾಟ ಅಥವಾ ಹಂಚಿಕೆಯಿಂದ ಹೊರಗುಳಿಯುವ ಹಕ್ಕನ್ನು ಹೊಂದಿರುತ್ತಾರೆ. ಅಂಬ್ರೆಲಾ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಮಾರಾಟ ಮಾಡುವುದಿಲ್ಲ. ಸೇವಾ ವಿತರಣೆಗಾಗಿ AI ಪೂರೈಕೆದಾರರೊಂದಿಗೆ ಡೇಟಾವನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದು CCPA ಅಡಿಯಲ್ಲಿ 'ಮಾರಾಟ' ಅಲ್ಲ. ಸ್ಪಷ್ಟವಾದ ಒಪ್ಪಿಗೆಯಿಲ್ಲದೆ AI ಪೂರೈಕೆದಾರರೊಂದಿಗೆ ಸೂಕ್ಷ್ಮವಾದ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ.",
  "legalDataConsentDefaultBody": "ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ, ಅಂಬ್ರೆಲ್ಲಾ ನಿಮ್ಮ ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು, ಕೇಸ್ ವಿವರಣೆಗಳು, ವಿಷಯದ ಟಿಪ್ಪಣಿಗಳು, ಕ್ಲೈಂಟ್ ಸಂವಹನಗಳು, AI ಪ್ರಶ್ನೆಗಳು ಅಥವಾ AI ಮಾದರಿಗಳನ್ನು ತರಬೇತಿ ಮಾಡಲು, ಉತ್ತಮ-ಟ್ಯೂನ್ ಮಾಡಲು ಅಥವಾ ಮೌಲ್ಯಮಾಪನ ಮಾಡಲು ಯಾವುದೇ ಬಳಕೆದಾರ-ಸಲ್ಲಿಸಿದ ವಿಷಯವನ್ನು ಬಳಸುವುದಿಲ್ಲ. ಈ ಡೀಫಾಲ್ಟ್ ಎಲ್ಲಾ ಬಳಕೆದಾರರಿಗೆ ಅನ್ವಯಿಸುತ್ತದೆ - ಗ್ರಾಹಕರು, ವಕೀಲ ಬಳಕೆದಾರರು ಮತ್ತು ಸಂಸ್ಥೆಯ ಬಾಡಿಗೆದಾರರು - ಚಂದಾದಾರಿಕೆ ಶ್ರೇಣಿಯನ್ನು ಲೆಕ್ಕಿಸದೆ. ಎಲ್ಲಾ ಬಾಡಿಗೆದಾರರಿಗೆ ದೃಢವಾದ ತರಬೇತಿ ಸಮ್ಮತಿ ಡಿಫಾಲ್ಟ್ ಆಗಿರುತ್ತದೆ ಮತ್ತು ಬಾಡಿಗೆದಾರ ನಿರ್ವಾಹಕರಿಂದ ಮಾತ್ರ ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು.",
  "legalDataConsentDefaultHeading": "1. ಡೀಫಾಲ್ಟ್: ನಿಮ್ಮ ಡೇಟಾದಲ್ಲಿ ಯಾವುದೇ ತರಬೇತಿ ಇಲ್ಲ",
  "legalDataConsentDescription": "AI ಮಾದರಿ ತರಬೇತಿ, ಮೌಲ್ಯಮಾಪನ ಮತ್ತು ಸುಧಾರಣೆಗೆ ಸಂಬಂಧಿಸಿದಂತೆ DVTech ವೆಂಚರ್ಸ್ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೇಗೆ ನಿರ್ವಹಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಈ ನೀತಿಯು ವಿವರಿಸುತ್ತದೆ. ಇದು ನಮ್ಮ ಒಟ್ಟಾರೆ ಗೌಪ್ಯತೆ ನೀತಿಯ ಭಾಗವಾಗಿದೆ.",
  "legalDataConsentFirmLink": "ಸಂಸ್ಥೆಯ ತರಬೇತಿ ಸಮ್ಮತಿ (ಬಾಡಿಗೆದಾರ ನಿರ್ವಾಹಕ - ವಕೀಲ OS ಸೆಟ್ಟಿಂಗ್‌ಗಳು)",
  "legalDataConsentFormDefaultIs": "ಡೀಫಾಲ್ಟ್ ಆಗಿದೆ",
  "legalDataConsentManageBody": "ನಿಮ್ಮ ಖಾತೆಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಮೂಲಕ ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಸಮ್ಮತಿಯನ್ನು ನೀಡಬಹುದು ಅಥವಾ ಹಿಂಪಡೆಯಬಹುದು. ಭವಿಷ್ಯದ ಡೇಟಾ ಪ್ರಕ್ರಿಯೆಗೆ ಬದಲಾವಣೆಗಳು ತಕ್ಷಣವೇ ಜಾರಿಗೆ ಬರುತ್ತವೆ. ಹಿಂತೆಗೆದುಕೊಳ್ಳುವಿಕೆಯು ಹಿಂತೆಗೆದುಕೊಳ್ಳುವ ಮೊದಲು ನಡೆಸಿದ ಪ್ರಕ್ರಿಯೆಯ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ.",
  "legalDataConsentManageHeading": "7. ನಿಮ್ಮ ಒಪ್ಪಿಗೆಯನ್ನು ಹೇಗೆ ನಿರ್ವಹಿಸುವುದು",
  "legalDataConsentNeverUsedBody": "ಆಪ್ಟ್-ಇನ್ ಸೇರಿದಂತೆ ಯಾವುದೇ ಸಂದರ್ಭಗಳಲ್ಲಿ AI ತರಬೇತಿಗಾಗಿ ಈ ಕೆಳಗಿನ ಡೇಟಾವನ್ನು ಎಂದಿಗೂ ಬಳಸಲಾಗುವುದಿಲ್ಲ: (ಎ) ಬಿಲ್ಲಿಂಗ್ ಮಾಹಿತಿ ಮತ್ತು ಪಾವತಿ ಕಾರ್ಡ್ ಡೇಟಾ; (ಬಿ) ಸಂಪೂರ್ಣ ಕ್ಲೈಂಟ್ ಹೆಸರುಗಳು, ರಾಷ್ಟ್ರೀಯ ID ಸಂಖ್ಯೆಗಳು, ಪಾಸ್‌ಪೋರ್ಟ್ ಸಂಖ್ಯೆಗಳು ಅಥವಾ ಸಂಪೂರ್ಣ ಅನಾಮಧೇಯತೆ ಇಲ್ಲದೆ ಬಯೋಮೆಟ್ರಿಕ್ ಡೇಟಾ; (ಸಿ) ಸವಲತ್ತು ಹೊಂದಿರುವವರು ಸ್ಪಷ್ಟವಾದ ಲಿಖಿತ ಒಪ್ಪಿಗೆಯನ್ನು ಒದಗಿಸದ ಹೊರತು ಕಾನೂನು ವೃತ್ತಿಪರ ಸವಲತ್ತುಗಳಿಂದ ರಕ್ಷಿಸಲ್ಪಟ್ಟ ಸಂವಹನಗಳು; (ಡಿ) ಕಾನೂನು ಹಿಡಿತ ಅಥವಾ ಸಕ್ರಿಯ ದಾವೆಗೆ ಒಳಪಟ್ಟಿರುವ ಡೇಟಾ; (ಇ) ಆರೋಗ್ಯ ಅಥವಾ ವೈದ್ಯಕೀಯ ಡೇಟಾ; (ಎಫ್) 18 ವರ್ಷಕ್ಕಿಂತ ಕಡಿಮೆ ವಯಸ್ಸಿನ ಬಳಕೆದಾರರ ಡೇಟಾ.",
  "legalDataConsentNeverUsedHeading": "4. ತರಬೇತಿಗಾಗಿ ಎಂದಿಗೂ ಬಳಸದ ಡೇಟಾ",
  "legalDataConsentOptInAnonymize": "ಯಾವುದೇ ತರಬೇತಿ ಪೈಪ್‌ಲೈನ್‌ಗೆ ಪ್ರವೇಶಿಸುವ ಮೊದಲು ಎಲ್ಲಾ ಆಯ್ಕೆಯ ಡೇಟಾವು ಅನಾಮಧೇಯಗೊಳಿಸುವಿಕೆ (ವೈಯಕ್ತಿಕ ಗುರುತಿಸುವಿಕೆಗಳನ್ನು ತೆಗೆದುಹಾಕುವುದು) ಮತ್ತು ಗುಪ್ತನಾಮೀಕರಣ (ಹೆಸರುಗಳು, ಘಟಕಗಳು ಮತ್ತು ಸಂಶ್ಲೇಷಿತ ಟೋಕನ್‌ಗಳೊಂದಿಗೆ ಕೇಸ್ ಉಲ್ಲೇಖಗಳನ್ನು ಬದಲಾಯಿಸುವುದು) ಒಳಗಾಗುತ್ತದೆ. ಅನಾಮಧೇಯತೆಯನ್ನು ಸ್ವಯಂಚಾಲಿತ ಸ್ಕ್ಯಾನಿಂಗ್ ಮೂಲಕ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಉತ್ತಮ-ಶ್ರುತಿಗಾಗಿ, ಹಸ್ತಚಾಲಿತ ಸ್ಪಾಟ್-ಚೆಕ್‌ಗಳು.",
  "legalDataConsentOptInEval": "ಮಾದರಿ ಮೌಲ್ಯಮಾಪನ: ಬೆಂಚ್‌ಮಾರ್ಕ್‌ಗಳ ವಿರುದ್ಧ ಮಾದರಿ ಗುಣಮಟ್ಟ, ಸುರಕ್ಷತೆ ಮತ್ತು ನಿಖರತೆಯನ್ನು ಪರೀಕ್ಷಿಸಲು ನಿಮ್ಮ AI ಸಂವಹನಗಳಿಂದ ಪರಿಷ್ಕರಿಸಿದ ಮಾದರಿಗಳನ್ನು ಬಳಸಲಾಗುತ್ತದೆ. NDA ಅಡಿಯಲ್ಲಿ ಅಧಿಕೃತ DVTech ಎಂಜಿನಿಯರ್‌ಗಳು ಮತ್ತು ಗುತ್ತಿಗೆ ಪಡೆದ AI ಮೌಲ್ಯಮಾಪಕರು ಮಾತ್ರ ಮಾದರಿಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತಾರೆ.",
  "legalDataConsentOptInFineTune": "ಫೈನ್-ಟ್ಯೂನಿಂಗ್: ನಿರ್ವಾಹಕರ ಅನುಮೋದನೆಯೊಂದಿಗೆ, ಡೊಮೇನ್-ನಿರ್ದಿಷ್ಟ ಮಾದರಿ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು ಫೈನ್-ಟ್ಯೂನಿಂಗ್ ಡೇಟಾಸೆಟ್‌ಗಳಲ್ಲಿ ಗುಪ್ತನಾಮೀಕರಿಸಿದ ಕಾನೂನು ಕರಡುಗಳು ಅಥವಾ ಮ್ಯಾಟರ್ ಸಾರಾಂಶಗಳನ್ನು ಸೇರಿಸಬಹುದು. ಫೈನ್-ಟ್ಯೂನಿಂಗ್ ಡೇಟಾಸೆಟ್‌ಗಳಿಗೆ ಹಿಡುವಳಿದಾರ ನಿರ್ವಾಹಕರು ಮತ್ತು DVTech ಡೇಟಾ ಆಡಳಿತ ಅಧಿಕಾರಿಯಿಂದ ದ್ವಿ-ಅನುಮೋದನೆಯ ಅಗತ್ಯವಿರುತ್ತದೆ.",
  "legalDataConsentOptInHeading": "3. ಯಾವ ಆಯ್ಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ",
  "legalDataConsentOptInIntro": "ನೀವು ಆಯ್ಕೆಮಾಡಲು ಆಯ್ಕೆ ಮಾಡಿದರೆ, ನೀವು ಕೆಳಗಿನವುಗಳಲ್ಲಿ ಒಂದನ್ನು ಅಥವಾ ಹೆಚ್ಚಿನದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು, ಪ್ರತಿಯೊಂದೂ ಸ್ವತಂತ್ರವಾಗಿ:",
  "legalDataConsentOptInIntroSection": "ನೀವು ಆಯ್ಕೆ ಮಾಡಿದರೆ, ನೀವು ಪ್ರತ್ಯೇಕವಾಗಿ ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು:",
  "legalDataConsentOptInPrompt": "ಪ್ರಾಂಪ್ಟ್ ಸುಧಾರಣೆ: ಪ್ರಾಂಪ್ಟ್ ಇಂಜಿನಿಯರಿಂಗ್ ಅನ್ನು ಸುಧಾರಿಸಲು ಮತ್ತು ಭ್ರಮೆಗಳನ್ನು ಕಡಿಮೆ ಮಾಡಲು ನಿಮ್ಮ AI ಪ್ರಶ್ನೆಗಳಿಂದ ಅನಾಮಧೇಯ ಮಾದರಿಗಳನ್ನು ಬಳಸಲಾಗುತ್ತದೆ. ವೈಯಕ್ತಿಕವಾಗಿ ಗುರುತಿಸಬಹುದಾದ ಮಾಹಿತಿ ಅಥವಾ ಪ್ರಕರಣ-ನಿರ್ದಿಷ್ಟ ಸಂಗತಿಗಳನ್ನು ಸೇರಿಸಲಾಗಿಲ್ಲ.",
  "legalDataConsentProvidersBody": "ಅಂಬ್ರೆಲಾ ಮೂರನೇ ವ್ಯಕ್ತಿಯ AI ಪೂರೈಕೆದಾರರಿಗೆ AI ಪ್ರಶ್ನೆಗಳನ್ನು ರವಾನಿಸುತ್ತದೆ. ವಿಶ್ಲೇಷಣೆ ಮತ್ತು ಕರಡು ರಚನೆಗಾಗಿ: OpenAI (GPT ಮಾದರಿಗಳು) ಮತ್ತು DeepSeek. ಎಂಬೆಡಿಂಗ್‌ಗಳು ಮತ್ತು ಡಾಕ್ಯುಮೆಂಟ್ ಹುಡುಕಾಟಕ್ಕಾಗಿ: OpenAI. ಸಭೆ ಮತ್ತು ಧ್ವನಿ ಪ್ರತಿಲೇಖನಕ್ಕಾಗಿ: ಡೀಪ್ಗ್ರಾಮ್. ಈ ಪೂರೈಕೆದಾರರು ನಿಮ್ಮ ಪ್ರಶ್ನೆಗಳನ್ನು ಈ ಕೆಳಗಿನಂತೆ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸುತ್ತಾರೆ: (ಎ) ಲಭ್ಯವಿರುವಲ್ಲಿ ಶೂನ್ಯ-ಡೇಟಾ-ಧಾರಣ API ಒಪ್ಪಂದಗಳು (ಪ್ರಶ್ನೆಗಳನ್ನು ಒದಗಿಸುವವರ ಮಾದರಿಗಳಿಗೆ ತರಬೇತಿ ನೀಡಲು ಬಳಸಲಾಗುವುದಿಲ್ಲ); (ಬಿ) ಸೇವೆಯ ವಿತರಣೆಗೆ ಬಳಕೆಯನ್ನು ನಿರ್ಬಂಧಿಸುವ ಡೇಟಾ ಸಂಸ್ಕರಣಾ ಒಪ್ಪಂದಗಳು; (ಸಿ) ಸೂಕ್ತವಾದ ಕ್ರಾಸ್-ಬಾರ್ಡರ್ ವರ್ಗಾವಣೆ ಕಾರ್ಯವಿಧಾನಗಳು (EU/UK ಗಾಗಿ SCCಗಳು; ಇತರ ನ್ಯಾಯವ್ಯಾಪ್ತಿಗಳಿಗೆ ಸಮಾನವಾದ ಒಪ್ಪಂದಗಳು). ಪ್ರತಿ ವೈಶಿಷ್ಟ್ಯಕ್ಕಾಗಿ ಬಳಕೆಯಲ್ಲಿರುವ ನಿರ್ದಿಷ್ಟ ಪೂರೈಕೆದಾರರನ್ನು ವಿನಂತಿಯ ಮೇರೆಗೆ ಲಭ್ಯವಿರುವ ನಮ್ಮ ಸಬ್‌ಪ್ರೊಸೆಸರ್ ರಿಜಿಸ್ಟರ್‌ನಲ್ಲಿ ದಾಖಲಿಸಲಾಗಿದೆ.",
  "legalDataConsentProvidersHeading": "5. ಮೂರನೇ ವ್ಯಕ್ತಿಯ AI ಪೂರೈಕೆದಾರರು",
