  "legalDeleteAccountPartialHeading": "ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಅಳಿಸದೆಯೇ ಕೆಲವು ಡೇಟಾವನ್ನು ಅಳಿಸಿ",
  "legalDeleteAccountPrivacyLink": "ಗೌಪ್ಯತೆ ನೀತಿ",
  "legalDeleteAccountRetainedBody": "ಕಾನೂನಿನ ಪ್ರಕಾರ ಅಥವಾ ಕಾನೂನುಬದ್ಧ ವ್ಯಾಪಾರ ಅಗತ್ಯಗಳಿಗಾಗಿ ಕೆಲವು ಮಾಹಿತಿಯನ್ನು ಉಳಿಸಿಕೊಳ್ಳಬಹುದು: ಬಿಲ್ಲಿಂಗ್ ಮತ್ತು ತೆರಿಗೆ ದಾಖಲೆಗಳು (7 ವರ್ಷಗಳವರೆಗೆ), ಭದ್ರತೆ ಮತ್ತು ಆಡಿಟ್ ಲಾಗ್‌ಗಳು (12 ತಿಂಗಳವರೆಗೆ), ನಿಮ್ಮನ್ನು ಗುರುತಿಸಲು ಸಾಧ್ಯವಾಗದ ಅನಾಮಧೇಯ ವಿಶ್ಲೇಷಣೆಗಳು ಮತ್ತು ನೀವು ಸಂಸ್ಥೆಯ ಬಾಡಿಗೆದಾರರ ಸದಸ್ಯರಾಗಿದ್ದಲ್ಲಿ (ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ನಿರ್ವಾಹಕರಿಂದ ನಿರ್ವಹಿಸಲ್ಪಡುವ) ಕಾನೂನು ಸಂಸ್ಥೆಯ ಕಾರ್ಯಸ್ಥಳದ ಡೇಟಾ.",
  "legalDeleteAccountRetainedHeading": "ಇರಿಸಬಹುದಾದ ಡೇಟಾ",
  "legalDeleteAccountRetentionBody": "ದೃಢಪಡಿಸಿದ ಅಳಿಸುವಿಕೆ ವಿನಂತಿಯ 30 ದಿನಗಳಲ್ಲಿ ಹೆಚ್ಚಿನ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ ಅಥವಾ ಅನಾಮಧೇಯಗೊಳಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೊಂದಿರುವ ಬ್ಯಾಕಪ್ ಪ್ರತಿಗಳನ್ನು 90 ದಿನಗಳಲ್ಲಿ ರೋಲಿಂಗ್ ಆಧಾರದ ಮೇಲೆ ಶುದ್ಧೀಕರಿಸಲಾಗುತ್ತದೆ.",
  "legalDeleteAccountRetentionHeading": "ಧಾರಣ ಅವಧಿ",
  "legalDeleteAccountStep1": "umbrella.okaylegal.ai ನಲ್ಲಿ ಅಂಬ್ರೆಲಾಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ ಅಥವಾ ನೀವು ಅಳಿಸಲು ಬಯಸುವ ಖಾತೆಯೊಂದಿಗೆ ಅಂಬ್ರೆಲಾ ಲೀಗಲ್ AI ಮೊಬೈಲ್ ಅಪ್ಲಿಕೇಶನ್ ತೆರೆಯಿರಿ.",
  "legalDeleteAccountStep2": "ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ ಈ ಪುಟದಲ್ಲಿ ಅಳಿಸುವಿಕೆ ಫಾರ್ಮ್ ಅನ್ನು ಬಳಸಿ ಅಥವಾ ನಿಮ್ಮ ನೋಂದಾಯಿತ ಇಮೇಲ್ ವಿಳಾಸದಿಂದ \"ಖಾತೆ ಅಳಿಸುವಿಕೆ ವಿನಂತಿ\" ಎಂಬ ವಿಷಯದೊಂದಿಗೆ support@odaflow.com ಗೆ ಇಮೇಲ್ ಮಾಡಿ.",
  "legalDeleteAccountStep3": "ನಿಮ್ಮ ಖಾತೆಯ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ದೃಢೀಕರಿಸಿ. ವಿನಂತಿಯನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸುವ ಮೊದಲು ಇದು ನಿಮ್ಮ ಸೈನ್ ಇನ್ ಮಾಡಿದ ಖಾತೆಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತದೆ ಎಂದು ನಾವು ಪರಿಶೀಲಿಸುತ್ತೇವೆ.",
  "legalDeleteAccountStep4": "ದೃಢೀಕರಣದ ನಂತರ, ನಿಮ್ಮ ಖಾತೆಯನ್ನು ತಕ್ಷಣವೇ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುತ್ತದೆ. ಕೆಳಗೆ ವಿವರಿಸಿದ ಕಾನೂನು ಧಾರಣ ಅಗತ್ಯತೆಗಳಿಗೆ ಒಳಪಟ್ಟು 30 ದಿನಗಳಲ್ಲಿ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ ಅಥವಾ ಅನಾಮಧೇಯಗೊಳಿಸಲಾಗುತ್ತದೆ.",
  "legalDeleteAccountStepsHeading": "ಖಾತೆಯನ್ನು ಅಳಿಸಲು ಹೇಗೆ ವಿನಂತಿಸುವುದು",
  "legalDeleteAccountTitle": "ನಿಮ್ಮ ಅಂಬ್ರೆಲಾ ಖಾತೆಯನ್ನು ಅಳಿಸಿ",
  "legalDisclaimerAINotLawyerBody": "ಅಂಬ್ರೆಲಾದ AI ವ್ಯವಸ್ಥೆಗಳು ಸಾಮಾನ್ಯ ಕಾನೂನು ಕಾರ್ಪೋರಾದಲ್ಲಿ ತರಬೇತಿ ಪಡೆದ ದೊಡ್ಡ ಭಾಷಾ ಮಾದರಿಗಳಾಗಿವೆ. ಅವರು ಅಭ್ಯಾಸ ಪ್ರಮಾಣಪತ್ರಗಳನ್ನು ಹೊಂದಿಲ್ಲ, ನ್ಯಾಯಾಲಯದಲ್ಲಿ ಹಾಜರಾಗಲು ಸಾಧ್ಯವಿಲ್ಲ, ಯಾವುದೇ ಬಾರ್ ಅಸೋಸಿಯೇಷನ್ ​​ಅಥವಾ ಕಾನೂನು ಸೊಸೈಟಿಯಿಂದ ನಿಯಂತ್ರಿಸಲ್ಪಡುವುದಿಲ್ಲ ಮತ್ತು ವಕೀಲರು ನಿಮಗೆ ಕಾಳಜಿಯ ಕರ್ತವ್ಯವನ್ನು ಹೊಂದಿರುವುದಿಲ್ಲ. AI ಔಟ್‌ಪುಟ್‌ಗಳು: ವಾಸ್ತವಿಕ ದೋಷಗಳು ಅಥವಾ ಭ್ರಮೆಗಳನ್ನು ಹೊಂದಿರಬಹುದು; ನಿಮ್ಮ ನಿರ್ದಿಷ್ಟ ಸಂಗತಿಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ವಸ್ತು ಪರಿಗಣನೆಗಳನ್ನು ಬಿಟ್ಟುಬಿಡಿ; ತಿದ್ದುಪಡಿ ಮಾಡಿದ, ರದ್ದುಪಡಿಸಿದ ಅಥವಾ ರದ್ದುಗೊಳಿಸಲಾದ ಕಾನೂನುಗಳು ಅಥವಾ ಪ್ರಕರಣಗಳನ್ನು ಉಲ್ಲೇಖಿಸಿ; ಇತ್ತೀಚಿನ ಶಾಸಕಾಂಗ ಬದಲಾವಣೆಗಳನ್ನು ಗಣನೆಗೆ ತೆಗೆದುಕೊಳ್ಳಲು ವಿಫಲವಾಗಿದೆ; ಮತ್ತು ಸಂಕೀರ್ಣ ಅಥವಾ ಅಸ್ಪಷ್ಟ ಕಾನೂನು ಪ್ರಶ್ನೆಗಳನ್ನು ತಪ್ಪಾಗಿ ಅರ್ಥೈಸಿಕೊಳ್ಳಿ. ನೀವು ಪ್ರತಿ AI ಔಟ್‌ಪುಟ್ ಅನ್ನು ವಿಚಾರಣೆಗೆ ಆರಂಭಿಕ ಹಂತವಾಗಿ ಪರಿಗಣಿಸಬೇಕು, ಅಂತಿಮ ಉತ್ತರವಲ್ಲ.",
  "legalDisclaimerAINotLawyerHeading": "3. AI ವಕೀಲರಲ್ಲ",
  "legalDisclaimerCitationBody": "ಅಂಬ್ರೆಲಾ ಕಾನೂನು, ನಿಯಂತ್ರಣ, ನಿಯಮ ಅಥವಾ ನ್ಯಾಯಾಂಗ ನಿರ್ಧಾರವನ್ನು ಉಲ್ಲೇಖಿಸಿದಾಗ, ನೀವು ಸ್ವತಂತ್ರವಾಗಿ ಪರಿಶೀಲಿಸಬೇಕು: (ಎ) ಉಲ್ಲೇಖಿಸಿದ ಮೂಲವು ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ; (ಬಿ) ಉಲ್ಲೇಖವು ನಿಖರವಾಗಿದೆ (ವಿಭಾಗ, ಉಪವಿಭಾಗ ಮತ್ತು ವರ್ಷ); (ಸಿ) ಮೂಲವು ಪ್ರಸ್ತುತ ಜಾರಿಯಲ್ಲಿದೆ ಮತ್ತು ಅದನ್ನು ತಿದ್ದುಪಡಿ ಮಾಡಲಾಗಿಲ್ಲ ಅಥವಾ ರದ್ದುಗೊಳಿಸಲಾಗಿಲ್ಲ; (ಡಿ) ಉಲ್ಲೇಖಿಸಿದ ಪಠ್ಯವು ಮೂಲವನ್ನು ನಿಖರವಾಗಿ ಪ್ರತಿಬಿಂಬಿಸುತ್ತದೆ. AI ಉಲ್ಲೇಖ ದೋಷಗಳು - ಫ್ಯಾಬ್ರಿಕೇಟೆಡ್ ಉಲ್ಲೇಖಗಳು ಸೇರಿದಂತೆ - ಎಲ್ಲಾ ಪ್ರಸ್ತುತ AI ವ್ಯವಸ್ಥೆಗಳ ತಿಳಿದಿರುವ ಮಿತಿಯಾಗಿದೆ. ಸ್ವತಂತ್ರ ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ ಕಾನೂನು ಪ್ರಕ್ರಿಯೆಗಳು, ಸಲಹೆಗಳು ಅಥವಾ ಫೈಲಿಂಗ್‌ಗಳಲ್ಲಿನ ಉಲ್ಲೇಖವನ್ನು ಎಂದಿಗೂ ಅವಲಂಬಿಸಬೇಡಿ.",
  "legalDisclaimerCitationHeading": "4. ಉಲ್ಲೇಖದ ನಿಖರತೆ",
  "legalDisclaimerJurisdictionBody": "ಭಾರತ: AI ವಿಶ್ಲೇಷಣೆಯು ಕೇಂದ್ರ ಶಾಸನ, ನಿರ್ದಿಷ್ಟಪಡಿಸಿದ ರಾಜ್ಯ ಕಾಯಿದೆಗಳು ಮತ್ತು ನ್ಯಾಯಾಂಗ ನಿರ್ಧಾರಗಳನ್ನು ಆಧರಿಸಿದೆ. ಇದು ಜಿಲ್ಲಾ ನ್ಯಾಯಾಲಯದ ಮಟ್ಟದ ಅಭ್ಯಾಸ, ಸ್ಥಳೀಯ ಬಾರ್ ಕಸ್ಟಮ್ಸ್ ಅಥವಾ ಕ್ರೋಡೀಕರಿಸದ ಕಾರ್ಯವಿಧಾನದ ನಿಯಮಗಳನ್ನು ಪರಿಗಣಿಸುವುದಿಲ್ಲ. ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್: AI ವಿಶ್ಲೇಷಣೆಯು ಫೆಡರಲ್ ಕಾನೂನು ಮತ್ತು ಆಯ್ದ ರಾಜ್ಯದ ಕಾನೂನನ್ನು ಆಧರಿಸಿದೆ. US ಕಾನೂನು ವಿಶ್ಲೇಷಣೆಯು ರಾಜ್ಯ-ನಿರ್ದಿಷ್ಟ ಪರವಾನಗಿ ಪಡೆದ ಸಲಹೆಗಾರರಿಗೆ ಬದಲಿಯಾಗಿಲ್ಲ. ಪರಿಶೀಲಿಸಿದ ವಕೀಲರ ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ ವಲಸೆ, ಕ್ರಿಮಿನಲ್ ರಕ್ಷಣೆ ಅಥವಾ ತೆರಿಗೆ ವಿಷಯಗಳಿಗೆ ಲಭ್ಯವಿಲ್ಲ. ಕೀನ್ಯಾ: ವಿಶ್ಲೇಷಣೆಯು ಕೀನ್ಯಾದ ಶಾಸನಗಳು, ಅಂಗಸಂಸ್ಥೆ ಶಾಸನಗಳು ಮತ್ತು ಪ್ರಕಟಿತ ಉಚ್ಚ ನ್ಯಾಯಾಲಯ ಮತ್ತು ಮೇಲ್ಮನವಿ ನ್ಯಾಯಾಲಯದ ನಿರ್ಧಾರಗಳನ್ನು ಸೆಳೆಯುತ್ತದೆ. ಇದು ಸಾಂಪ್ರದಾಯಿಕ ಕಾನೂನು, ಮ್ಯಾಜಿಸ್ಟ್ರೇಟ್ ನ್ಯಾಯಾಲಯದ ವ್ಯತ್ಯಾಸಗಳು ಅಥವಾ ಅಪ್ರಕಟಿತ ತೀರ್ಪುಗಳಿಗೆ ಕಾರಣವಾಗುವುದಿಲ್ಲ. ಯುನೈಟೆಡ್ ಕಿಂಗ್‌ಡಮ್: ವಿಶ್ಲೇಷಣೆಯು ಇಂಗ್ಲಿಷ್ ಮತ್ತು ವೆಲ್ಷ್ ಕಾನೂನನ್ನು ಒಳಗೊಂಡಿದೆ. ಸ್ಕಾಟ್ಸ್ ಕಾನೂನು, ಉತ್ತರ ಐರಿಶ್ ಕಾನೂನು, ಮತ್ತು ಹಂಚಿಕೆಯ ವಿಷಯಗಳು ಗಮನಾರ್ಹವಾಗಿ ಭಿನ್ನವಾಗಿರಬಹುದು; ನ್ಯಾಯವ್ಯಾಪ್ತಿ-ನಿರ್ದಿಷ್ಟ ಸಲಹೆಯನ್ನು ಪಡೆಯಿರಿ.",
  "legalDisclaimerJurisdictionHeading": "8. ನ್ಯಾಯವ್ಯಾಪ್ತಿಯ ಮಿತಿಗಳು",
  "legalDisclaimerLawyerReviewBody": "ಕೆಲವು ಅಂಬ್ರೆಲಾ ಔಟ್‌ಪುಟ್‌ಗಳು \"ಅಟಾರ್ನಿ ರಿವ್ಯೂಡ್\" ಬ್ಯಾಡ್ಜ್ ಅನ್ನು ಹೊಂದಿದ್ದು, ನಮ್ಮ ಮಾರುಕಟ್ಟೆ ಸ್ಥಳದಲ್ಲಿ ಪರವಾನಗಿ ಪಡೆದ ವಕೀಲರು ವಿಷಯವನ್ನು ಪರಿಶೀಲಿಸಿದ್ದಾರೆ ಮತ್ತು ಅನುಮೋದಿಸಿದ್ದಾರೆ ಎಂದು ಸೂಚಿಸುತ್ತದೆ. ಸಹ ಪರಿಶೀಲಿಸಿದ ಔಟ್‌ಪುಟ್‌ಗಳು: (ಎ) ಪರಿಶೀಲನೆಯ ಸಮಯದಲ್ಲಿ ವಕೀಲರ ಅಭಿಪ್ರಾಯವನ್ನು ಪ್ರತಿಬಿಂಬಿಸುತ್ತದೆ; (ಬಿ) ಸಹಿ ಮಾಡಿದ ಅಭಿಪ್ರಾಯ ಪತ್ರದ ಜೊತೆಗೆ ಔಪಚಾರಿಕ ಕಾನೂನು ಅಭಿಪ್ರಾಯವನ್ನು ರೂಪಿಸಬೇಡಿ; (ಸಿ) ಪ್ರತ್ಯೇಕ ಧಾರಕ ಒಪ್ಪಂದವನ್ನು ಕಾರ್ಯಗತಗೊಳಿಸದ ಹೊರತು ವಕೀಲ-ಕ್ಲೈಂಟ್ ಸಂಬಂಧವನ್ನು ರಚಿಸಬೇಡಿ; (ಡಿ) ಕಾನೂನು ಬದಲಾದಂತೆ ಹಳತಾಗಬಹುದು. ಪರಿಶೀಲಿಸುವ ವಕೀಲರು ಸ್ವತಂತ್ರ ಗುತ್ತಿಗೆದಾರರಾಗಿದ್ದಾರೆ; DVTech ವೆಂಚರ್ಸ್ ಯಾವುದೇ ಪರಿಶೀಲಿಸಿದ ಔಟ್‌ಪುಟ್‌ನ ಗುಣಮಟ್ಟ ಅಥವಾ ನಿಖರತೆಯನ್ನು ಖಾತರಿಪಡಿಸುವುದಿಲ್ಲ.",
  "legalDisclaimerLawyerReviewHeading": "7. ವಕೀಲರು-ಪರಿಶೀಲಿಸಿದ ಔಟ್‌ಪುಟ್‌ಗಳು",
  "legalDisclaimerNoPrivilegeBody": "ಅಂಬ್ರೆಲ್ಲಾದ AI ಯೊಂದಿಗಿನ ಸಂವಹನಗಳನ್ನು ಯಾವುದೇ ನ್ಯಾಯವ್ಯಾಪ್ತಿಯಲ್ಲಿ ವಕೀಲ-ಕ್ಲೈಂಟ್ ಸವಲತ್ತು ಅಥವಾ ಕಾನೂನು ವೃತ್ತಿಪರ ಸವಲತ್ತುಗಳಿಂದ ರಕ್ಷಿಸಲಾಗಿಲ್ಲ. ನೀವು ಸವಲತ್ತು ಅಡಿಯಲ್ಲಿ ರಕ್ಷಿಸಲು ಉದ್ದೇಶಿಸಿರುವ ವೇದಿಕೆಗೆ ಮಾಹಿತಿಯನ್ನು ಸಲ್ಲಿಸಬೇಡಿ. ಅಂಬ್ರೆಲ್ಲಾ ಮಾರುಕಟ್ಟೆಯ ಮೂಲಕ ನೀವು ಪರವಾನಗಿ ಪಡೆದ ವಕೀಲರನ್ನು ತೊಡಗಿಸಿಕೊಂಡರೆ, ಕಾರ್ಯಗತಗೊಳಿಸಿದ ಧಾರಕ ಒಪ್ಪಂದದ ಅಡಿಯಲ್ಲಿ ಆ ವಕೀಲರೊಂದಿಗಿನ ನಿಮ್ಮ ಸಂವಹನಗಳಿಗೆ ವಿಶೇಷ ಸೌಲಭ್ಯವನ್ನು ಲಗತ್ತಿಸಬಹುದು, ಆದರೆ ನಿಮ್ಮ ಹಿಂದಿನ AI ಸಂವಹನಗಳಿಗೆ ಅಲ್ಲ.",
  "legalDisclaimerNoPrivilegeHeading": "5. ವಕೀಲ-ಕ್ಲೈಂಟ್ ಸವಲತ್ತು ಇಲ್ಲ",
  "legalDisclaimerNotProvideAdvice": "ಖಾತರಿಪಡಿಸಿದ ಕಾನೂನು ಸಲಹೆ ಅಥವಾ ಕಾನೂನು ಫಲಿತಾಂಶಗಳನ್ನು ಊಹಿಸಲಾಗಿದೆ",
  "legalDisclaimerNotProvideHeading": "11. ನಾವು ಏನು ಒದಗಿಸುವುದಿಲ್ಲ",
  "legalDisclaimerNotProvidePrivilege": "AI ಸಂವಹನಗಳಿಗಾಗಿ ವಕೀಲ-ಕ್ಲೈಂಟ್ ಸವಲತ್ತು",
  "legalDisclaimerNotProvideProfessional": "AI-ಉತ್ಪಾದಿತ ಔಟ್‌ಪುಟ್‌ಗಳಿಗೆ ವೃತ್ತಿಪರ ಪರಿಹಾರ",
  "legalDisclaimerNotProvideRepresentation": "ನ್ಯಾಯಾಲಯಗಳು, ನ್ಯಾಯಮಂಡಳಿಗಳು ಅಥವಾ ನಿಯಂತ್ರಕ ಸಂಸ್ಥೆಗಳ ಮುಂದೆ ಪ್ರಾತಿನಿಧ್ಯ",
  "legalDisclaimerNotProvideSubstitute": "ನಿಮ್ಮ ಅಧಿಕಾರ ವ್ಯಾಪ್ತಿಯಲ್ಲಿ ಪರವಾನಗಿ ಪಡೆದ, ಅರ್ಹ ವಕೀಲರಿಗೆ ಬದಲಿ",
  "legalDisclaimerPageDescription": "ಅಂಬ್ರೆಲ್ಲಾದ AI-ರಚಿಸಿದ ಕಾನೂನು ಮಾಹಿತಿ, ಅದರ ಮಿತಿಗಳು ಮತ್ತು ಬಳಕೆದಾರರ ಜವಾಬ್ದಾರಿಗಳ ಕುರಿತು ಪ್ರಮುಖ ಸೂಚನೆಗಳು. ಈ ಹಕ್ಕು ನಿರಾಕರಣೆಯು Umbrella ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಮೂಲಕ DVTech ವೆಂಚರ್ಸ್ ನೀಡುವ ಎಲ್ಲಾ ಉತ್ಪನ್ನಗಳು ಮತ್ತು ವೈಶಿಷ್ಟ್ಯಗಳಿಗೆ ಅನ್ವಯಿಸುತ್ತದೆ.",
  "legalDisclaimerPageTitle": "ಕಾನೂನು ಹಕ್ಕು ನಿರಾಕರಣೆ",
  "legalDisclaimerRegulatoryBody": "DVTech ವೆಂಚರ್ಸ್ ಒಂದು ತಂತ್ರಜ್ಞಾನ ಕಂಪನಿಯಾಗಿದೆ, ನಿಯಂತ್ರಿತ ಕಾನೂನು ಸೇವೆ ಒದಗಿಸುವವರಲ್ಲ. ಕಾನೂನು ಸೇವೆಗಳನ್ನು ಒದಗಿಸಲು ಸಾಲಿಸಿಟರ್ಸ್ ರೆಗ್ಯುಲೇಶನ್ ಅಥಾರಿಟಿ (UK), ಬಾರ್ ಕೌನ್ಸಿಲ್ ಆಫ್ ಇಂಡಿಯಾ, ಲಾ ಸೊಸೈಟಿ ಆಫ್ ಕೀನ್ಯಾ, ಯಾವುದೇ US ಸ್ಟೇಟ್ ಬಾರ್ ಅಥವಾ ಯಾವುದೇ ಇತರ ಕಾನೂನು ನಿಯಂತ್ರಣ ಸಂಸ್ಥೆಯಿಂದ ನಮಗೆ ಅಧಿಕಾರವಿಲ್ಲ. ಅಂಬ್ರೆಲಾ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಕಾನೂನು ಸೇವೆಗಳ ಕಾಯಿದೆ 2007 (ಯುಕೆ) ಅಥವಾ ಇತರ ನ್ಯಾಯವ್ಯಾಪ್ತಿಗಳಲ್ಲಿ ಸಮಾನವಾದ ಶಾಸನದಲ್ಲಿ ವ್ಯಾಖ್ಯಾನಿಸಲಾದ ನಿಯಂತ್ರಿತ ಕಾನೂನು ಚಟುವಟಿಕೆಯನ್ನು ಒದಗಿಸುವುದಿಲ್ಲ.",
  "legalDisclaimerRegulatoryHeading": "9. ನಿಯಂತ್ರಕ ಸ್ಥಿತಿ",
  "legalDisclaimerRelianceBody": "ನೀವು ಇದನ್ನು ಅಂಗೀಕರಿಸುತ್ತೀರಿ: (a) ನಿಮ್ಮ ಕಾನೂನು ಹಕ್ಕುಗಳು ಅಥವಾ ಕಟ್ಟುಪಾಡುಗಳ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವ ನಿರ್ಧಾರಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು ನೀವು AI ಔಟ್‌ಪುಟ್‌ಗಳನ್ನು ಮಾತ್ರ ಅವಲಂಬಿಸುವುದಿಲ್ಲ; (ಬಿ) ಕಾನೂನು ಪ್ರಕ್ರಿಯೆಗಳನ್ನು ಪ್ರಾರಂಭಿಸುವ, ಸಮರ್ಥಿಸುವ ಅಥವಾ ಇತ್ಯರ್ಥಗೊಳಿಸುವ ಮೊದಲು ನೀವು ಸ್ವತಂತ್ರ ಅರ್ಹ ಕಾನೂನು ಸಲಹೆಯನ್ನು ಪಡೆಯುತ್ತೀರಿ; (ಸಿ) ಸ್ವತಂತ್ರ ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ AI ಔಟ್‌ಪುಟ್‌ಗಳ ಮೇಲೆ ನಿಮ್ಮ ಅವಲಂಬನೆಯಿಂದ ಉಂಟಾಗುವ ಯಾವುದೇ ಹಾನಿಗೆ DVTech ವೆಂಚರ್ಸ್ ಜವಾಬ್ದಾರನಾಗಿರುವುದಿಲ್ಲ. ಈ ಮಿತಿಯು ಅನ್ವಯವಾಗುವ ಕಾನೂನಿನಿಂದ ಅನುಮತಿಸಲಾದ ಪೂರ್ಣ ಪ್ರಮಾಣದಲ್ಲಿ ಅನ್ವಯಿಸುತ್ತದೆ.",
  "legalDisclaimerRelianceHeading": "6. ಅವಲಂಬನೆಯ ಮೇಲಿನ ಮಿತಿ",
  "legalDisclaimerScopeBody": "ಈ ಹಕ್ಕು ನಿರಾಕರಣೆ ಅಂಬ್ರೆಲಾ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ನ ಪ್ರತಿಯೊಂದು ವೈಶಿಷ್ಟ್ಯಕ್ಕೂ ಅನ್ವಯಿಸುತ್ತದೆ, ಆದರೆ ಇವುಗಳಿಗೆ ಸೀಮಿತವಾಗಿಲ್ಲ: ಕಾನೂನು ಸಮಸ್ಯೆ ಪರೀಕ್ಷಕ, AI ಕಾಪಿಲಟ್, ಡಾಕ್ಯುಮೆಂಟ್ ವಿಮರ್ಶೆ, ಕಾನೂನು ಸಂಶೋಧನೆ, ವಿಷಯ ವಿಶ್ಲೇಷಣೆ, ತಂತ್ರದ ಮೆಮೊಗಳು, ಕರಡು ದಾಖಲೆಗಳು ಮತ್ತು ಯಾವುದೇ ಇತರ AI- ರಚಿತವಾದ ವಿಷಯ. ಇದು ಎಲ್ಲಾ ಬಳಕೆದಾರರಿಗೆ ಅನ್ವಯಿಸುತ್ತದೆ - ಗ್ರಾಹಕರು, ವಕೀಲರು ಬಳಕೆದಾರರು ಮತ್ತು ಕಾನೂನು ಸಂಸ್ಥೆಯ ಬಾಡಿಗೆದಾರರು - ಅಂಬ್ರೆಲಾ ಕಾರ್ಯನಿರ್ವಹಿಸುವ ಎಲ್ಲಾ ನ್ಯಾಯವ್ಯಾಪ್ತಿಯಲ್ಲಿ (ಭಾರತ, ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್, ಕೀನ್ಯಾ ಮತ್ತು ಯುನೈಟೆಡ್ ಕಿಂಗ್‌ಡಮ್).",
  "legalDisclaimerScopeHeading": "1. ಈ ಹಕ್ಕು ನಿರಾಕರಣೆ ವ್ಯಾಪ್ತಿ",
  "legalDisclaimerUniversalBody": "ಅಂಬ್ರೆಲಾ ಕಾನೂನು ಮಾಹಿತಿ, ದಾಖಲೆ ವಿವರಣೆ, ಸಮಸ್ಯೆ ಗುರುತಿಸುವಿಕೆ ಮತ್ತು ಅಪಾಯದ ವಿಶ್ಲೇಷಣೆಯನ್ನು ಒದಗಿಸುತ್ತದೆ. ಇದು ಕಾನೂನು ಸಂಸ್ಥೆಯಲ್ಲ ಮತ್ತು ಪರವಾನಗಿ ಪಡೆದ ವಕೀಲರನ್ನು ಬದಲಿಸುವುದಿಲ್ಲ. ನಿಮ್ಮ ಪರಿಸ್ಥಿತಿಗೆ ನಿರ್ದಿಷ್ಟವಾದ ಕಾನೂನು ಸಲಹೆಗಾಗಿ, ನಿಮ್ಮ ಅಧಿಕಾರ ವ್ಯಾಪ್ತಿಯಲ್ಲಿ ಅರ್ಹ ವಕೀಲರನ್ನು ಸಂಪರ್ಕಿಸಿ. AI- ರಚಿತವಾದ ವಿಷಯವನ್ನು ಮಾಹಿತಿ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಮಾತ್ರ ಒದಗಿಸಲಾಗಿದೆ ಮತ್ತು ಕಾನೂನು ಸಲಹೆ, ಕಾನೂನು ಪ್ರಾತಿನಿಧ್ಯ ಅಥವಾ ನಿಮ್ಮ ಮತ್ತು DVTech ವೆಂಚರ್ಸ್ ನಡುವೆ ವಕೀಲ-ಕ್ಲೈಂಟ್ ಸಂಬಂಧದ ರಚನೆಯನ್ನು ರೂಪಿಸುವುದಿಲ್ಲ.",
  "legalDisclaimerUniversalHeading": "2. ಸಾರ್ವತ್ರಿಕ ಹಕ್ಕು ನಿರಾಕರಣೆ",
  "legalDisclaimerUserResponsibilitiesBody": "ವೇದಿಕೆಯನ್ನು ಬಳಸುವ ಮೂಲಕ ನೀವು ಜವಾಬ್ದಾರಿಯನ್ನು ಸ್ವೀಕರಿಸುತ್ತೀರಿ: (a) ನಿಮ್ಮ ನಿರ್ದಿಷ್ಟ ಸನ್ನಿವೇಶಕ್ಕೆ AI ಔಟ್‌ಪುಟ್‌ಗಳ ನಿಖರತೆ ಮತ್ತು ಅನ್ವಯಿಸುವಿಕೆಯನ್ನು ಮೌಲ್ಯಮಾಪನ ಮಾಡುವುದು; (ಬಿ) ಸೂಕ್ತವಾದಲ್ಲಿ ಸ್ವತಂತ್ರ ಕಾನೂನು ಸಲಹೆಯನ್ನು ಪಡೆಯುವುದು; (ಸಿ) AI ಔಟ್‌ಪುಟ್‌ಗಳ ನಿಮ್ಮ ಬಳಕೆಯು ನಿಮ್ಮ ವೃತ್ತಿಪರ ಕಟ್ಟುಪಾಡುಗಳಿಗೆ (ವಕೀಲ ಬಳಕೆದಾರರು) ಅನುಸರಿಸುತ್ತದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳುವುದು; (ಡಿ) ಅನುಮತಿಯಿಲ್ಲದೆ ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಗೌಪ್ಯ ಮಾಹಿತಿಯನ್ನು ಸಲ್ಲಿಸದಿರುವುದು; (ಇ) ನಿಮ್ಮ ಖಾತೆಯ ರುಜುವಾತುಗಳನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸುವುದು.",
  "legalDisclaimerUserResponsibilitiesHeading": "10. ಬಳಕೆದಾರರ ಜವಾಬ್ದಾರಿಗಳು",
