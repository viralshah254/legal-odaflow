  "tutorialsMeetingsHelpB3": "ಕ್ಲೈಂಟ್ ಫೈಲ್‌ಗಳು ಅಥವಾ ನ್ಯಾಯಾಲಯದ ಸಲ್ಲಿಕೆಗಳಿಗಾಗಿ ಟಿಪ್ಪಣಿಗಳನ್ನು ರಫ್ತು ಮಾಡಿ.",
  "tutorialsMeetingsHelpTitle": "ಸಭೆಗಳು",
  "tutorialsMeetingsListBody": "ರೆಕಾರ್ಡಿಂಗ್‌ಗಳು, ಪ್ರತಿಲೇಖನಗಳು ಮತ್ತು AI ಸಾರಾಂಶಗಳನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ. ಟಿಪ್ಪಣಿಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಯಾವುದೇ ಸಭೆಯನ್ನು ತೆರೆಯಿರಿ.",
  "tutorialsMeetingsListTitle": "ಸಭೆಯ ಗ್ರಂಥಾಲಯ",
  "tutorialsMeetingsRecordBody": "ಕ್ಲೈಂಟ್ ಸಭೆಗಳು, ಠೇವಣಿಗಳು ಅಥವಾ ಕರೆಗಳನ್ನು ಸೆರೆಹಿಡಿಯಿರಿ. ಪ್ರತಿಲಿಪಿಗಳು ವಿಷಯಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡುತ್ತವೆ.",
  "tutorialsMeetingsRecordTitle": "ರೆಕಾರ್ಡ್ ಮಾಡಿ ಅಥವಾ ಆಮದು ಮಾಡಿಕೊಳ್ಳಿ",
  "tutorialsMonitorsCreateBody": "ನ್ಯಾಯವ್ಯಾಪ್ತಿ ಮತ್ತು ವಿಷಯದ ಮೂಲಕ ನಿಯಂತ್ರಕ ಬದಲಾವಣೆಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ. ಕಾನೂನುಗಳನ್ನು ನವೀಕರಿಸಿದಾಗ ಅಂಬ್ರೆಲಾ ಎಚ್ಚರಿಕೆಗಳನ್ನು ಸಾರಾಂಶಗೊಳಿಸುತ್ತದೆ.",
  "tutorialsMonitorsCreateTitle": "ಮಾನಿಟರ್ ರಚಿಸಿ",
  "tutorialsMonitorsHelpB1": "ನಿಮ್ಮ ಪ್ರಾಥಮಿಕ ನ್ಯಾಯವ್ಯಾಪ್ತಿ ಮತ್ತು ಉನ್ನತ ಅಭ್ಯಾಸ ಕ್ಷೇತ್ರಗಳೊಂದಿಗೆ ಪ್ರಾರಂಭಿಸಿ.",
  "tutorialsMonitorsHelpB2": "ನಿರ್ಣಾಯಕ ಎಚ್ಚರಿಕೆಗಳು ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ ಮತ್ತು ಅಧಿಸೂಚನೆಗಳಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳಬಹುದು.",
  "tutorialsMonitorsHelpB3": "ನಿಯಂತ್ರಕ ಬದಲಾವಣೆಯು ತೆರೆದ ವಿಷಯಗಳ ಮೇಲೆ ಹೇಗೆ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ ಎಂಬುದನ್ನು ವಿವರಿಸಲು Copilot ಅನ್ನು ಕೇಳಿ.",
  "tutorialsMonitorsHelpTitle": "ನಿಯಂತ್ರಕ ಮಾನಿಟರ್‌ಗಳು",
  "tutorialsMonitorsListBody": "ಮಾನಿಟರ್‌ಗಳನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡಿ, ಎಚ್ಚರಿಕೆಯ ಇತಿಹಾಸಕ್ಕಾಗಿ ವಿವರಗಳನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು ನಿಮ್ಮ ಅಭ್ಯಾಸವು ವಿಕಸನಗೊಂಡಂತೆ ವಿಷಯಗಳನ್ನು ಹೊಂದಿಸಿ.",
  "tutorialsMonitorsListTitle": "ನಿಮ್ಮ ಮಾನಿಟರ್‌ಗಳು",
  "tutorialsOnboardingHelpB1": "ಪಾಲುದಾರರನ್ನು ಆಹ್ವಾನಿಸುವ ಮೊದಲು ಪಾಲುದಾರರು ಎಲ್ಲಾ ಹಂತಗಳನ್ನು ಪೂರ್ಣಗೊಳಿಸಬೇಕು.",
  "tutorialsOnboardingHelpB2": "ನೀವು ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಇಲ್ಲಿಗೆ ಹಿಂತಿರುಗಬಹುದು.",
  "tutorialsOnboardingHelpTitle": "ಆನ್ಬೋರ್ಡಿಂಗ್",
  "tutorialsOnboardingWizardBody": "ನಿಮ್ಮ ಕಾರ್ಯಸ್ಥಳವನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಪ್ರೊಫೈಲ್, ಬಿಲ್ಲಿಂಗ್, ತಂಡದ ಆಹ್ವಾನಗಳು ಮತ್ತು AI ನೀತಿಯ ಹಂತಗಳನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.",
  "tutorialsOnboardingWizardTitle": "ಸಂಸ್ಥೆಯ ಸೆಟಪ್",
  "tutorialsPreBillHelpB1": "ಅಂತಿಮ ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ರಚಿಸುವ ಮೊದಲು ಪೂರ್ವ-ಬಿಲ್‌ಗಳನ್ನು ಅನುಮೋದಿಸಿ.",
  "tutorialsPreBillHelpB2": "ಪಾಲುದಾರರ ಪರಿಶೀಲನೆಯ ಅಗತ್ಯವಿರುವ ನಮೂದುಗಳನ್ನು ಫ್ಲ್ಯಾಗ್ ಮಾಡಿ.",
  "tutorialsPreBillHelpTitle": "ಪೂರ್ವ-ಬಿಲ್",
  "tutorialsPreBillWorkspaceBody": "ಇನ್‌ವಾಯ್ಸ್ ಮಾಡುವ ಮೊದಲು ಸಮಯ ನಮೂದುಗಳು ಮತ್ತು ವೆಚ್ಚಗಳನ್ನು ಪರಿಶೀಲಿಸಿ. ನಿರೂಪಣೆಗಳು, ಬರೆಯುವಿಕೆಗಳು ಮತ್ತು ವಿಭಜನೆಗಳನ್ನು ಇಲ್ಲಿ ಸಂಪಾದಿಸಿ.",
  "tutorialsPreBillWorkspaceTitle": "ಪೂರ್ವ-ಬಿಲ್ ಪರಿಶೀಲನೆ",
  "tutorialsProfileFormBody": "ಹೆಸರು, ಸಂಪರ್ಕ ವಿವರಗಳು, ಅಧಿಸೂಚನೆ ಪ್ರಾಶಸ್ತ್ಯಗಳು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನವೀಕರಿಸಿ.",
  "tutorialsProfileFormTitle": "ನಿಮ್ಮ ಪ್ರೊಫೈಲ್",
  "tutorialsProfileHelpB1": "ತುರ್ತು ಗಡುವಿನ ಎಚ್ಚರಿಕೆಗಳಿಗಾಗಿ ಫೋನ್ ಅನ್ನು ಪ್ರಸ್ತುತವಾಗಿ ಇರಿಸಿ.",
  "tutorialsProfileHelpB2": "ಪಾತ್ರ ಮತ್ತು ಅನುಮತಿಗಳನ್ನು ಸಂಸ್ಥೆಯ ನಿರ್ವಾಹಕರು ನಿರ್ವಹಿಸುತ್ತಾರೆ.",
  "tutorialsProfileHelpTitle": "ಪ್ರೊಫೈಲ್",
  "tutorialsQueuesGridBody": "ಇನ್‌ಟೇಕ್, ಬಿಲ್ಲಿಂಗ್ ಮತ್ತು ಟಾಸ್ಕ್ ಕ್ಯೂಗಳು ಸಂಸ್ಥೆಯಾದ್ಯಂತ ಏನು ಕ್ರಮದ ಅಗತ್ಯವಿದೆ ಎಂಬುದನ್ನು ತೋರಿಸುತ್ತವೆ-ಐಟಂಗಳನ್ನು ಪರಿಹರಿಸಲು ಕ್ಲಿಕ್ ಮಾಡಿ.",
  "tutorialsQueuesGridTitle": "ಕೆಲಸದ ಸಾಲುಗಳು",
  "tutorialsQueuesHelpB1": "ಸೆಟಪ್‌ಗಾಗಿ ಕಾಯುತ್ತಿರುವ ಹೊಸ ವಿಷಯಗಳಿಗಾಗಿ ಪ್ರತಿದಿನ ಸೇವನೆಯ ಸರದಿಯನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsQueuesHelpB2": "ಹಣಕಾಸು ಪಾತ್ರಗಳು ಇಲ್ಲಿ ಬಿಲ್ಲಿಂಗ್ ಅನುಮೋದನೆ ಕ್ಯೂಗಳನ್ನು ನೋಡುತ್ತವೆ.",
  "tutorialsQueuesHelpTitle": "ಸಾಲುಗಳು",
  "tutorialsReferralsHelpB1": "ಬಾಕಿ ಉಳಿದಿರುವ ಮತ್ತು ಪೂರ್ಣಗೊಂಡ ರೆಫರಲ್‌ಗಳನ್ನು ಇಲ್ಲಿ ಟ್ರ್ಯಾಕ್ ಮಾಡಿ.",
  "tutorialsReferralsHelpB2": "ರೆಫರಲ್ ಕ್ರೆಡಿಟ್‌ಗಳು AI ಬಳಕೆಗೆ ಅನ್ವಯಿಸುತ್ತವೆ.",
  "tutorialsReferralsHelpTitle": "ಉಲ್ಲೇಖಗಳು",
  "tutorialsReferralsShareBody": "ನಿಮ್ಮ ಉಲ್ಲೇಖಿತ ಲಿಂಕ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಿ. ಹೊಸ ಸಂಸ್ಥೆಗಳು ಅಥವಾ ಗ್ರಾಹಕರು ಸೈನ್ ಅಪ್ ಮಾಡಿದಾಗ ಮತ್ತು ಚಂದಾದಾರರಾದಾಗ ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ಗಳಿಸಿ.",
  "tutorialsReferralsShareTitle": "ಸಹೋದ್ಯೋಗಿಗಳನ್ನು ಉಲ್ಲೇಖಿಸಿ",
  "tutorialsReportsHeaderBody": "ಉದ್ಯಮದ ಮಾನದಂಡಗಳಿಗೆ ಹೋಲಿಸಿದರೆ ಬಳಕೆ, ಸಾಕ್ಷಾತ್ಕಾರ, ಸಂಗ್ರಹಣೆಗಳು ಮತ್ತು ಪೈಪ್‌ಲೈನ್ ಮೆಟ್ರಿಕ್‌ಗಳು.",
  "tutorialsReportsHeaderTitle": "ಸಂಸ್ಥೆಯ ವಿಶ್ಲೇಷಣೆ",
  "tutorialsReportsHelpB1": "ಪಾಲುದಾರ ಸಭೆಗಳಿಗೆ ಸಾರಾಂಶಗಳನ್ನು ರಫ್ತು ಮಾಡಿ.",
  "tutorialsReportsHelpB2": "ನೀವು ಸಾಕಷ್ಟು ಮುಚ್ಚಿದ ವಿಷಯಗಳನ್ನು ಹೊಂದಿರುವಾಗ ಫಲಿತಾಂಶದ ಮಾನದಂಡಗಳನ್ನು ಹೋಲಿಕೆ ಮಾಡಿ.",
  "tutorialsReportsHelpB3": "ವೃತ್ತಿಪರ ಯೋಜನೆ ಅಥವಾ ಹೆಚ್ಚಿನದು ಅಗತ್ಯವಿದೆ.",
  "tutorialsReportsHelpTitle": "ವರದಿಗಳು",
  "tutorialsReportsKpisBody": "ಹಸಿರು ಸೂಚಕಗಳು ಗುರಿಗಳನ್ನು ಸೋಲಿಸುತ್ತವೆ. ಕೆಳಗಿನ ಲಿಂಕ್ ಮಾಡಲಾದ ಕಾರ್ಡ್‌ಗಳಿಂದ ಹಣಕಾಸು ಅಥವಾ ವಿಷಯಗಳ ಕುರಿತು ಕೊರೆಯಿರಿ.",
  "tutorialsReportsKpisTitle": "ಕಾರ್ಯಕ್ಷಮತೆ KPI ಗಳು",
  "tutorialsResearchHelpB1": "ನಿಖರತೆ ಮುಖ್ಯವಾದಾಗ ಪರಿಶೀಲಿಸಿದ ಮೋಡ್ ಅನ್ನು ಬಳಸಿ; ತ್ವರಿತ ದೃಷ್ಟಿಕೋನಕ್ಕಾಗಿ ವೇಗದ ಮೋಡ್.",
  "tutorialsResearchHelpB2": "ಸಂಶೋಧನೆಯು ನಿಮ್ಮ ಸಂಸ್ಥೆಯ AI ಕ್ರೆಡಿಟ್ ಬ್ಯಾಲೆನ್ಸ್ ಅನ್ನು ಬಳಸುತ್ತದೆ.",
  "tutorialsResearchHelpB3": "ಕ್ಲೈಂಟ್‌ಗಳನ್ನು ಸಲ್ಲಿಸುವ ಅಥವಾ ಸಲಹೆ ನೀಡುವ ಮೊದಲು ಯಾವಾಗಲೂ ಉಲ್ಲೇಖಗಳನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsResearchHelpTitle": "ಕಾನೂನು ಸಂಶೋಧನೆ",
  "tutorialsResearchQueryBody": "ಕಾನೂನು ಸಮಸ್ಯೆ ಮತ್ತು ಅಧಿಕಾರ ವ್ಯಾಪ್ತಿಯನ್ನು ವಿವರಿಸಿ. ಸತ್ಯಗಳ ಬಗ್ಗೆ ನಿರ್ದಿಷ್ಟವಾಗಿರಿ - ಉತ್ತಮ ಒಳಹರಿವು ಉತ್ತಮ ಉಲ್ಲೇಖಗಳನ್ನು ಉತ್ಪಾದಿಸುತ್ತದೆ.",
  "tutorialsResearchQueryTitle": "ನಿಮ್ಮ ಸಂಶೋಧನಾ ಪ್ರಶ್ನೆಯನ್ನು ಕೇಳಿ",
  "tutorialsResearchResultsBody": "ನೀವು ಸಂಶೋಧನೆಯನ್ನು ನಡೆಸಿದ ನಂತರ, ಇಲ್ಲಿ ಉಲ್ಲೇಖಗಳನ್ನು ಪರಿಶೀಲಿಸಿ. ವಿಷಯಕ್ಕೆ ಉಳಿಸಿ ಅಥವಾ ಡ್ರಾಫ್ಟ್‌ಗಳಿಗೆ ರಫ್ತು ಮಾಡಿ.",
  "tutorialsResearchResultsTitle": "ಉಲ್ಲೇಖಿಸಿದ ಉತ್ತರಗಳನ್ನು ಪರಿಶೀಲಿಸಿ",
  "tutorialsResearchSourcesBody": "ಸೇರಿಸಲು ಶಾಸನಗಳು, ಕೇಸ್ ಕಾನೂನು ಮತ್ತು ಫರ್ಮ್ ವಾಲ್ಟ್ ಮೂಲಗಳನ್ನು ಆರಿಸಿ. ವೇಗವಾದ, ಹೆಚ್ಚು ಕೇಂದ್ರೀಕೃತ ಉತ್ತರಗಳಿಗಾಗಿ ಕಿರಿದಾದ ಮೂಲಗಳು.",
  "tutorialsResearchSourcesTitle": "ಜ್ಞಾನದ ಮೂಲಗಳನ್ನು ಆರಿಸಿ",
  "tutorialsSavedDraftsHelpB1": "ಡ್ರಾಫ್ಟ್‌ಗಳು ಹಿಡುವಳಿದಾರ-ವ್ಯಾಪ್ತಿಯ ಮತ್ತು ಆಡಿಟ್ ಮಾಡಬಹುದಾಗಿದೆ.",
  "tutorialsSavedDraftsHelpB2": "ಸಂಪಾದನೆ ಅಥವಾ ರಫ್ತು ಮುಂದುವರಿಸಲು ಡ್ರಾಫ್ಟ್ ತೆರೆಯಿರಿ.",
  "tutorialsSavedDraftsHelpTitle": "ಡ್ರಾಫ್ಟ್‌ಗಳನ್ನು ಉಳಿಸಲಾಗಿದೆ",
  "tutorialsSavedDraftsListBody": "ಕಾನೂನು ರೂಪಗಳು, ಭಾರತ/ಯುಎಸ್ ಡ್ರಾಫ್ಟಿಂಗ್ ಅಥವಾ ಕಾಪಿಲೋಟ್‌ನಿಂದ ಯಾವುದೇ ಉಳಿಸಿದ AI ಡ್ರಾಫ್ಟ್ ಅನ್ನು ಪುನರಾರಂಭಿಸಿ.",
  "tutorialsSavedDraftsListTitle": "ಕರಡು ಇತಿಹಾಸ",
  "tutorialsSectionFinderHelpB1": "ಉಲ್ಲೇಖಿಸುವ ಮೊದಲು ಅಧಿಕೃತ ಬೇರ್ ಆಕ್ಟ್‌ಗಳ ವಿರುದ್ಧ ಫಲಿತಾಂಶಗಳನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsSectionFinderHelpB2": "ಲುಕಪ್ ಫಲಿತಾಂಶಗಳನ್ನು ಮ್ಯಾಟರ್ ಡ್ರಾಫ್ಟ್‌ಗಳಿಗೆ ರಫ್ತು ಮಾಡಿ.",
  "tutorialsSectionFinderHelpTitle": "ವಿಭಾಗ ಶೋಧಕ",
  "tutorialsSectionFinderWorkspaceBody": "IPC→BNS, CrPC→BNSS ಕ್ರಾಸ್‌ವಾಕ್‌ಗಳು ಅಥವಾ US ಕೋಡ್ ವಿಭಾಗಗಳನ್ನು ಹುಡುಕಿ. ಜನಪ್ರಿಯ ಪ್ರಶ್ನೆಗಳು ತ್ವರಿತವಾಗಿ ಪ್ರಾರಂಭಿಸಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತವೆ.",
  "tutorialsSectionFinderWorkspaceTitle": "ವಿಭಾಗಗಳನ್ನು ಹುಡುಕಿ",
  "tutorialsSettingsHelpB1": "ಪಾಲುದಾರ ನಿರ್ವಾಹಕರು ಮಾತ್ರ ಫರ್ಮ್-ವೈಡ್ ಆಡಳಿತವನ್ನು ಬದಲಾಯಿಸಬಹುದು.",
  "tutorialsSettingsHelpB2": "ತರಬೇತಿ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವ ಮೊದಲು AI ನೀತಿ ಮತ್ತು ಡೇಟಾ ಸಮ್ಮತಿಯನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsSettingsHelpTitle": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು",
  "tutorialsSettingsHubBody": "ಈ ಹಬ್‌ನಿಂದ ಬಳಕೆದಾರರು, ಬಿಲ್ಲಿಂಗ್, AI ನೀತಿ, ಏಕೀಕರಣಗಳು ಮತ್ತು ಅನುಸರಣೆಯನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿ.",
  "tutorialsSettingsHubTitle": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು",
  "tutorialsShellCommandPaletteBody": "ಯಾವುದೇ ಪುಟಕ್ಕೆ ಹೋಗಲು ⌘K (ಅಥವಾ Ctrl+K) ಒತ್ತಿರಿ, Copilot ತೆರೆಯಿರಿ ಅಥವಾ ವಿಷಯವನ್ನು ರಚಿಸುವಂತಹ ಸಾಮಾನ್ಯ ಕ್ರಿಯೆಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿ.",
  "tutorialsShellCommandPaletteTitle": "ಕಮಾಂಡ್ ಪ್ಯಾಲೆಟ್",
  "tutorialsShellCopilotBody": "ನಿಮ್ಮ ಪ್ರಸ್ತುತ ಪುಟ ಅಥವಾ ವಿಷಯದ ಸಂದರ್ಭದಲ್ಲಿ ಕಾಪಿಲಟ್ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಿ. ಮೇಲಿನ ಬಾರ್‌ನಲ್ಲಿರುವ ಸ್ಪಾರ್ಕಲ್ ಬಟನ್ ಅಥವಾ ಈ ಫ್ಲೋಟಿಂಗ್ ಬಟನ್ ಅನ್ನು ಬಳಸಿ.",
  "tutorialsShellCopilotTitle": "AI ಕಾಪಿಲಟ್",
  "tutorialsShellHelpB1": "ಮುಖ್ಯ ಕೆಲಸದ ಹರಿವುಗಳಿಗಾಗಿ ಸೈಡ್‌ಬಾರ್ ಅನ್ನು ಮತ್ತು ತ್ವರಿತ ಜಿಗಿತಗಳಿಗಾಗಿ ⌘K ಬಳಸಿ.",
  "tutorialsShellHelpB2": "ಕಾಪಿಲಟ್ ನೀವು ಇರುವ ಪುಟವನ್ನು ಅರ್ಥಮಾಡಿಕೊಂಡಿದ್ದಾರೆ - ನಿಮಗೆ ಮಾರ್ಗದರ್ಶನದ ಅಗತ್ಯವಿರುವಾಗ ಅದನ್ನು ತೆರೆಯಿರಿ.",
  "tutorialsShellHelpB3": "ಮೇಲಿನ ಪಟ್ಟಿಯಲ್ಲಿರುವ ಸಹಾಯ ಮೆನುವಿನಿಂದ ಈ ಪ್ರವಾಸವನ್ನು ಮರುಪ್ಲೇ ಮಾಡಿ.",
  "tutorialsShellHelpTitle": "ತಿರುಗಾಡುತ್ತಿದ್ದಾರೆ",
  "tutorialsShellNotificationsBody": "ತುರ್ತು ಗಡುವುಗಳು, KYC ಐಟಂಗಳು, ಬಿಲ್ಲಿಂಗ್ ಎಚ್ಚರಿಕೆಗಳು ಮತ್ತು ಸಿಸ್ಟಮ್ ಸಂದೇಶಗಳು ಇಲ್ಲಿ ಗೋಚರಿಸುತ್ತವೆ.",
  "tutorialsShellNotificationsTitle": "ಅಧಿಸೂಚನೆಗಳು ಮತ್ತು ಎಚ್ಚರಿಕೆಗಳು",
  "tutorialsShellProfileBody": "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಲು, ನಿಮ್ಮ ಪಾತ್ರವನ್ನು ವೀಕ್ಷಿಸಲು ಮತ್ತು ಸೈನ್ ಔಟ್ ಮಾಡಲು ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಮೆನು ತೆರೆಯಿರಿ.",
  "tutorialsShellProfileTitle": "ನಿಮ್ಮ ಖಾತೆ",
  "tutorialsShellSearchBody": "ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ ಎಲ್ಲಿಂದಲಾದರೂ ಕ್ಲೈಂಟ್‌ಗಳು, ವಿಷಯಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಕಾರ್ಯಗಳನ್ನು ಹುಡುಕಿ.",
  "tutorialsShellSearchTitle": "ಜಾಗತಿಕ ಹುಡುಕಾಟ",
  "tutorialsShellSidebarBody": "ಕ್ಲೈಂಟ್‌ಗಳು, ವಿಷಯಗಳು, ಬಿಲ್ಲಿಂಗ್, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನವುಗಳ ನಡುವೆ ಚಲಿಸಲು ಸೈಡ್‌ಬಾರ್ ಅನ್ನು ಬಳಸಿ. ನ್ಯಾವಿಗೇಷನ್ ಅನ್ನು ಅಚ್ಚುಕಟ್ಟಾಗಿ ಇರಿಸಿಕೊಳ್ಳಲು ವಿಭಾಗಗಳು ಕುಸಿಯುತ್ತವೆ.",
  "tutorialsShellSidebarTitle": "ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಕಾರ್ಯಕ್ಷೇತ್ರ",
  "tutorialsTasksCreateBody": "ಡೆಡ್‌ಲೈನ್‌ಗಳನ್ನು ಸೇರಿಸಿ, ಮಾಲೀಕರನ್ನು ನಿಯೋಜಿಸಿ ಮತ್ತು ವಿಷಯಗಳಿಗೆ ಕಾರ್ಯಗಳನ್ನು ಲಿಂಕ್ ಮಾಡಿ.",
  "tutorialsTasksCreateTitle": "ಕಾರ್ಯಗಳನ್ನು ರಚಿಸಿ",
  "tutorialsTasksHelpB1": "ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ ಮಿತಿಮೀರಿದ ಕಾರ್ಯಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತವೆ.",
  "tutorialsTasksHelpB2": "ಆಟೊಮೇಷನ್‌ಗಳು ಪ್ಲೇಬುಕ್‌ಗಳು ಮತ್ತು ನ್ಯಾಯಾಲಯದ ಗಡುವುಗಳಿಂದ ಕಾರ್ಯಗಳನ್ನು ರಚಿಸಬಹುದು.",
  "tutorialsTasksHelpB3": "ವಿಷಯದ ಮೇಲೆ ತೆರೆದ ಕಾರ್ಯಗಳನ್ನು ಸಾರಾಂಶ ಮಾಡಲು ಕಾಪಿಲೋಟ್ ಬಳಸಿ.",
  "tutorialsTasksHelpTitle": "ಕಾರ್ಯಗಳು",
  "tutorialsTasksListBody": "ನಿಗದಿತ ದಿನಾಂಕ, ಆದ್ಯತೆ ಅಥವಾ ನಿಯೋಜಿತರಿಂದ ಫಿಲ್ಟರ್ ಮಾಡಿ. ಕೆಲಸ ಮುಂದುವರೆದಂತೆ ಪೂರ್ಣಗೊಂಡಿದೆ ಎಂದು ಗುರುತಿಸಿ.",
  "tutorialsTasksListTitle": "ಟಾಸ್ಕ್ ಕ್ಯೂ",
  "tutorialsTeamHelpB1": "ಪಾತ್ರಗಳು ಸೈಡ್‌ಬಾರ್ ಗೋಚರತೆ ಮತ್ತು ಕಾಪಿಲಟ್ ಅನುಮತಿಗಳನ್ನು ನಿರ್ಧರಿಸುತ್ತವೆ.",
  "tutorialsTeamHelpB2": "ಆಡಿಟ್ ಇತಿಹಾಸವನ್ನು ಸಂರಕ್ಷಿಸಲು ಅಳಿಸುವ ಬದಲು ಬಳಕೆದಾರರನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ.",
  "tutorialsTeamHelpTitle": "ತಂಡ",
  "tutorialsTeamInviteBody": "ಸಹೋದ್ಯೋಗಿಗಳನ್ನು ಆಹ್ವಾನಿಸಿ ಮತ್ತು ಬಿಲ್ಲಿಂಗ್, ವಿಷಯಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಪ್ರವೇಶವನ್ನು ನಿಯಂತ್ರಿಸುವ ಪಾತ್ರಗಳನ್ನು ನಿಯೋಜಿಸಿ.",
  "tutorialsTeamInviteTitle": "ತಂಡದ ನಿರ್ವಹಣೆ",
  "tutorialsTemplatesHelpB1": "ವೇಗವಾಗಿ ಡ್ರಾಫ್ಟಿಂಗ್ ಮಾಡಲು ಅಭ್ಯಾಸ ಪ್ರದೇಶದ ಮೂಲಕ ಆಯೋಜಿಸಿ.",
  "tutorialsTemplatesHelpB2": "ಇತಿಹಾಸವನ್ನು ಕಳೆದುಕೊಳ್ಳದೆ ಆವೃತ್ತಿಗಳನ್ನು ಸಂಪಾದಿಸಿ.",
  "tutorialsTemplatesHelpTitle": "ಟೆಂಪ್ಲೇಟ್‌ಗಳು",
  "tutorialsTemplatesUploadBody": "ಸ್ವಯಂಚಾಲಿತ ಉತ್ಪಾದನೆಗಾಗಿ ವಿಲೀನ ವೇರಿಯಬಲ್‌ಗಳೊಂದಿಗೆ ಫರ್ಮ್ ಟೆಂಪ್ಲೇಟ್‌ಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ (ಉದಾ. ಕ್ಲೈಂಟ್ ಹೆಸರು).",
  "tutorialsTemplatesUploadTitle": "ಡಾಕ್ಯುಮೆಂಟ್ ಟೆಂಪ್ಲೆಟ್ಗಳು",
  "tutorialsTimeHelpB1": "ನಿಖರವಾದ ಸಮಯದ ದಾಖಲೆಗಳು ಫೀಡ್ ಪೂರ್ವ-ಬಿಲ್ ಪರಿಶೀಲನೆ.",
  "tutorialsTimeHelpB2": "ಮ್ಯಾಟರ್ ಲಿಂಕ್‌ಗಳನ್ನು ಬಳಸಿ ಇದರಿಂದ ಹಣಕಾಸು ಸರಿಯಾಗಿ ಇನ್‌ವಾಯ್ಸ್ ಮಾಡಬಹುದು.",
  "tutorialsTimeHelpTitle": "ಸಮಯ ಟ್ರ್ಯಾಕಿಂಗ್",
  "tutorialsTimeListBody": "ಪ್ರಿ-ಬಿಲ್ ಮತ್ತು ಇನ್‌ವಾಯ್ಸ್ ಮಾಡುವ ಮೊದಲು ನಮೂದುಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಸಂಪಾದಿಸಿ.",
  "tutorialsTimeListTitle": "ಸಮಯದ ನಮೂದುಗಳು",
  "tutorialsTimeLogBody": "ವಿಷಯಗಳ ವಿರುದ್ಧ ಬಿಲ್ ಮಾಡಬಹುದಾದ ಮತ್ತು ಬಿಲ್ ಮಾಡಲಾಗದ ಸಮಯವನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಿ.",
  "tutorialsTimeLogTitle": "ಲಾಗ್ ಸಮಯ",
  "tutorialsTrustBalancesBody": "ಕ್ಲೈಂಟ್ ಟ್ರಸ್ಟ್ ಬ್ಯಾಲೆನ್ಸ್, ಬಾಕಿ ಉಳಿದಿರುವ ಅನುಮೋದನೆಗಳು ಮತ್ತು ಸಮನ್ವಯವನ್ನು ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡಿ.",
  "tutorialsTrustBalancesTitle": "ಲೆಕ್ಕಪತ್ರವನ್ನು ನಂಬಿರಿ",
  "tutorialsTrustHelpB1": "ಟ್ರಸ್ಟ್ ಮತ್ತು ಆಪರೇಟಿಂಗ್ ಫಂಡ್‌ಗಳನ್ನು ಎಂದಿಗೂ ಸಂಯೋಜಿಸಬೇಡಿ.",
  "tutorialsTrustHelpB2": "ಕ್ರಿಯೆಯ ಅಗತ್ಯವಿರುವಾಗ ಅನುಮೋದನೆ ಎಚ್ಚರಿಕೆಗಳು ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ ಗೋಚರಿಸುತ್ತವೆ.",
  "tutorialsTrustHelpTitle": "ನಂಬಿಕೆ",
  "tutorialsUsDraftingHelpB1": "ಸಲ್ಲಿಸುವ ಮೊದಲು ಸ್ಥಳೀಯ ನ್ಯಾಯಾಲಯದ ನಿಯಮಗಳನ್ನು ದೃಢೀಕರಿಸಿ.",
  "tutorialsUsDraftingHelpB2": "ಸಮಯದ ಟ್ರ್ಯಾಕಿಂಗ್‌ಗಾಗಿ ವಿಷಯಗಳಿಗೆ ಡ್ರಾಫ್ಟ್‌ಗಳನ್ನು ಉಳಿಸಿ.",
  "tutorialsUsDraftingHelpTitle": "ಯುಎಸ್ ಡ್ರಾಫ್ಟಿಂಗ್",
  "tutorialsUsDraftingWorkspaceBody": "ನ್ಯಾಯವ್ಯಾಪ್ತಿ-ಅರಿವು ಪ್ರಾಂಪ್ಟ್‌ಗಳು ಮತ್ತು ಉಲ್ಲೇಖ ಸಹಾಯಕರೊಂದಿಗೆ ಫೆಡರಲ್ ಮತ್ತು ರಾಜ್ಯ ಚಲನೆಯ ಟೆಂಪ್ಲೇಟ್‌ಗಳು.",
  "tutorialsUsDraftingWorkspaceTitle": "US ಕೋರ್ಟ್ ಡ್ರಾಫ್ಟಿಂಗ್",
  "tutorialsVaultHelpB1": "ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾದ ಕಾರ್ಪೋರಾದಾದ್ಯಂತ ಬೃಹತ್ ಪರಿಶ್ರಮದ ಪ್ರಶ್ನೆಗಳನ್ನು ರನ್ ಮಾಡಿ.",
  "tutorialsVaultHelpB2": "ಫಲಿತಾಂಶಗಳು ಮ್ಯಾಟರ್ ಮತ್ತು ಕ್ಲೈಂಟ್ ಪ್ರವೇಶ ನಿಯಂತ್ರಣಗಳನ್ನು ಗೌರವಿಸುತ್ತವೆ.",
  "tutorialsVaultHelpTitle": "ವಾಲ್ಟ್",
  "tutorialsVaultSearchBody": "ದೃಢವಾದ ಸ್ಮರಣೆಯಾದ್ಯಂತ ಲಾಕ್ಷಣಿಕ ಹುಡುಕಾಟ - ಹಿಂದಿನ ವಿಷಯಗಳು, ಮೆಮೊಗಳು ಮತ್ತು ಶ್ರದ್ಧೆ ಪ್ಯಾಕ್‌ಗಳು.",
  "tutorialsVaultSearchTitle": "ಸಂಸ್ಥೆಯ ವಾಲ್ಟ್",
  "tutorialsWelcomeB1": "ಹುಡುಕಾಟ ಅಥವಾ ⌘K ಜೊತೆಗೆ ಎಲ್ಲಿಯಾದರೂ ಹೋಗು",
  "tutorialsWelcomeB2": "ನೀವು ಇರುವ ಪುಟವನ್ನು ಕಾಪಿಲಟ್ ಅರ್ಥಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ",
  "tutorialsWelcomeB3": "ನಿಮಗೆ ರಿಫ್ರೆಶರ್ ಅಗತ್ಯವಿರುವಾಗ ಸಹಾಯದಿಂದ ಯಾವುದೇ ಪ್ರವಾಸವನ್ನು ರಿಪ್ಲೇ ಮಾಡಿ",
  "tutorialsWelcomeBody": "ಎರಡು ನಿಮಿಷಗಳ ಪ್ರವಾಸವು ಕ್ಲೈಂಟ್‌ಗಳು, ವಿಷಯಗಳು, ಬಿಲ್ಲಿಂಗ್ ಮತ್ತು AI ಕಾಪಿಲಟ್ ಅನ್ನು ಎಲ್ಲಿ ಹುಡುಕಬೇಕು ಎಂಬುದನ್ನು ತೋರಿಸುತ್ತದೆ.",
  "tutorialsWelcomeSkip": "ಸದ್ಯಕ್ಕೆ ಬಿಟ್ಟುಬಿಡಿ",
  "tutorialsWelcomeStart": "ಪ್ರವಾಸವನ್ನು ಪ್ರಾರಂಭಿಸಿ",
  "tutorialsWelcomeTitle": "ಅಂಬ್ರೆಲಾಗೆ ಸುಸ್ವಾಗತ"
}
