  "tutorialsControlsSkipTour": "ಪ್ರವಾಸವನ್ನು ಬಿಟ್ಟುಬಿಡಿ",
  "tutorialsCopilotAuditHelpB1": "ಬಳಕೆದಾರ, ವಿಷಯ ಅಥವಾ ಕ್ರಿಯೆಯ ಪ್ರಕಾರದಿಂದ ಫಿಲ್ಟರ್ ಮಾಡಿ.",
  "tutorialsCopilotAuditHelpB2": "ಸಂಸ್ಥೆಯ ಆಡಳಿತ ವಿಮರ್ಶೆಗಳಿಗಾಗಿ ಲಾಗ್‌ಗಳನ್ನು ರಫ್ತು ಮಾಡಿ.",
  "tutorialsCopilotAuditHelpTitle": "ಕಾಪಿಲಟ್ ಆಡಿಟ್",
  "tutorialsCopilotAuditListBody": "ಅನುಸರಣೆಗಾಗಿ ವಿಷಯಗಳಾದ್ಯಂತ Copilot ಪ್ರಸ್ತಾಪಿಸಿದ ಮತ್ತು ಕಾರ್ಯಗತಗೊಳಿಸಿದ AI ಕ್ರಿಯೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsCopilotAuditListTitle": "ಕಾಪಿಲಟ್ ಆಡಿಟ್ ಲಾಗ್",
  "tutorialsDashboardAlertsBody": "KYC ಅಂತರಗಳು, ಟ್ರಸ್ಟ್ ಅನುಮೋದನೆಗಳು ಮತ್ತು ಡೆಡ್‌ಲೈನ್ ಅಪಾಯಗಳು ಇಲ್ಲಿ ಮೊದಲು ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತವೆ. ಬಿಲ್ಲಿಂಗ್ ಅಥವಾ ನ್ಯಾಯಾಲಯದ ದಿನಾಂಕಗಳನ್ನು ಮುಟ್ಟುವ ಮೊದಲು ನಿರ್ಣಾಯಕ ವಸ್ತುಗಳನ್ನು ಪರಿಹರಿಸಿ.",
  "tutorialsDashboardAlertsTitle": "ಇಂದು ಗಮನ ಬೇಕು",
  "tutorialsDashboardHelpB1": "KPI ಮತ್ತು ಟಾಸ್ಕ್ ವಿಂಡೋಗಳನ್ನು ಬದಲಾಯಿಸಲು ಇಂದು / ವಾರ / ತಿಂಗಳು ಬದಲಿಸಿ.",
  "tutorialsDashboardHelpB2": "AI- ಸೂಚಿಸಿದ ಆದ್ಯತೆಗಳಿಗಾಗಿ ಮುಂದಿನ ಅತ್ಯುತ್ತಮ ಕ್ರಿಯೆಗಳನ್ನು ಬಳಸಿ.",
  "tutorialsDashboardHelpB3": "ವಿಷಯಗಳು, ಬಿಲ್ಲಿಂಗ್ ಅಥವಾ ಎಚ್ಚರಿಕೆಗಳನ್ನು ಕೊರೆಯಲು ಯಾವುದೇ ಕಾರ್ಡ್ ತೆರೆಯಿರಿ.",
  "tutorialsDashboardHelpTitle": "ಡ್ಯಾಶ್‌ಬೋರ್ಡ್",
  "tutorialsDashboardKpisBody": "ಸಕ್ರಿಯ ವಿಷಯಗಳು, ಮಿತಿಮೀರಿದ ಕಾರ್ಯಗಳು, ಪೈಪ್‌ಲೈನ್ ಮೌಲ್ಯ ಮತ್ತು ಇಂದು, ವಾರ ಅಥವಾ ತಿಂಗಳ ಆದಾಯ-ಹೆಡರ್‌ನಲ್ಲಿ ಶ್ರೇಣಿಯನ್ನು ಬದಲಾಯಿಸಿ.",
  "tutorialsDashboardKpisTitle": "ಸಂಸ್ಥೆಯ ಸ್ನ್ಯಾಪ್‌ಶಾಟ್",
  "tutorialsDashboardOnboardingBody": "ಪಾಲುದಾರರು ಇಲ್ಲಿ ಸೆಟಪ್ ಹಂತಗಳನ್ನು ನೋಡುತ್ತಾರೆ-ಸಂಶೋಧನೆಯನ್ನು ರನ್ ಮಾಡಿ, ಕ್ಲೈಂಟ್ ಅನ್ನು ಸೇರಿಸಿ, ವಿಷಯವನ್ನು ತೆರೆಯಿರಿ-ನಿಮ್ಮ ಕಾರ್ಯಸ್ಥಳವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಕ್ರಿಯಗೊಳಿಸಲು.",
  "tutorialsDashboardOnboardingTitle": "ಪರಿಶೀಲನಾಪಟ್ಟಿಯನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ",
  "tutorialsDashboardTasksBody": "ನಿಗದಿತ ದಿನಾಂಕಗಳೊಂದಿಗೆ ನಿಮಗೆ ನಿಯೋಜಿಸಲಾದ ಕಾರ್ಯಗಳು. ಸ್ಥಿತಿಯನ್ನು ನವೀಕರಿಸಲು ಅಥವಾ ಲಿಂಕ್ ಮಾಡಲಾದ ವಿಷಯಕ್ಕೆ ಹೋಗಲು ಯಾವುದೇ ಸಾಲನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.",
  "tutorialsDashboardTasksTitle": "ನಿಮ್ಮ ಕಾರ್ಯದ ಸಾಲು",
  "tutorialsDocumentReviewAnalyzeBody": "ಏಕ ಅಥವಾ ಕೋಷ್ಟಕ ಮೋಡ್ ಅನ್ನು ಆರಿಸಿ, AI ಮಾದರಿಯನ್ನು ಆರಿಸಿ, ನಂತರ ವಿಶ್ಲೇಷಿಸಿ. ಫಲಿತಾಂಶಗಳನ್ನು ಮ್ಯಾಟರ್ ಅಥವಾ ಕ್ಲೈಂಟ್ ಫೈಲ್‌ಗೆ ಉಳಿಸಿ.",
  "tutorialsDocumentReviewAnalyzeTitle": "ರನ್ ವಿಶ್ಲೇಷಣೆ",
  "tutorialsDocumentReviewHelpB1": "ಟ್ಯಾಬ್ಯುಲರ್ ಮೋಡ್ ಅನೇಕ ಫೈಲ್‌ಗಳಲ್ಲಿ ಷರತ್ತುಗಳನ್ನು ಹೋಲಿಸುತ್ತದೆ.",
  "tutorialsDocumentReviewHelpB2": "ಫೈಲ್ ಮಾಡುವ ಮೊದಲು ಯಾವಾಗಲೂ AI ಸಲಹೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsDocumentReviewHelpB3": "ಟಿಪ್ಪಣಿ ಮಾಡಿದ ವಿಮರ್ಶೆಗಳನ್ನು PDF ಆಗಿ ರಫ್ತು ಮಾಡಿ.",
  "tutorialsDocumentReviewHelpTitle": "ಡಾಕ್ಯುಮೆಂಟ್ ಪರಿಶೀಲನೆ",
  "tutorialsDocumentReviewUploadBody": "ಒಪ್ಪಂದಗಳು, ಮನವಿಗಳು ಅಥವಾ ಒಪ್ಪಂದಗಳನ್ನು ಬಿಡಿ. ಅಂಬ್ರೆಲಾ ಅಪಾಯಕಾರಿ ಷರತ್ತುಗಳನ್ನು ಫ್ಲ್ಯಾಗ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ತಿದ್ದುಪಡಿಗಳನ್ನು ಸೂಚಿಸುತ್ತದೆ.",
  "tutorialsDocumentReviewUploadTitle": "ಅಪ್ಲೋಡ್ ಅಥವಾ ಅಂಟಿಸಿ",
  "tutorialsDocumentsHelpB1": "ಟೆಂಪ್ಲೇಟ್‌ಗಳು ಮತ್ತು ರಚಿಸಿದ ಡ್ರಾಫ್ಟ್‌ಗಳು ಸಹ ಇಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತವೆ.",
  "tutorialsDocumentsHelpB2": "ಫೈಲ್‌ಗಳಾದ್ಯಂತ ಷರತ್ತುಗಳನ್ನು ಹುಡುಕಲು ಕಾಪಿಲೋಟ್ ಡಾಕ್ಯುಮೆಂಟ್ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿ.",
  "tutorialsDocumentsHelpTitle": "ದಾಖಲೆಗಳು",
  "tutorialsDocumentsListBody": "ಫೈಲ್‌ಗಳನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ, ಹುಡುಕಿ ಮತ್ತು ತೆರೆಯಿರಿ. ಪ್ರತಿ ಡಾಕ್ಯುಮೆಂಟ್‌ಗೆ ಆವೃತ್ತಿ ಇತಿಹಾಸವನ್ನು ಇರಿಸಲಾಗುತ್ತದೆ.",
  "tutorialsDocumentsListTitle": "ಡಾಕ್ಯುಮೆಂಟ್ ಲೈಬ್ರರಿ",
  "tutorialsDocumentsUploadBody": "ಸಂಸ್ಥೆಯ ಫೈಲ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಮತ್ತು ಅವುಗಳನ್ನು ಕ್ಲೈಂಟ್‌ಗಳು ಅಥವಾ ವಿಷಯಗಳೊಂದಿಗೆ ಸಂಯೋಜಿಸಿ.",
  "tutorialsDocumentsUploadTitle": "ದಾಖಲೆಗಳನ್ನು ಅಪ್ಲೋಡ್ ಮಾಡಿ",
  "tutorialsEsignCreateBody": "ಸಹಿ ಮಾಡುವ ಲಕೋಟೆಗಳನ್ನು ರಚಿಸಿ, ಸಹಿ ಮಾಡುವವರನ್ನು ಸೇರಿಸಿ ಮತ್ತು ಪೂರ್ಣಗೊಳಿಸುವಿಕೆಯ ಸ್ಥಿತಿಯನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ.",
  "tutorialsEsignCreateTitle": "ಇ-ಸಹಿಗಳು",
  "tutorialsEsignHelpB1": "ಆಡಿಟ್ ಟ್ರೇಲ್‌ಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ವಿಷಯಗಳಿಗೆ ಲಕೋಟೆಗಳನ್ನು ಲಿಂಕ್ ಮಾಡಿ.",
  "tutorialsEsignHelpB2": "ಗ್ರಾಹಕರು ಸುರಕ್ಷಿತ ಇಮೇಲ್ ಲಿಂಕ್‌ಗಳ ಮೂಲಕ ಸಹಿ ಮಾಡಬಹುದು.",
  "tutorialsEsignHelpTitle": "ಇ-ಚಿಹ್ನೆ",
  "tutorialsEvidenceHelpB1": "ಬಂಡಲ್ ಇಂಡೆಕ್ಸಿಂಗ್‌ಗಾಗಿ ಸ್ಪಷ್ಟ ಶೀರ್ಷಿಕೆಗಳೊಂದಿಗೆ ಐಟಂಗಳನ್ನು ಸೇರಿಸಿ.",
  "tutorialsEvidenceHelpB2": "ಎದುರಾಳಿ ಸಲಹೆಗಾರರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳುವ ಮೊದಲು ಸವಲತ್ತುಗಳನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "tutorialsEvidenceHelpB3": "AI-ಸಹಾಯದ ಕಾಲಗಣನೆಗಾಗಿ ಮ್ಯಾಟರ್ ಕ್ವಿಕ್ AI ಅನ್ನು ತೆರೆಯಿರಿ.",
  "tutorialsEvidenceHelpTitle": "ಸಾಕ್ಷಿ ಕಮಾನು",
  "tutorialsEvidenceListBody": "ಐಟಂಗಳು, ಸವಲತ್ತು ಧ್ವಜಗಳು ಮತ್ತು ಸಿದ್ಧತೆ ಕಾರ್ಡ್‌ಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ. ನ್ಯಾಯಾಲಯಕ್ಕೆ ತಯಾರಿ ಮಾಡುವಾಗ ಕಟ್ಟುಗಳನ್ನು ರಫ್ತು ಮಾಡಿ.",
  "tutorialsEvidenceListTitle": "ಪುರಾವೆಗಳ ನೋಂದಣಿ",
  "tutorialsEvidenceMatterBody": "ಪುರಾವೆಗಳು ಯಾವಾಗಲೂ ಒಂದು ವಿಷಯಕ್ಕೆ ವ್ಯಾಪ್ತಿಗೆ ಒಳಪಡುತ್ತವೆ. ಪ್ರದರ್ಶನಗಳು ಅಥವಾ ಕಾಲಾನುಕ್ರಮದ ಐಟಂಗಳನ್ನು ಸೇರಿಸುವ ಮೊದಲು ಪ್ರಕರಣವನ್ನು ಆಯ್ಕೆಮಾಡಿ.",
  "tutorialsEvidenceMatterTitle": "ವಿಷಯಕ್ಕೆ ಲಿಂಕ್ ಮಾಡಿ",
  "tutorialsExpensesCreateBody": "ಪಾವತಿಗಳನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಿ, ರಸೀದಿಗಳನ್ನು ಲಗತ್ತಿಸಿ ಮತ್ತು ಅನ್ವಯವಾಗುವ ವಿಷಯಗಳಿಗೆ ಬಿಲ್.",
  "tutorialsExpensesCreateTitle": "ಲಾಗ್ ವೆಚ್ಚಗಳು",
  "tutorialsExpensesHelpB1": "ಇನ್‌ವಾಯ್ಸ್ ಮಾಡುವ ಮೊದಲು ಹಣಕಾಸು ಪಾತ್ರಗಳು ವೆಚ್ಚಗಳನ್ನು ಅನುಮೋದಿಸಬಹುದು.",
  "tutorialsExpensesHelpB2": "ಕ್ಲೀನ್ ಕ್ಲೈಂಟ್ ಬಿಲ್ಲಿಂಗ್‌ಗೆ ಪ್ರತಿ ಖರ್ಚನ್ನು ಲಿಂಕ್ ಮಾಡಿ.",
  "tutorialsExpensesHelpTitle": "ವೆಚ್ಚಗಳು",
  "tutorialsFinanceDashboardBody": "ಆದಾಯ, ಸ್ವೀಕರಿಸಬಹುದಾದ ಖಾತೆಗಳು ಮತ್ತು ಸಂಸ್ಥೆಯ ಹಣಕಾಸು KPIಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ.",
  "tutorialsFinanceDashboardTitle": "ಹಣಕಾಸು ಡ್ಯಾಶ್‌ಬೋರ್ಡ್",
  "tutorialsFinanceHelpB1": "ಸಾರಾಂಶ ಕಾರ್ಡ್‌ಗಳಿಂದ ಇನ್‌ವಾಯ್ಸ್‌ಗಳು ಮತ್ತು ಪಾವತಿಗಳನ್ನು ಡ್ರಿಲ್ ಮಾಡಿ.",
  "tutorialsFinanceHelpB2": "ಪಾಲುದಾರರು ಮತ್ತು ಅಕೌಂಟೆಂಟ್‌ಗಳಿಗಾಗಿ ರಫ್ತು ವರದಿಗಳು.",
  "tutorialsFinanceHelpTitle": "ಹಣಕಾಸು",
