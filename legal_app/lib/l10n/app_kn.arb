  "legalPrivacyAutomatedBody": "ಅಂಬ್ರೆಲಾ ಕಾನೂನು ವಿಶ್ಲೇಷಣೆಯನ್ನು ರಚಿಸಲು, ಸಮಸ್ಯೆಗಳನ್ನು ಗುರುತಿಸಲು ಮತ್ತು ಕ್ರಮಗಳನ್ನು ಸೂಚಿಸಲು AI ಅನ್ನು ಬಳಸುತ್ತದೆ. ಈ AI ಔಟ್‌ಪುಟ್‌ಗಳು ಕೇವಲ ಮಾಹಿತಿಯುಕ್ತವಾಗಿವೆ ಮತ್ತು ನಿಮ್ಮ ಕಾನೂನು ಹಕ್ಕುಗಳ ಬಗ್ಗೆ ಬಂಧಿಸುವ ನಿರ್ಧಾರಗಳನ್ನು ರೂಪಿಸುವುದಿಲ್ಲ. ಮಾನವ ವಿಮರ್ಶೆಯಿಲ್ಲದೆ ನಿಮ್ಮ ಬಗ್ಗೆ ಕಾನೂನು ಅಥವಾ ಅದೇ ರೀತಿಯ ಮಹತ್ವದ ಪರಿಣಾಮದೊಂದಿಗೆ ಯಾವುದೇ ಸಂಪೂರ್ಣ ಸ್ವಯಂಚಾಲಿತ ನಿರ್ಧಾರವನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ. ವಂಚನೆ ಪತ್ತೆಗಾಗಿ ನಮ್ಮ AI ಅಪಾಯ-ಸ್ಕೋರಿಂಗ್ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಪ್ರವೇಶದ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರಬಹುದು; ಅಂತಹ ಯಾವುದೇ ನಿರ್ಧಾರವನ್ನು ನೀವು ಮಾನವ ವಿಮರ್ಶೆಗೆ ವಿನಂತಿಸಬಹುದು.",
  "legalPrivacyAutomatedHeading": "11. ಸ್ವಯಂಚಾಲಿತ ನಿರ್ಧಾರ-ಮಾಡುವಿಕೆ",
  "legalPrivacyChangesBody": "ನಾವು ಈ ಗೌಪ್ಯತಾ ನೀತಿಯನ್ನು ಕಾಲಕಾಲಕ್ಕೆ ನವೀಕರಿಸಬಹುದು. ವಸ್ತು ಬದಲಾವಣೆಗಳನ್ನು ಇಮೇಲ್ ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿನ ಅಧಿಸೂಚನೆಯ ಮೂಲಕ ಅವು ಪರಿಣಾಮ ಬೀರುವ ಕನಿಷ್ಠ 30 ದಿನಗಳ ಮೊದಲು ತಿಳಿಸಲಾಗುತ್ತದೆ. ಪರಿಣಾಮಕಾರಿ ದಿನಾಂಕದ ನಂತರ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ನ ಮುಂದುವರಿದ ಬಳಕೆಯು ನವೀಕರಿಸಿದ ನೀತಿಯನ್ನು ಅಂಗೀಕರಿಸುತ್ತದೆ.",
  "legalPrivacyChangesHeading": "13. ಈ ನೀತಿಗೆ ಬದಲಾವಣೆಗಳು",
  "legalPrivacyChildrenBody": "18 ವರ್ಷಕ್ಕಿಂತ ಕಡಿಮೆ ವಯಸ್ಸಿನ ವ್ಯಕ್ತಿಗಳಿಗೆ ಅಂಬ್ರೆಲಾವನ್ನು ನಿರ್ದೇಶಿಸಲಾಗುವುದಿಲ್ಲ. ನಾವು ಉದ್ದೇಶಪೂರ್ವಕವಾಗಿ ಮಕ್ಕಳಿಂದ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ. ಮಗುವು ನಮಗೆ ಡೇಟಾವನ್ನು ಸಲ್ಲಿಸಿದೆ ಎಂದು ನೀವು ಭಾವಿಸಿದರೆ, support@odaflow.com ಅನ್ನು ಸಂಪರ್ಕಿಸಿ ಮತ್ತು ನಾವು ಅದನ್ನು ತ್ವರಿತವಾಗಿ ಅಳಿಸುತ್ತೇವೆ.",
  "legalPrivacyChildrenHeading": "8. ಮಕ್ಕಳು",
  "legalPrivacyCollectAccountBody": "ಖಾತೆ ಡೇಟಾ: ಇಮೇಲ್ ವಿಳಾಸ, ಪೂರ್ಣ ಹೆಸರು, ಫೋನ್ ಸಂಖ್ಯೆ (ಐಚ್ಛಿಕ), ವಾಸಿಸುವ ದೇಶ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಹ್ಯಾಶ್. ವಕೀಲ ಬಳಕೆದಾರರಿಗೆ: ಬಾರ್ ನೋಂದಣಿ ಸಂಖ್ಯೆ, ಸಂಸ್ಥೆಯ ಹೆಸರು, ಅಭ್ಯಾಸ ಪ್ರದೇಶಗಳು ಮತ್ತು ನ್ಯಾಯವ್ಯಾಪ್ತಿ.",
  "legalPrivacyCollectBillingBody": "ಬಿಲ್ಲಿಂಗ್ ಡೇಟಾ: ಚಂದಾದಾರಿಕೆ ಯೋಜನೆ, ಪಾವತಿ ವಿಧಾನದ ಪ್ರಕಾರ (ಕಾರ್ಡ್ ಬ್ರ್ಯಾಂಡ್, ಕೊನೆಯ ನಾಲ್ಕು ಅಂಕೆಗಳು), ಬಿಲ್ಲಿಂಗ್ ವಿಳಾಸ ಮತ್ತು ವಹಿವಾಟಿನ ಇತಿಹಾಸ. ಪೂರ್ಣ ಪಾವತಿ ಕಾರ್ಡ್ ವಿವರಗಳನ್ನು ನಮ್ಮ ಪಿಸಿಐ-ಡಿಎಸ್ಎಸ್-ಕಂಪ್ಲೈಂಟ್ ಪಾವತಿ ಪ್ರೊಸೆಸರ್ (ಸ್ಟ್ರೈಪ್) ನಿರ್ವಹಿಸುತ್ತದೆ ಮತ್ತು ನಮ್ಮ ಸರ್ವರ್‌ಗಳಲ್ಲಿ ಎಂದಿಗೂ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ.",
  "legalPrivacyCollectContentBody": "ವಿಷಯ ಡೇಟಾ: ಕಾನೂನು ದಾಖಲೆಗಳು, ಕೇಸ್ ವಿವರಣೆಗಳು, ವಿಷಯದ ಟಿಪ್ಪಣಿಗಳು, ಕ್ಲೈಂಟ್ ಸಂವಹನಗಳು ಮತ್ತು ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಮೂಲಕ ನೀವು ರಚಿಸುವ ಅಥವಾ ಸಲ್ಲಿಸುವ AI- ರಚಿತವಾದ ಔಟ್‌ಪುಟ್‌ಗಳು. ಸೇವೆಯನ್ನು ನೀಡಲು ಈ ವಿಷಯವನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಲಾಗಿದೆ ಮತ್ತು ನಿಮ್ಮ ಸ್ಪಷ್ಟ ಆಯ್ಕೆಯಿಲ್ಲದೆ AI ತರಬೇತಿಗಾಗಿ ಬಳಸಲಾಗುವುದಿಲ್ಲ.",
  "legalPrivacyCollectCookiesBody": "ಕುಕೀಸ್ ಮತ್ತು ಟ್ರ್ಯಾಕಿಂಗ್: ನಾವು ಕಟ್ಟುನಿಟ್ಟಾಗಿ-ಅಗತ್ಯವಿರುವ ಸೆಷನ್ ಕುಕೀಸ್, ಕ್ರಿಯಾತ್ಮಕ ಆದ್ಯತೆಯ ಕುಕೀಗಳನ್ನು ಬಳಸುತ್ತೇವೆ ಮತ್ತು — ನಿಮ್ಮ ಒಪ್ಪಿಗೆಯೊಂದಿಗೆ — ವಿಶ್ಲೇಷಣಾ ಕುಕೀಗಳನ್ನು (ವರ್ಸೆಲ್ ಅನಾಲಿಟಿಕ್ಸ್, ಸೆಂಟ್ರಿ ದೋಷ ಟ್ರ್ಯಾಕಿಂಗ್) ಬಳಸುತ್ತೇವೆ. ಕುಕೀ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಫಲಕದ ಮೂಲಕ ನೀವು ಕುಕೀ ಆದ್ಯತೆಗಳನ್ನು ನಿರ್ವಹಿಸಬಹುದು.",
  "legalPrivacyCollectDeviceBody": "ಸಾಧನ ಮತ್ತು ತಾಂತ್ರಿಕ ಡೇಟಾ: IP ವಿಳಾಸ, ಬ್ರೌಸರ್ ಪ್ರಕಾರ, ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಮ್, ಸಾಧನ ಗುರುತಿಸುವಿಕೆಗಳು, ಪರದೆಯ ರೆಸಲ್ಯೂಶನ್ ಮತ್ತು ಸಮಯ ವಲಯ. ಭದ್ರತೆ, ವಂಚನೆ ತಡೆಗಟ್ಟುವಿಕೆ ಮತ್ತು ಸೇವಾ ಹೊಂದಾಣಿಕೆಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ.",
  "legalPrivacyCollectHeading": "3. ನಾವು ಸಂಗ್ರಹಿಸುವ ಮಾಹಿತಿ",
  "legalPrivacyCollectUsageBody": "ಬಳಕೆಯ ಡೇಟಾ: ಭೇಟಿ ನೀಡಿದ ಪುಟಗಳು, ಬಳಸಿದ ವೈಶಿಷ್ಟ್ಯಗಳು, ಸಲ್ಲಿಸಿದ AI ಪ್ರಶ್ನೆಗಳು, ಅಪ್‌ಲೋಡ್ ಮಾಡಿದ ದಾಖಲೆಗಳು, ಕಳೆದ ಸಮಯ, ಈವೆಂಟ್‌ಗಳನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು ಸೆಷನ್ ರೆಕಾರ್ಡಿಂಗ್‌ಗಳು (ಸಮ್ಮತಿಯನ್ನು ನೀಡಿದರೆ). ಈ ಡೇಟಾವನ್ನು ಫಸ್ಟ್-ಪಾರ್ಟಿ ಅನಾಲಿಟಿಕ್ಸ್ ಮೂಲಕ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ.",
  "legalPrivacyContactBody": "ಡೇಟಾ ರಕ್ಷಣೆ ವಿಚಾರಣೆಗಳು: support@odaflow.com. ನಾವು 10 ವ್ಯವಹಾರ ದಿನಗಳಲ್ಲಿ ಪ್ರತಿಕ್ರಿಯಿಸುವ ಗುರಿಯನ್ನು ಹೊಂದಿದ್ದೇವೆ. ನಮ್ಮ ಪ್ರತಿಕ್ರಿಯೆಯಿಂದ ನೀವು ಅತೃಪ್ತರಾಗಿದ್ದರೆ ನಿಮ್ಮ ಸ್ಥಳೀಯ ಡೇಟಾ ಸಂರಕ್ಷಣಾ ಪ್ರಾಧಿಕಾರದೊಂದಿಗೆ ದೂರು ಸಲ್ಲಿಸಲು ನೀವು ಹಕ್ಕನ್ನು ಹೊಂದಿದ್ದೀರಿ: UK — ICO (ico.org.uk); EU - ನಿಮ್ಮ ರಾಷ್ಟ್ರೀಯ DPA; ಭಾರತ - ಭಾರತದ ಡೇಟಾ ಸಂರಕ್ಷಣಾ ಮಂಡಳಿ; ಕೀನ್ಯಾ — ಡಾಟಾ ಪ್ರೊಟೆಕ್ಷನ್ ಕಮಿಷನರ್ ಕಚೇರಿ (odpc.go.ke).",
  "legalPrivacyContactHeading": "14. ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ",
  "legalPrivacyControllerBody": "ಅಂಬ್ರೆಲಾವನ್ನು DVTech ವೆಂಚರ್ಸ್ ನಿರ್ವಹಿಸುತ್ತದೆ (\"ನಾವು\", \"ನಮಗೆ\", \"ನಮ್ಮ\"). ಗ್ರಾಹಕರಿಂದ ಸಂಗ್ರಹಿಸಿದ ಮಾಹಿತಿಗಾಗಿ ನಾವು ಡೇಟಾ ನಿಯಂತ್ರಕರಾಗಿ ಮತ್ತು ಕಾನೂನು ಸಂಸ್ಥೆಯ ಬಾಡಿಗೆದಾರರ ಪರವಾಗಿ ಮಾಹಿತಿಗಾಗಿ ಡೇಟಾ ಪ್ರೊಸೆಸರ್ ಆಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತೇವೆ. ನೋಂದಾಯಿತ ವಿಳಾಸ ಮತ್ತು ಡೇಟಾ ರಕ್ಷಣೆ ಸಂಪರ್ಕ: support@odaflow.com. GDPR ಉದ್ದೇಶಗಳಿಗಾಗಿ, ನಮ್ಮ EU/UK ಪ್ರತಿನಿಧಿಯನ್ನು ಅದೇ ವಿಳಾಸದಲ್ಲಿ ಸಂಪರ್ಕಿಸಬಹುದು.",
  "legalPrivacyControllerHeading": "1. ನಾವು ಯಾರು",
  "legalPrivacyCookiesBody": "ಕಟ್ಟುನಿಟ್ಟಾಗಿ ಅಗತ್ಯವಿರುವ ಕುಕೀಗಳು (ಸೆಷನ್ ನಿರ್ವಹಣೆ, ಭದ್ರತಾ ಟೋಕನ್‌ಗಳು) ಯಾವಾಗಲೂ ಸಕ್ರಿಯವಾಗಿರುತ್ತವೆ. ಕ್ರಿಯಾತ್ಮಕ ಕುಕೀಗಳನ್ನು (ಭಾಷೆಯ ಆದ್ಯತೆ, ಥೀಮ್) ಮೊದಲ ಬಳಕೆಯಲ್ಲಿ ಹೊಂದಿಸಲಾಗಿದೆ ಮತ್ತು ಬ್ರೌಸರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ತೆರವುಗೊಳಿಸಬಹುದು. ಅನಾಲಿಟಿಕ್ಸ್ ಕುಕೀಗಳನ್ನು (ವರ್ಸೆಲ್, ಸೆಂಟ್ರಿ) ಕುಕೀ ಬ್ಯಾನರ್ ಮೂಲಕ ನಿಮ್ಮ ಒಪ್ಪಿಗೆಯೊಂದಿಗೆ ಮಾತ್ರ ಹೊಂದಿಸಲಾಗಿದೆ. ನಾವು ಜಾಹೀರಾತು ಅಥವಾ ಕ್ರಾಸ್-ಸೈಟ್ ಟ್ರ್ಯಾಕಿಂಗ್ ಕುಕೀಗಳನ್ನು ಬಳಸುವುದಿಲ್ಲ.",
  "legalPrivacyCookiesHeading": "12. ಕುಕೀಸ್",
  "legalPrivacyDescription": "ಅಂಬ್ರೆಲಾ ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ಹೇಗೆ ಸಂಗ್ರಹಿಸುತ್ತದೆ, ಬಳಸುತ್ತದೆ ಮತ್ತು ರಕ್ಷಿಸುತ್ತದೆ. ಈ ನೀತಿಯು ಭಾರತ, ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್, ಕೀನ್ಯಾ ಮತ್ತು ಯುನೈಟೆಡ್ ಕಿಂಗ್‌ಡಮ್‌ನಾದ್ಯಂತ umbrella.okaylegal.ai ಮತ್ತು ಸಂಬಂಧಿತ ಅಂಬ್ರೆಲ್ಲಾ ಅಪ್ಲಿಕೇಶನ್‌ಗಳ ಎಲ್ಲಾ ಬಳಕೆದಾರರಿಗೆ ಅನ್ವಯಿಸುತ್ತದೆ.",
  "legalPrivacyLegalBasisBody": "ನಿಮ್ಮ ಅಧಿಕಾರ ವ್ಯಾಪ್ತಿಗೆ ಅನುಗುಣವಾಗಿ ನಾವು ಕೆಳಗಿನ ಕಾನೂನು ಆಧಾರಗಳ ಅಡಿಯಲ್ಲಿ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸುತ್ತೇವೆ: (ಎ) ಒಪ್ಪಂದ - ನೀವು ಸೈನ್ ಅಪ್ ಮಾಡಿದ ಸೇವೆಗಳನ್ನು ತಲುಪಿಸಲು ಅಗತ್ಯವಾದ ಪ್ರಕ್ರಿಯೆ; (ಬಿ) ಕಾನೂನುಬದ್ಧ ಆಸಕ್ತಿಗಳು - ವಂಚನೆ ತಡೆಗಟ್ಟುವಿಕೆ, ವೇದಿಕೆ ಭದ್ರತೆ, ಉತ್ಪನ್ನ ಸುಧಾರಣೆ; (ಸಿ) ಸಮ್ಮತಿ - AI ತರಬೇತಿ, ಮಾರ್ಕೆಟಿಂಗ್ ಇಮೇಲ್‌ಗಳು, ಕಟ್ಟುನಿಟ್ಟಾಗಿ ಅಗತ್ಯಕ್ಕಿಂತ ಕುಕೀಗಳು; (ಡಿ) ಕಾನೂನು ಬಾಧ್ಯತೆ - ಅನ್ವಯವಾಗುವ ಕಾನೂನಿನ ಅನುಸರಣೆ. ಭಾರತಕ್ಕೆ ಸಂಬಂಧಿಸಿದಂತೆ, ಪ್ರಕ್ರಿಯೆಯು ಡಿಜಿಟಲ್ ವೈಯಕ್ತಿಕ ಡೇಟಾ ಸಂರಕ್ಷಣಾ ಕಾಯಿದೆ 2023 (DPDP ಕಾಯಿದೆ) ಯಿಂದ ನಿಯಂತ್ರಿಸಲ್ಪಡುತ್ತದೆ. UK/EU ಗಾಗಿ, ಪ್ರಕ್ರಿಯೆಯು UK GDPR ಮತ್ತು EU GDPR ಅನ್ನು ಅನುಸರಿಸುತ್ತದೆ. ಕೀನ್ಯಾಕ್ಕೆ ಸಂಬಂಧಿಸಿದಂತೆ, ಪ್ರಕ್ರಿಯೆಯು ಡೇಟಾ ಸಂರಕ್ಷಣಾ ಕಾಯಿದೆ 2019 ಕ್ಕೆ ಅನುಗುಣವಾಗಿರುತ್ತದೆ. US ಬಳಕೆದಾರರಿಗೆ, ನಾವು CCPA/CPRA ಸೇರಿದಂತೆ ಅನ್ವಯವಾಗುವ ರಾಜ್ಯದ ಗೌಪ್ಯತೆ ಕಾನೂನುಗಳನ್ನು ಅನುಸರಿಸುತ್ತೇವೆ.",
  "legalPrivacyLegalBasisHeading": "2. ಪ್ರಕ್ರಿಯೆಗೆ ಕಾನೂನು ಆಧಾರಗಳು",
  "legalPrivacyPolicy": "ಗೌಪ್ಯತೆ ನೀತಿ",
  "legalPrivacyRetentionBody": "ನಿಮ್ಮ ಖಾತೆಯು ಸಕ್ರಿಯವಾಗಿರುವವರೆಗೆ ನಾವು ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಉಳಿಸಿಕೊಳ್ಳುತ್ತೇವೆ. ಖಾತೆಯನ್ನು ಅಳಿಸಿದಾಗ, ಕಾನೂನಿನ ಪ್ರಕಾರ ಧಾರಣಶಕ್ತಿಯ ಅಗತ್ಯವಿರುವಲ್ಲಿ ಹೊರತುಪಡಿಸಿ (ಉದಾ., ತೆರಿಗೆ ಅನುಸರಣೆಗಾಗಿ 7 ವರ್ಷಗಳವರೆಗೆ ಉಳಿಸಿಕೊಂಡಿರುವ ಬಿಲ್ಲಿಂಗ್ ದಾಖಲೆಗಳು, 12 ತಿಂಗಳವರೆಗೆ ಆಡಿಟ್ ಲಾಗ್‌ಗಳನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲಾಗಿದೆ) ನಾವು ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು 30 ದಿನಗಳಲ್ಲಿ ಅಳಿಸುತ್ತೇವೆ ಅಥವಾ ಅನಾಮಧೇಯಗೊಳಿಸುತ್ತೇವೆ. ಸಂಸ್ಥೆಯ ಬಾಡಿಗೆದಾರರು ಆಡಳಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಮೂಲಕ 7 ವರ್ಷಗಳವರೆಗೆ ಕಸ್ಟಮ್ ಧಾರಣ ನೀತಿಗಳನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಬಹುದು. ಆಯ್ಕೆ ಮಾಡಿದ ವಿಷಯದಿಂದ ಪಡೆದ AI-ತರಬೇತಿ ಡೇಟಾಸೆಟ್‌ಗಳು ನಮ್ಮ ಡೇಟಾ ಮತ್ತು AI ಸಮ್ಮತಿ ನೀತಿಯಲ್ಲಿನ ಧಾರಣ ವೇಳಾಪಟ್ಟಿಗೆ ಒಳಪಟ್ಟಿರುತ್ತವೆ.",
  "legalPrivacyRetentionHeading": "6. ಧಾರಣ",
  "legalPrivacyRightsCCPABody": "ಕ್ಯಾಲಿಫೋರ್ನಿಯಾ (CCPA/CPRA) ಹಕ್ಕುಗಳು: ನಾವು ಯಾವ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಸಂಗ್ರಹಿಸುತ್ತೇವೆ ಎಂಬುದನ್ನು ತಿಳಿದುಕೊಳ್ಳುವ ಹಕ್ಕು; ಅಳಿಸುವ ಹಕ್ಕು; ಮಾರಾಟದಿಂದ ಹೊರಗುಳಿಯುವ ಹಕ್ಕು (ನಾವು ಡೇಟಾವನ್ನು ಮಾರಾಟ ಮಾಡುವುದಿಲ್ಲ); ಹಕ್ಕುಗಳನ್ನು ಚಲಾಯಿಸಲು ತಾರತಮ್ಯದ ಹಕ್ಕು; ತಪ್ಪಾದ ಮಾಹಿತಿಯನ್ನು ಸರಿಪಡಿಸುವ ಹಕ್ಕು; ಸೂಕ್ಷ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯ ಬಳಕೆಯನ್ನು ಮಿತಿಗೊಳಿಸುವ ಹಕ್ಕು.",
  "legalPrivacyRightsDPDPBody": "ಭಾರತದ DPDP ಕಾಯಿದೆಯ ಹಕ್ಕುಗಳು: ನಿಮ್ಮ ಡಿಜಿಟಲ್ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಪ್ರವೇಶಿಸುವ, ತಿದ್ದುಪಡಿ ಮಾಡುವ ಮತ್ತು ಅಳಿಸುವ ಹಕ್ಕು; ಕುಂದುಕೊರತೆ ಪರಿಹಾರದ ಹಕ್ಕು; ನಿಮ್ಮ ಪರವಾಗಿ ಹಕ್ಕುಗಳನ್ನು ಚಲಾಯಿಸಲು ವ್ಯಕ್ತಿಯನ್ನು ನಾಮನಿರ್ದೇಶನ ಮಾಡುವ ಹಕ್ಕು. support@odaflow.com ನಲ್ಲಿ ನಮ್ಮ ಸಮ್ಮತಿ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.",
  "legalPrivacyRightsGDPRBody": "GDPR / UK GDPR ಹಕ್ಕುಗಳು (EU ಮತ್ತು UK ಬಳಕೆದಾರರು): ಪ್ರವೇಶ - ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಡೇಟಾದ ನಕಲನ್ನು ಪಡೆದುಕೊಳ್ಳಿ; ಸರಿಪಡಿಸುವಿಕೆ - ಸರಿಯಾದ ನಿಖರವಾದ ಡೇಟಾ; ಅಳಿಸುವಿಕೆ - ವಿನಂತಿ ಅಳಿಸುವಿಕೆ (ಕಾನೂನು ಹಿಡಿತಕ್ಕೆ ಒಳಪಟ್ಟಿರುತ್ತದೆ); ನಿರ್ಬಂಧ - ವಿವಾದವನ್ನು ಪರಿಹರಿಸುವಾಗ ಮಿತಿ ಪ್ರಕ್ರಿಯೆ; ಪೋರ್ಟಬಿಲಿಟಿ - ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಯಂತ್ರ-ಓದಬಲ್ಲ ಸ್ವರೂಪದಲ್ಲಿ ಸ್ವೀಕರಿಸಿ; ಆಕ್ಷೇಪಣೆ - ಕಾನೂನುಬದ್ಧ ಆಸಕ್ತಿಗಳ ಆಧಾರದ ಮೇಲೆ ಪ್ರಕ್ರಿಯೆಗೆ ವಸ್ತು; ಸ್ವಯಂಚಾಲಿತ ನಿರ್ಧಾರಗಳು - ಗಮನಾರ್ಹ ಪರಿಣಾಮಗಳೊಂದಿಗೆ ಕೇವಲ ಸ್ವಯಂಚಾಲಿತ ನಿರ್ಧಾರಗಳಿಗೆ ಒಳಪಟ್ಟಿರಬಾರದು. ಈ ಹಕ್ಕುಗಳನ್ನು ಚಲಾಯಿಸಲು, support@odaflow.com ಗೆ ಇಮೇಲ್ ಮಾಡಿ ಅಥವಾ ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿನ ಗೌಪ್ಯತೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬಳಸಿ.",
  "legalPrivacyRightsHeading": "9. ನಿಮ್ಮ ಹಕ್ಕುಗಳು",
  "legalPrivacyRightsKenyaBody": "ಕೀನ್ಯಾ ಡೇಟಾ ಸಂರಕ್ಷಣಾ ಕಾಯಿದೆ ಹಕ್ಕುಗಳು: ತಿಳಿಸುವ ಹಕ್ಕು; ಪ್ರವೇಶದ ಹಕ್ಕು; ಸರಿಪಡಿಸುವ ಹಕ್ಕು; ಅಳಿಸಿಹಾಕುವ ಮತ್ತು ನಿರ್ಬಂಧಿಸುವ ಹಕ್ಕು; ಆಕ್ಷೇಪಿಸುವ ಹಕ್ಕು; ಡೇಟಾ ಪೋರ್ಟೆಬಿಲಿಟಿ ಹಕ್ಕು. support@odaflow.com ನಲ್ಲಿ ನಮ್ಮ ಸ್ಥಳೀಯ ಪ್ರತಿನಿಧಿಯನ್ನು ಸಂಪರ್ಕಿಸಿ.",
  "legalPrivacySecurityBody": "ನಾವು ತಾಂತ್ರಿಕ ಮತ್ತು ಸಾಂಸ್ಥಿಕ ಕ್ರಮಗಳನ್ನು ಅಳವಡಿಸಿಕೊಳ್ಳುತ್ತೇವೆ: TLS 1.2+ ಸಾರಿಗೆಯಲ್ಲಿ ಎನ್‌ಕ್ರಿಪ್ಶನ್; ವಿಶ್ರಾಂತಿಯಲ್ಲಿ AES-256 ಗೂಢಲಿಪೀಕರಣ; ಕನಿಷ್ಠ-ಸವಲತ್ತು ತತ್ವಗಳೊಂದಿಗೆ ಪಾತ್ರ-ಆಧಾರಿತ ಪ್ರವೇಶ ನಿಯಂತ್ರಣ; ಆಡಳಿತಾತ್ಮಕ ಪ್ರವೇಶಕ್ಕಾಗಿ ಬಹು ಅಂಶದ ದೃಢೀಕರಣ; ಸ್ವಯಂಚಾಲಿತ ದುರ್ಬಲತೆ ಸ್ಕ್ಯಾನಿಂಗ್; ಕನಿಷ್ಠ ವಾರ್ಷಿಕವಾಗಿ ನುಗ್ಗುವ ಪರೀಕ್ಷೆ; ಮತ್ತು ಘಟನೆ ಪ್ರತಿಕ್ರಿಯೆ ಯೋಜನೆ. ನಿಮ್ಮ ಹಕ್ಕುಗಳ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವ ವೈಯಕ್ತಿಕ ಡೇಟಾ ಉಲ್ಲಂಘನೆಯ ಸಂದರ್ಭದಲ್ಲಿ, ಅನ್ವಯವಾಗುವ ಕಾನೂನಿನ ಅಡಿಯಲ್ಲಿ ಅಗತ್ಯವಿರುವಂತೆ, ಅರಿವು ಮೂಡಿಸಿದ 72 ಗಂಟೆಗಳ ಒಳಗೆ ನಾವು ನಿಮಗೆ ಸೂಚಿಸುತ್ತೇವೆ.",
  "legalPrivacySecurityHeading": "7. ಭದ್ರತೆ",
  "legalPrivacySharingBody": "ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ನಾವು ಮಾರಾಟ ಮಾಡುವುದಿಲ್ಲ. ನಾವು ಡೇಟಾವನ್ನು ಈ ಕೆಳಗಿನಂತೆ ಮಾತ್ರ ಹಂಚಿಕೊಳ್ಳುತ್ತೇವೆ:",
  "legalPrivacySharingHeading": "5. ನಿಮ್ಮ ಡೇಟಾವನ್ನು ನಾವು ಯಾರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳುತ್ತೇವೆ",
  "legalPrivacySharingLawyerReview": "ವಕೀಲರ ವಿಮರ್ಶೆ: ನೀವು ವಕೀಲರ ಪರಿಶೀಲನೆಗೆ ವಿನಂತಿಸಿದರೆ, ನಿಮ್ಮ ಪ್ರಕರಣದ ಸಾರಾಂಶವನ್ನು (ನೀವು ಅದನ್ನು ದೃಢೀಕರಿಸದ ಹೊರತು ಪೂರ್ಣ ವಿಷಯವಲ್ಲ) ನಮ್ಮ ಮಾರುಕಟ್ಟೆಯಲ್ಲಿ ನಿಯೋಜಿಸಲಾದ ಪರವಾನಗಿ ಪಡೆದ ವಕೀಲರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲಾಗುತ್ತದೆ. ಏನನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗಿದೆ ಎಂಬುದನ್ನು ನೀವು ನಿಯಂತ್ರಿಸುತ್ತೀರಿ.",
  "legalPrivacySharingLegal": "ಕಾನೂನು ಬಹಿರಂಗಪಡಿಸುವಿಕೆಗಳು: ಕಾನೂನು, ನ್ಯಾಯಾಲಯದ ಆದೇಶ ಅಥವಾ ನಿಯಂತ್ರಣ ಪ್ರಾಧಿಕಾರದ ಅಗತ್ಯವಿದ್ದಾಗ ನಾವು ಡೇಟಾವನ್ನು ಬಹಿರಂಗಪಡಿಸಬಹುದು ಮತ್ತು ಕಾನೂನುಬದ್ಧವಾಗಿ ಹಾಗೆ ಮಾಡುವುದನ್ನು ನಿಷೇಧಿಸದ ​​ಹೊರತು ನಿಮಗೆ ತಿಳಿಸುತ್ತೇವೆ.",
  "legalPrivacySharingSubprocessors": "ಸಬ್‌ಪ್ರೊಸೆಸರ್‌ಗಳು: ಸಮಾನವಾದ ರಕ್ಷಣೆಗಳ ಅಗತ್ಯವಿರುವ ಡೇಟಾ-ಪ್ರೊಸೆಸಿಂಗ್ ಒಪ್ಪಂದಗಳ ಅಡಿಯಲ್ಲಿ ನಾವು ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಸಬ್‌ಪ್ರೊಸೆಸರ್‌ಗಳನ್ನು ತೊಡಗಿಸಿಕೊಳ್ಳುತ್ತೇವೆ. ಪ್ರಮುಖ ವಿಭಾಗಗಳು: (i) ಕ್ಲೌಡ್ ಮೂಲಸೌಕರ್ಯ - AWS (ನಿಮ್ಮ ದೇಶಕ್ಕೆ ಹತ್ತಿರವಿರುವ ಪ್ರದೇಶದಲ್ಲಿ ಡೇಟಾ ಹೋಸ್ಟ್ ಮಾಡಲಾಗಿದೆ); (ii) ಪಾವತಿ ಪ್ರಕ್ರಿಯೆ - ಪಟ್ಟಿ; (iii) ದೋಷ ಮೇಲ್ವಿಚಾರಣೆ - ಸೆಂಟ್ರಿ; (iv) ಅನಾಲಿಟಿಕ್ಸ್ - ವರ್ಸೆಲ್; (v) AI ಮಾದರಿ ಪೂರೈಕೆದಾರರು - OpenAI ಮತ್ತು DeepSeek (AI ವಿಶ್ಲೇಷಣೆ ಮತ್ತು ಎಂಬೆಡಿಂಗ್‌ಗಳು); ಡೀಪ್‌ಗ್ರಾಮ್ (ಸಭೆಯ ಪ್ರತಿಲೇಖನ) - ಲಭ್ಯವಿರುವಲ್ಲಿ ಶೂನ್ಯ-ಡೇಟಾ-ಧಾರಣ API ಒಪ್ಪಂದಗಳ ಅಡಿಯಲ್ಲಿ ಪ್ರಶ್ನೆಗಳನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ; (vi) ಇಮೇಲ್ ವಿತರಣೆ - ಮರುಕಳುಹಿಸಿ.",
  "legalPrivacyTitle": "ಗೌಪ್ಯತೆ ನೀತಿ",
  "legalPrivacyTransfersBody": "ನಿಮ್ಮ ಡೇಟಾವನ್ನು ನೀವು ವಾಸಿಸುವ ದೇಶದ ಹೊರಗೆ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಬಹುದು. ಯುಕೆ/ಇಯುನಿಂದ ವರ್ಗಾವಣೆಗಳಿಗಾಗಿ, ನಾವು ಯುರೋಪಿಯನ್ ಕಮಿಷನ್ ಮತ್ತು ಯುಕೆ ಐಸಿಒ ಅನುಮೋದಿಸಿದ ಪ್ರಮಾಣಿತ ಒಪ್ಪಂದದ ಷರತ್ತುಗಳನ್ನು (ಎಸ್‌ಸಿಸಿ) ಅವಲಂಬಿಸಿದ್ದೇವೆ. ಭಾರತಕ್ಕೆ ಸಂಬಂಧಿಸಿದಂತೆ, ವರ್ಗಾವಣೆಗಳು ಗಡಿಯಾಚೆಗಿನ ಡೇಟಾ ಹರಿವಿನ ಮೇಲೆ DPDP ಕಾಯಿದೆಯ ನಿಬಂಧನೆಗಳನ್ನು ಅನುಸರಿಸುತ್ತವೆ. ಕೀನ್ಯಾಗೆ ಸಂಬಂಧಿಸಿದಂತೆ, ವರ್ಗಾವಣೆಗಳು ಕೀನ್ಯಾ ಡೇಟಾ ಸಂರಕ್ಷಣಾ ಕಾಯಿದೆ 2019 ರ ವಿಭಾಗ 48 ಕ್ಕೆ ಅನುಗುಣವಾಗಿರುತ್ತವೆ. ಎಂಟರ್‌ಪ್ರೈಸ್ ಬಾಡಿಗೆದಾರರು ಆಡಳಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಮೂಲಕ ಡೇಟಾ ರೆಸಿಡೆನ್ಸಿ ನಿರ್ಬಂಧಗಳನ್ನು ವಿನಂತಿಸಬಹುದು.",
  "legalPrivacyTransfersHeading": "10. ಅಂತರಾಷ್ಟ್ರೀಯ ವರ್ಗಾವಣೆಗಳು",
  "legalPrivacyUseBody": "ನಾವು ಸಂಗ್ರಹಿಸಿದ ಡೇಟಾವನ್ನು ಇದಕ್ಕಾಗಿ ಬಳಸುತ್ತೇವೆ: (ಎ) ನಿಮ್ಮ ಖಾತೆಯನ್ನು ರಚಿಸಲು ಮತ್ತು ನಿರ್ವಹಿಸಲು; (ಬಿ) AI ಕಾನೂನು ವಿಶ್ಲೇಷಣೆ, ಮ್ಯಾಟರ್ ಮ್ಯಾನೇಜ್ಮೆಂಟ್, ಬಿಲ್ಲಿಂಗ್, ಸಂಶೋಧನೆ ಮತ್ತು ಇತರ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ತಲುಪಿಸುವುದು; (ಸಿ) ಪಾವತಿಗಳನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಿ ಮತ್ತು ಇನ್‌ವಾಯ್ಸ್‌ಗಳನ್ನು ಕಳುಹಿಸಿ; (ಡಿ) ವಹಿವಾಟಿನ ಇಮೇಲ್‌ಗಳನ್ನು ಕಳುಹಿಸಿ (ಖಾತೆ ದೃಢೀಕರಣ, ಪಾಸ್‌ವರ್ಡ್ ರೀಸೆಟ್, ಬಿಲ್ಲಿಂಗ್ ರಸೀದಿಗಳು); (ಇ) ವಂಚನೆ, ಭದ್ರತಾ ಘಟನೆಗಳು ಮತ್ತು ದುರುಪಯೋಗವನ್ನು ಪತ್ತೆಹಚ್ಚಿ, ತನಿಖೆ ಮಾಡಿ ಮತ್ತು ತಡೆಯಿರಿ; (ಎಫ್) ನ್ಯಾಯಾಲಯದ ಆದೇಶಗಳು ಮತ್ತು ನಿಯಂತ್ರಕ ಅವಶ್ಯಕತೆಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಕಾನೂನು ಬಾಧ್ಯತೆಗಳನ್ನು ಅನುಸರಿಸುವುದು; (ಜಿ) ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸುಧಾರಿಸಲು ಒಟ್ಟು ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಬಳಕೆಯನ್ನು ವಿಶ್ಲೇಷಿಸಿ (ಅನಾಮಧೇಯ ಅಥವಾ ಗುಪ್ತನಾಮದ ಡೇಟಾವನ್ನು ಮಾತ್ರ ಬಳಸುವುದು); (h) ನೀವು ಆಯ್ಕೆ ಮಾಡಿದ ಮಾರ್ಕೆಟಿಂಗ್ ಸಂವಹನಗಳನ್ನು ಕಳುಹಿಸಿ (ನೀವು ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಸಮ್ಮತಿಯನ್ನು ಹಿಂಪಡೆಯಬಹುದು).",
  "legalPrivacyUseHeading": "4. ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ನಾವು ಹೇಗೆ ಬಳಸುತ್ತೇವೆ",
  "legalPublisherName": "DVTech Ventures",
  "legalStandardDisclaimer": "ಅಂಬ್ರೆಲಾ ಕಾನೂನು ಮಾಹಿತಿ, ದಾಖಲೆ ವಿವರಣೆಗಳು, ಸಮಸ್ಯೆ ಗುರುತಿಸುವಿಕೆ ಮತ್ತು ಅಪಾಯದ ವಿಶ್ಲೇಷಣೆಯನ್ನು ಒದಗಿಸುತ್ತದೆ. ಇದು ಕಾನೂನು ಸಂಸ್ಥೆಯಲ್ಲ ಮತ್ತು ಪರವಾನಗಿ ಪಡೆದ ವಕೀಲರನ್ನು ಬದಲಿಸುವುದಿಲ್ಲ. ನಿಮ್ಮ ಪರಿಸ್ಥಿತಿಗೆ ನಿರ್ದಿಷ್ಟವಾದ ಕಾನೂನು ಸಲಹೆಗಾಗಿ, ನಿಮ್ಮ ಅಧಿಕಾರ ವ್ಯಾಪ್ತಿಯಲ್ಲಿ ಅರ್ಹ ವಕೀಲರನ್ನು ಸಂಪರ್ಕಿಸಿ.",
  "legalTermsAIOutputsBody": "AI ಔಟ್‌ಪುಟ್‌ಗಳನ್ನು ದೊಡ್ಡ ಭಾಷಾ ಮಾದರಿಗಳಿಂದ ರಚಿಸಲಾಗಿದೆ ಮತ್ತು ಮಾಹಿತಿ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಮಾತ್ರ ಒದಗಿಸಲಾಗಿದೆ. ಅವರು ಕಾನೂನು ಸಲಹೆಯನ್ನು ಹೊಂದಿರುವುದಿಲ್ಲ, ವಕೀಲ-ಕ್ಲೈಂಟ್ ಸಂಬಂಧವನ್ನು ರಚಿಸುವುದಿಲ್ಲ ಮತ್ತು ಅರ್ಹ ವಕೀಲರ ಸಲಹೆಗಾಗಿ ಬದಲಿಯಾಗಿ ಅವಲಂಬಿಸಬಾರದು. AI ಔಟ್‌ಪುಟ್‌ಗಳು ಅಪೂರ್ಣವಾಗಿರಬಹುದು, ತಪ್ಪಾಗಿರಬಹುದು ಅಥವಾ ಹಳೆಯದಾಗಿರಬಹುದು. ಕಾನೂನುಗಳು ಮತ್ತು ಪ್ರಕರಣಗಳ ಉಲ್ಲೇಖಗಳನ್ನು ಸ್ವತಂತ್ರವಾಗಿ ಪರಿಶೀಲಿಸಬೇಕು. AI ಔಟ್‌ಪುಟ್‌ಗಳ ಆಧಾರದ ಮೇಲೆ ತೆಗೆದುಕೊಂಡ ಯಾವುದೇ ಕ್ರಮಕ್ಕೆ ನೀವು ಮಾತ್ರ ಜವಾಬ್ದಾರರಾಗಿರುತ್ತೀರಿ.",
  "legalTermsAIOutputsHeading": "9. AI ಔಟ್‌ಪುಟ್‌ಗಳ ಸ್ವರೂಪ",
  "legalTermsAccountBody": "ನೀವು ನಿಖರವಾದ ಮತ್ತು ಸಂಪೂರ್ಣ ನೋಂದಣಿ ಮಾಹಿತಿಯನ್ನು ಒದಗಿಸಬೇಕು ಮತ್ತು ಅದನ್ನು ನವೀಕರಿಸಬೇಕು. ನಿಮ್ಮ ರುಜುವಾತುಗಳ ಗೌಪ್ಯತೆಯನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳಲು ಮತ್ತು ನಿಮ್ಮ ಖಾತೆಯ ಅಡಿಯಲ್ಲಿ ಎಲ್ಲಾ ಚಟುವಟಿಕೆಗಳಿಗೆ ನೀವು ಜವಾಬ್ದಾರರಾಗಿರುತ್ತೀರಿ. support@odaflow.com ನಲ್ಲಿ ಯಾವುದೇ ಅನಧಿಕೃತ ಪ್ರವೇಶದ ಕುರಿತು ನೀವು ತಕ್ಷಣ ನಮಗೆ ಸೂಚಿಸಬೇಕು. ಈ ನಿಯಮಗಳನ್ನು ಉಲ್ಲಂಘಿಸುವ ಖಾತೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುವ ಹಕ್ಕನ್ನು ನಾವು ಕಾಯ್ದಿರಿಸಿದ್ದೇವೆ ಅಥವಾ ರಾಜಿ ಮಾಡಿಕೊಂಡಿದ್ದೇವೆ ಎಂದು ನಾವು ಸಮಂಜಸವಾಗಿ ಅನುಮಾನಿಸುತ್ತೇವೆ.",
  "legalTermsAccountHeading": "3. ಖಾತೆ ನೋಂದಣಿ",
  "legalTermsAgreementBody": "ಖಾತೆಯನ್ನು ರಚಿಸುವ ಮೂಲಕ ಅಥವಾ ಯಾವುದೇ ಅಂಬ್ರೆಲಾ ಸೇವೆಯನ್ನು ಬಳಸುವ ಮೂಲಕ, ನೀವು ಈ ನಿಯಮಗಳಿಗೆ ಬದ್ಧರಾಗಿರಲು ಒಪ್ಪುತ್ತೀರಿ. ನೀವು ಕಾನೂನು ಸಂಸ್ಥೆ, ಕಂಪನಿ ಅಥವಾ ಇತರ ಕಾನೂನು ಘಟಕದ ಪರವಾಗಿ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು ಬಳಸುತ್ತಿದ್ದರೆ, ಆ ಘಟಕವನ್ನು ಬಂಧಿಸಲು ನಿಮಗೆ ಅಧಿಕಾರವಿದೆ ಎಂದು ನೀವು ಪ್ರತಿನಿಧಿಸುತ್ತೀರಿ. ನೀವು ಈ ನಿಯಮಗಳನ್ನು ಒಪ್ಪಿಕೊಳ್ಳದಿದ್ದರೆ, ನೀವು ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು ಬಳಸಬಾರದು. ಬಳಕೆದಾರರು ಕನಿಷ್ಠ 18 ವರ್ಷ ವಯಸ್ಸಿನವರಾಗಿರಬೇಕು.",
  "legalTermsAgreementHeading": "1. ಸ್ವೀಕಾರ",
  "legalTermsChangesBody": "ನಾವು ಈ ನಿಯಮಗಳನ್ನು ಕಾಲಕಾಲಕ್ಕೆ ನವೀಕರಿಸಬಹುದು. ವಸ್ತು ಬದಲಾವಣೆಗಳನ್ನು ಇಮೇಲ್ ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿನ ಅಧಿಸೂಚನೆಯ ಮೂಲಕ ಅವು ಪರಿಣಾಮ ಬೀರುವ ಕನಿಷ್ಠ 30 ದಿನಗಳ ಮೊದಲು ತಿಳಿಸಲಾಗುತ್ತದೆ. ಪರಿಣಾಮಕಾರಿ ದಿನಾಂಕದ ನಂತರ ಮುಂದುವರಿದ ಬಳಕೆಯು ಸ್ವೀಕಾರವನ್ನು ರೂಪಿಸುತ್ತದೆ.",
  "legalTermsChangesHeading": "20. ಈ ನಿಯಮಗಳಿಗೆ ಬದಲಾವಣೆಗಳು",
  "legalTermsConfidentialityBody": "ನಿಮ್ಮ ವಿಷಯ ಮತ್ತು ವಿಷಯದ ಡೇಟಾವನ್ನು ನಾವು ಗೌಪ್ಯವಾಗಿ ಪರಿಗಣಿಸುತ್ತೇವೆ ಮತ್ತು ನಮ್ಮ ಗೌಪ್ಯತೆ ನೀತಿಯಲ್ಲಿ ವಿವರಿಸಿದಂತೆ ಅಥವಾ ಕಾನೂನಿನ ಪ್ರಕಾರ ಹೊರತುಪಡಿಸಿ ಅದನ್ನು ಮೂರನೇ ವ್ಯಕ್ತಿಗಳಿಗೆ ಬಹಿರಂಗಪಡಿಸುವುದಿಲ್ಲ. ವಕೀಲ ಬಳಕೆದಾರರು ಕ್ಲೈಂಟ್-ಗೌಪ್ಯ ಸಂವಹನಗಳು ಅನ್ವಯವಾಗುವ ವೃತ್ತಿಪರ ಸವಲತ್ತು ನಿಯಮಗಳಿಗೆ ಅನುಗುಣವಾಗಿರುವುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಬೇಕು. ಬಾಡಿಗೆದಾರರ ಡೇಟಾವನ್ನು ಪ್ರತ್ಯೇಕಿಸಲು ನಮ್ಮ ಸಿಸ್ಟಂಗಳನ್ನು ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ.",
  "legalTermsConfidentialityHeading": "13. ಗೌಪ್ಯತೆ",
  "legalTermsContactBody": "ಈ ನಿಯಮಗಳ ಕುರಿತು ಪ್ರಶ್ನೆಗಳು: support@odaflow.com. ಡಿವಿಟೆಕ್ ವೆಂಚರ್ಸ್, ನೋಂದಾಯಿತ ಕಚೇರಿ ವಿವರಗಳು ವಿನಂತಿಯ ಮೇರೆಗೆ ಲಭ್ಯವಿದೆ.",
  "legalTermsContactHeading": "21. ಸಂಪರ್ಕಿಸಿ",
  "legalTermsDataBody": "ನಮ್ಮ ವೈಯಕ್ತಿಕ ಡೇಟಾದ ಸಂಗ್ರಹಣೆ ಮತ್ತು ಬಳಕೆಯನ್ನು ಗೌಪ್ಯತೆ ನೀತಿಯಲ್ಲಿ ವಿವರಿಸಲಾಗಿದೆ. ಡೇಟಾ ಮತ್ತು AI ಸಮ್ಮತಿ ನೀತಿಯಲ್ಲಿ ವಿವರಿಸಿದಂತೆ AI ತರಬೇತಿ ಮತ್ತು ವಿಶ್ಲೇಷಣೆಗಳ ಬಳಕೆಗಳಿಗೆ ಸ್ಪಷ್ಟವಾದ ಆಯ್ಕೆಯ ಅಗತ್ಯವಿರುತ್ತದೆ.",
  "legalTermsDataConsentLink": "ಡೇಟಾ ಮತ್ತು AI ಸಮ್ಮತಿ ನೀತಿ",
  "legalTermsDataHeading": "15. ಡೇಟಾ ಮತ್ತು ಗೌಪ್ಯತೆ",
  "legalTermsDataPrivacyLink": "ಗೌಪ್ಯತೆ ನೀತಿ",
  "legalTermsDefinitionsBody": "\"ಪ್ಲಾಟ್‌ಫಾರ್ಮ್\" ಎಂದರೆ umbrella.okaylegal.ai ಮತ್ತು ಎಲ್ಲಾ ಸಂಬಂಧಿತ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು, APIಗಳು ಮತ್ತು ಸೇವೆಗಳು. \"ಗ್ರಾಹಕ ಬಳಕೆದಾರ\" ಎಂದರೆ ತಮ್ಮದೇ ಆದ ಕಾನೂನು ಪರಿಸ್ಥಿತಿಯನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ವೇದಿಕೆಯನ್ನು ಬಳಸುವ ನೈಸರ್ಗಿಕ ವ್ಯಕ್ತಿ. \"ವಕೀಲ ಬಳಕೆದಾರ\" ಎಂದರೆ ಲಾಯರ್ ಓಎಸ್ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಪರವಾನಗಿ ಪಡೆದ ಕಾನೂನು ವೃತ್ತಿಪರ. \"ಹಿಡುವಳಿದಾರ\" ಎಂದರೆ ಕಾನೂನು ಸಂಸ್ಥೆ ಅಥವಾ ಸಂಸ್ಥೆಯ ಚಂದಾದಾರಿಕೆ ಹೊಂದಿರುವ ಸಂಸ್ಥೆ. \"AI ಔಟ್‌ಪುಟ್\" ಎಂದರೆ ಅಂಬ್ರೆಲ್ಲಾದ AI ವ್ಯವಸ್ಥೆಗಳಿಂದ ರಚಿಸಲಾದ ಯಾವುದೇ ಪಠ್ಯ, ವಿಶ್ಲೇಷಣೆ, ಕರಡು ಅಥವಾ ಶಿಫಾರಸು. \"ಮ್ಯಾಟರ್\" ಎಂದರೆ ಲಾಯರ್ ಓಎಸ್ ಮೂಲಕ ನಿರ್ವಹಿಸಲಾದ ಕಾನೂನು ಪ್ರಕರಣ ಅಥವಾ ವಹಿವಾಟು. \"DVTech ವೆಂಚರ್ಸ್\" ಅಥವಾ \"ನಾವು\" ಎಂದರೆ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ನ ಆಪರೇಟರ್.",
  "legalTermsDefinitionsHeading": "2. ವ್ಯಾಖ್ಯಾನಗಳು",
  "legalTermsDescription": "ಈ ನಿಯಮಗಳು ನಿಮ್ಮ ಅಂಬ್ರೆಲಾ ಬಳಕೆಯನ್ನು ನಿಯಂತ್ರಿಸುತ್ತವೆ - DVTech ವೆಂಚರ್ಸ್ ನಿರ್ವಹಿಸುವ AI-ಸ್ಥಳೀಯ ಕಾನೂನು ವೇದಿಕೆ. ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ನ ಯಾವುದೇ ಭಾಗವನ್ನು ಬಳಸುವ ಮೊದಲು ದಯವಿಟ್ಟು ಅವುಗಳನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಓದಿ.",
  "legalTermsDisputeBody": "ಭಾರತದ ಬಳಕೆದಾರರು: ಈ ನಿಯಮಗಳನ್ನು ಭಾರತದ ಕಾನೂನುಗಳಿಂದ ನಿಯಂತ್ರಿಸಲಾಗುತ್ತದೆ; ಬೆಂಗಳೂರಿನಲ್ಲಿ ಕುಳಿತು ಮಧ್ಯಸ್ಥಿಕೆ ಮತ್ತು ರಾಜಿ ಕಾಯಿದೆ 1996 ರ ಅಡಿಯಲ್ಲಿ ಮಧ್ಯಸ್ಥಿಕೆಯನ್ನು ಬಂಧಿಸುವ ಮೂಲಕ ವಿವಾದಗಳನ್ನು ಪರಿಹರಿಸಲಾಗುತ್ತದೆ. ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್ ಬಳಕೆದಾರರು: ವಿವಾದಗಳನ್ನು ಡೆಲವೇರ್‌ನಲ್ಲಿ ಕುಳಿತಿರುವ AAA ವಾಣಿಜ್ಯ ಮಧ್ಯಸ್ಥಿಕೆ ನಿಯಮಗಳ ಅಡಿಯಲ್ಲಿ ಬಂಧಿಸುವ ಮಧ್ಯಸ್ಥಿಕೆಯಿಂದ ಪರಿಹರಿಸಲಾಗುತ್ತದೆ; ವರ್ಗ ಕ್ರಿಯೆ ಮನ್ನಾ ಅನ್ವಯಿಸುತ್ತದೆ. ಕೀನ್ಯಾ ಬಳಕೆದಾರರು: ಈ ನಿಯಮಗಳನ್ನು ಕೀನ್ಯಾದ ಕಾನೂನುಗಳಿಂದ ನಿಯಂತ್ರಿಸಲಾಗುತ್ತದೆ; ವಿವಾದಗಳನ್ನು ನೈರೋಬಿ ಸೆಂಟರ್ ಫಾರ್ ಇಂಟರ್ನ್ಯಾಷನಲ್ ಆರ್ಬಿಟ್ರೇಶನ್ (NCIA) ನಿಯಮಗಳ ಅಡಿಯಲ್ಲಿ ಪರಿಹರಿಸಲಾಗುತ್ತದೆ. ಯುನೈಟೆಡ್ ಕಿಂಗ್‌ಡಮ್ ಬಳಕೆದಾರರು: ಈ ನಿಯಮಗಳನ್ನು ಇಂಗ್ಲಿಷ್ ಕಾನೂನಿನಿಂದ ನಿಯಂತ್ರಿಸಲಾಗುತ್ತದೆ; ವಿವಾದಗಳನ್ನು ಇಂಗ್ಲೆಂಡ್ ಮತ್ತು ವೇಲ್ಸ್ ನ್ಯಾಯಾಲಯಗಳ ವಿಶೇಷ ನ್ಯಾಯವ್ಯಾಪ್ತಿಗೆ ಸಲ್ಲಿಸಲಾಗುತ್ತದೆ. ಎಲ್ಲಾ ಸಂದರ್ಭಗಳಲ್ಲಿ, ಸಮರ್ಥ ನ್ಯಾಯಾಲಯದಿಂದ ತುರ್ತು ತಡೆಯಾಜ್ಞೆ ಪರಿಹಾರವನ್ನು ಪಡೆಯಲು ಯಾವುದೂ ನಿಮ್ಮನ್ನು ತಡೆಯುವುದಿಲ್ಲ.",
  "legalTermsDisputeHeading": "18. ವಿವಾದ ಪರಿಹಾರ ಮತ್ತು ಆಡಳಿತ ಕಾನೂನು",
  "legalTermsIPContentBody": "ನೀವು ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ಗೆ ಸಲ್ಲಿಸುವ ಎಲ್ಲಾ ವಿಷಯಗಳ ಮಾಲೀಕತ್ವವನ್ನು ನೀವು ಉಳಿಸಿಕೊಳ್ಳುತ್ತೀರಿ. ವಿಷಯವನ್ನು ಸಲ್ಲಿಸುವ ಮೂಲಕ ನೀವು DVTech ವೆಂಚರ್‌ಗಳಿಗೆ ವಿಶ್ವಾದ್ಯಂತ, ರಾಯಧನ-ಮುಕ್ತ, ಸೇವೆಗಳನ್ನು ತಲುಪಿಸಲು ನಿಮ್ಮ ವಿಷಯವನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಲು, ಸಂಗ್ರಹಿಸಲು ಮತ್ತು ಪ್ರದರ್ಶಿಸಲು ವಿಶೇಷವಲ್ಲದ ಪರವಾನಗಿಯನ್ನು ನೀಡುತ್ತೀರಿ. ಡೇಟಾ ಮತ್ತು AI ಸಮ್ಮತಿ ನೀತಿಯ ಅಡಿಯಲ್ಲಿ ನೀವು ಆಯ್ಕೆ ಮಾಡದ ಹೊರತು ಈ ಪರವಾನಗಿ AI ತರಬೇತಿಗೆ ವಿಸ್ತರಿಸುವುದಿಲ್ಲ.",
  "legalTermsIPHeading": "12. ಬೌದ್ಧಿಕ ಆಸ್ತಿ",
  "legalTermsIPPlatformBody": "DVTech ವೆಂಚರ್ಸ್ ಅಂಬ್ರೆಲಾ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್, ಬ್ರ್ಯಾಂಡ್, ಆಧಾರವಾಗಿರುವ AI ಮಾದರಿಗಳು ಮತ್ತು ತಂತ್ರಜ್ಞಾನದಲ್ಲಿ ಎಲ್ಲಾ ಹಕ್ಕುಗಳನ್ನು ಹೊಂದಿದೆ. ನಿಮ್ಮ ಚಂದಾದಾರಿಕೆಯ ಅವಧಿಯವರೆಗೆ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸೀಮಿತ, ವಿಶೇಷವಲ್ಲದ, ವರ್ಗಾವಣೆ ಮಾಡಲಾಗದ ಪರವಾನಗಿಯನ್ನು ನೀಡಲಾಗಿದೆ.",
  "legalTermsIndemnityBody": "ನಿರುಪದ್ರವಿ DVTech ವೆಂಚರ್‌ಗಳು ಮತ್ತು ಅದರ ಅಧಿಕಾರಿಗಳು, ನಿರ್ದೇಶಕರು, ಉದ್ಯೋಗಿಗಳು ಮತ್ತು ಏಜೆಂಟರುಗಳಿಂದ ಉಂಟಾಗುವ ಯಾವುದೇ ಕ್ಲೈಮ್‌ಗಳು, ಹಾನಿಗಳು, ನಷ್ಟಗಳು ಮತ್ತು ವೆಚ್ಚಗಳಿಂದ (ಸಮಂಜಸವಾದ ಕಾನೂನು ಶುಲ್ಕಗಳನ್ನು ಒಳಗೊಂಡಂತೆ) ನಷ್ಟವನ್ನು ತುಂಬಲು, ರಕ್ಷಿಸಲು ಮತ್ತು ಹಿಡಿದಿಡಲು ನೀವು ಒಪ್ಪುತ್ತೀರಿ: (a) ಈ ನಿಯಮಗಳನ್ನು ಉಲ್ಲಂಘಿಸಿ ನಿಮ್ಮ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಬಳಕೆ; (ಬಿ) ಯಾವುದೇ ಅನ್ವಯವಾಗುವ ಕಾನೂನಿನ ನಿಮ್ಮ ಉಲ್ಲಂಘನೆ; (ಸಿ) ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಹಕ್ಕುಗಳನ್ನು ಉಲ್ಲಂಘಿಸುವ ನೀವು ಸಲ್ಲಿಸುವ ವಿಷಯ; (ಡಿ) ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ನಿಮ್ಮ ಗ್ರಾಹಕರಿಗೆ ನೀವು ಒದಗಿಸುವ ಕಾನೂನು ಸಲಹೆ ಅಥವಾ ಸೇವೆಗಳು.",
  "legalTermsIndemnityHeading": "17. ನಷ್ಟ ಪರಿಹಾರ",
  "legalTermsLawyerUsersBody": "ವಕೀಲ ಬಳಕೆದಾರರು ಸ್ವತಂತ್ರ ಪರವಾನಗಿ ಪಡೆದ ವೃತ್ತಿಪರರು. ವಕೀಲರ OS ಅನ್ನು ಬಳಸುವ ಮೂಲಕ, ನಿಮ್ಮ ಅಧಿಕಾರ ವ್ಯಾಪ್ತಿಯಲ್ಲಿ ನೀವು ಮಾನ್ಯವಾದ ಅಭ್ಯಾಸ ಪ್ರಮಾಣಪತ್ರವನ್ನು ಹೊಂದಿರುವಿರಿ ಮತ್ತು ಅನ್ವಯವಾಗುವ ವೃತ್ತಿಪರ ನಡವಳಿಕೆಯ ನಿಯಮಗಳು ಮತ್ತು ಬಾರ್ ನಿಯಮಗಳಿಗೆ ಅನುಸಾರವಾಗಿ ನೀವು ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು ಬಳಸುತ್ತೀರಿ ಎಂದು ನೀವು ಖಚಿತಪಡಿಸುತ್ತೀರಿ. ನಿಮ್ಮ ಗ್ರಾಹಕರಿಗೆ ನೀವು ಒದಗಿಸುವ ಎಲ್ಲಾ ಕಾನೂನು ಕೆಲಸಗಳು ಮತ್ತು ಸಲಹೆಗಳ ಗುಣಮಟ್ಟ ಮತ್ತು ಕಾನೂನುಬದ್ಧತೆಗೆ ನೀವು ಮಾತ್ರ ಜವಾಬ್ದಾರರಾಗಿರುತ್ತೀರಿ. ಅಂಬ್ರೆಲಾ ಉಪಕರಣಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ - ಇದು ವಕೀಲ ಬಳಕೆದಾರರ ವೃತ್ತಿಪರ ನಡವಳಿಕೆಯನ್ನು ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡುವುದಿಲ್ಲ ಅಥವಾ ಖಾತರಿಪಡಿಸುವುದಿಲ್ಲ.",
  "legalTermsLawyerUsersHeading": "11. ವಕೀಲ ಬಳಕೆದಾರರು",
  "legalTermsLiabilityBody": "ಅನ್ವಯವಾಗುವ ಕಾನೂನಿನಿಂದ ಅನುಮತಿಸಲಾದ ಗರಿಷ್ಠ ಮಟ್ಟಿಗೆ: (ಎ) ಈ ನಿಯಮಗಳಿಂದ ಅಥವಾ ಅದಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಯಾವುದೇ ಕ್ಲೈಮ್‌ಗೆ DVTECH ವೆಂಚರ್ಸ್‌ನ ಒಟ್ಟು ಹೊಣೆಗಾರಿಕೆ ಅಥವಾ ಅದರ ಬಳಕೆಗೆ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಮಿತಿ ಕ್ಲೈಮ್‌ಗೆ ಮುಂಚಿನ 12 ತಿಂಗಳುಗಳು; (ಬಿ) ಪರೋಕ್ಷ, ಪ್ರಾಸಂಗಿಕ, ವಿಶೇಷ, ಅನುಕ್ರಮ, ಅಥವಾ ದಂಡನೀಯ ಹಾನಿಗಳು, ಲಾಭದ ನಷ್ಟ, ಡೇಟಾದ ನಷ್ಟ ಅಥವಾ ಸದ್ಭಾವನೆಯ ನಷ್ಟಕ್ಕೆ ನಾವು ಜವಾಬ್ದಾರರಲ್ಲ. ಅಂತಹ ಹಾನಿಗಳ ಸಾಧ್ಯತೆಯ ಬಗ್ಗೆ ನಮಗೆ ಸಲಹೆ ನೀಡಿದ್ದರೂ ಮತ್ತು ಕಾನೂನು ಸಿದ್ಧಾಂತವನ್ನು ಪ್ರತಿಪಾದಿಸಿದರೂ ಸಹ ಈ ಮಿತಿಗಳು ಅನ್ವಯಿಸುತ್ತವೆ.",
  "legalTermsLiabilityHeading": "16. ಹೊಣೆಗಾರಿಕೆಯ ಮಿತಿ",
  "legalTermsNotLawFirmBody": "ಅಂಬ್ರೆಲಾ ಒಂದು ತಂತ್ರಜ್ಞಾನ ವೇದಿಕೆಯಾಗಿದೆ, ಕಾನೂನು ಸಂಸ್ಥೆಯಲ್ಲ. DVTech ವೆಂಚರ್ಸ್ ಕಾನೂನು ಸಲಹೆ ಅಥವಾ ಕಾನೂನು ಪ್ರಾತಿನಿಧ್ಯವನ್ನು ಒದಗಿಸುವುದಿಲ್ಲ. ವೇದಿಕೆಯ ಬಳಕೆಯು ನಿಮ್ಮ ಮತ್ತು DVTech ವೆಂಚರ್ಸ್ ನಡುವೆ ವಕೀಲ-ಕ್ಲೈಂಟ್ ಸಂಬಂಧವನ್ನು ಸೃಷ್ಟಿಸುವುದಿಲ್ಲ. ವಕೀಲರ ಮಾರುಕಟ್ಟೆಯು ಸ್ವತಂತ್ರ ಪರವಾನಗಿ ಪಡೆದ ವಕೀಲರೊಂದಿಗೆ ನಿಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸುತ್ತದೆ; ಮಾರುಕಟ್ಟೆಯ ವಕೀಲರೊಂದಿಗಿನ ಯಾವುದೇ ನಿಶ್ಚಿತಾರ್ಥವು ನಿಮ್ಮ ಮತ್ತು ಆ ವಕೀಲರ ನಡುವಿನ ಪ್ರತ್ಯೇಕ ಧಾರಕ ಒಪ್ಪಂದದಿಂದ ನಿಯಂತ್ರಿಸಲ್ಪಡುತ್ತದೆ.",
  "legalTermsNotLawFirmHeading": "10. ಕಾನೂನು ಸಂಸ್ಥೆಯಲ್ಲ",
  "legalTermsOfService": "ಸೇವಾ ನಿಯಮಗಳು",
  "legalTermsPermittedUseBody": "ನೀವು ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು ಬಳಸಬಹುದು: ವೈಯಕ್ತಿಕ ಅಥವಾ ವೃತ್ತಿಪರ ಬಳಕೆಗಾಗಿ AI- ರಚಿತವಾದ ಕಾನೂನು ಮಾಹಿತಿಯನ್ನು ಪಡೆದುಕೊಳ್ಳಿ; ಕಾನೂನು ವಿಷಯಗಳು, ಗ್ರಾಹಕರು, ಬಿಲ್ಲಿಂಗ್ ಮತ್ತು ದಾಖಲೆಗಳನ್ನು ನಿರ್ವಹಿಸಿ (ವಕೀಲ ಓಎಸ್); ಪರವಾನಗಿ ಪಡೆದ ವಕೀಲರೊಂದಿಗೆ ಸಂಪರ್ಕಿಸಲು ವಕೀಲ ಮಾರುಕಟ್ಟೆಯನ್ನು ಪ್ರವೇಶಿಸಿ; ಮತ್ತು ನಮ್ಮ ದಾಖಲಿತ API ಮೂಲಕ ನಿಮ್ಮ ಸಿಸ್ಟಮ್‌ಗಳೊಂದಿಗೆ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು ಸಂಯೋಜಿಸಿ.",
  "legalTermsPermittedUseHeading": "4. ಅನುಮತಿಸಲಾದ ಬಳಕೆ",
  "legalTermsProhibitedUseBody": "ನೀವು ಮಾಡಬಾರದು: (ಎ) ವಕೀಲರು, ನ್ಯಾಯಾಧೀಶರು ಅಥವಾ ಸರ್ಕಾರಿ ಅಧಿಕಾರಿಯಂತೆ ನಟಿಸುವುದು; (ಬಿ) ವಕೀಲರ ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ ಮೂರನೇ ವ್ಯಕ್ತಿಗಳಿಗೆ ಔಪಚಾರಿಕ ಕಾನೂನು ಸಲಹೆಯಾಗಿ AI ಔಟ್‌ಪುಟ್‌ಗಳನ್ನು ಬಳಸಿ; (ಸಿ) ಕಾನೂನುಬಾಹಿರ, ಮಾನಹಾನಿಕರ ಅಥವಾ ಮೋಸದ ವಿಷಯವನ್ನು ಸಲ್ಲಿಸಿ; (ಡಿ) ಆಧಾರವಾಗಿರುವ AI ಮಾದರಿಗಳು ಅಥವಾ ತರಬೇತಿ ಡೇಟಾವನ್ನು ರಿವರ್ಸ್-ಎಂಜಿನಿಯರ್ ಮಾಡಲು, ಸ್ಕ್ರ್ಯಾಪ್ ಮಾಡಲು ಅಥವಾ ಹೊರತೆಗೆಯಲು ಪ್ರಯತ್ನಿಸುವುದು; (ಇ) ಲಿಖಿತ ಒಪ್ಪಿಗೆಯಿಲ್ಲದೆ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ಗೆ ಮರುಮಾರಾಟ ಅಥವಾ ಉಪಪರವಾನಗಿ ಪ್ರವೇಶ; (ಎಫ್) ಡೇಟಾ ರಕ್ಷಣೆ, ಗ್ರಾಹಕ ರಕ್ಷಣೆ ಮತ್ತು ಕಾನೂನು ವೃತ್ತಿಯ ನಿಯಮಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಅನ್ವಯವಾಗುವ ಕಾನೂನನ್ನು ಉಲ್ಲಂಘಿಸುವ ಯಾವುದೇ ರೀತಿಯಲ್ಲಿ ವೇದಿಕೆಯನ್ನು ಬಳಸಿ; (ಜಿ) ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಬೌದ್ಧಿಕ ಆಸ್ತಿ ಹಕ್ಕುಗಳನ್ನು ಉಲ್ಲಂಘಿಸುವ ವಿಷಯವನ್ನು ಸಲ್ಲಿಸಿ.",
  "legalTermsProhibitedUseHeading": "5. ನಿಷೇಧಿತ ಬಳಕೆ",
  "legalTermsRefundBody": "ಖಾತೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ನೀವು ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ನಿಮ್ಮ ಚಂದಾದಾರಿಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಬಹುದು. ಪ್ರಸ್ತುತ ಬಿಲ್ಲಿಂಗ್ ಅವಧಿಯ ಕೊನೆಯಲ್ಲಿ ರದ್ದತಿ ಜಾರಿಗೆ ಬರುತ್ತದೆ; ಬಳಕೆಯಾಗದ ಸಮಯಕ್ಕೆ ಯಾವುದೇ ಭಾಗಶಃ ಮರುಪಾವತಿಯನ್ನು ನೀಡಲಾಗುವುದಿಲ್ಲ. ದೋಷದಿಂದ ನಿಮಗೆ ಶುಲ್ಕ ವಿಧಿಸಲಾಗಿದೆ ಎಂದು ನೀವು ಭಾವಿಸಿದರೆ, ಚಾರ್ಜ್ ಮಾಡಿದ 30 ದಿನಗಳಲ್ಲಿ support@odaflow.com ಅನ್ನು ಸಂಪರ್ಕಿಸಿ. ನಾವು ಪರಿಶೀಲಿಸುತ್ತೇವೆ ಮತ್ತು ಸೂಕ್ತವಾದರೆ, ನಮ್ಮ ವಿವೇಚನೆಯಿಂದ ಪರ-ರಟಾ ಮರುಪಾವತಿಯನ್ನು ನೀಡುತ್ತೇವೆ.",
  "legalTermsRefundHeading": "8. ಮರುಪಾವತಿ ಮತ್ತು ರದ್ದತಿ",
  "legalTermsSeverabilityBody": "ಈ ನಿಯಮಗಳ ಯಾವುದೇ ನಿಬಂಧನೆಯು ಜಾರಿಗೊಳಿಸಲಾಗದು ಎಂದು ಕಂಡುಬಂದರೆ, ಉಳಿದ ನಿಬಂಧನೆಗಳು ಪೂರ್ಣ ಬಲದಲ್ಲಿ ಮುಂದುವರಿಯುತ್ತವೆ. ಯಾವುದೇ ಹಕ್ಕನ್ನು ಜಾರಿಗೊಳಿಸುವಲ್ಲಿ ನಮ್ಮ ವೈಫಲ್ಯವು ಆ ಹಕ್ಕನ್ನು ಬಿಟ್ಟುಕೊಡುವುದಿಲ್ಲ. ಈ ನಿಯಮಗಳು, ಗೌಪ್ಯತೆ ನೀತಿ ಮತ್ತು ಡೇಟಾ ಮತ್ತು AI ಸಮ್ಮತಿ ನೀತಿಯೊಂದಿಗೆ, ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ ನಿಮ್ಮ ಮತ್ತು DVTech ವೆಂಚರ್‌ಗಳ ನಡುವಿನ ಸಂಪೂರ್ಣ ಒಪ್ಪಂದವನ್ನು ರೂಪಿಸುತ್ತವೆ.",
  "legalTermsSeverabilityHeading": "19. ಸಾಮಾನ್ಯ",
  "legalTermsSubscriptionBody": "ಪಾವತಿಸಿದ ಯೋಜನೆಗಳನ್ನು ಮಾಸಿಕ ಅಥವಾ ವಾರ್ಷಿಕ ಚಕ್ರದಲ್ಲಿ ಮುಂಚಿತವಾಗಿ ಬಿಲ್ ಮಾಡಲಾಗುತ್ತದೆ. ಚೆಕ್‌ಔಟ್‌ನಲ್ಲಿ ನಿಮ್ಮ ಸ್ಥಳೀಯ ಕರೆನ್ಸಿಯಲ್ಲಿ ಬೆಲೆಗಳನ್ನು ಪ್ರದರ್ಶಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಅನ್ವಯವಾಗುವ ತೆರಿಗೆಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನವೀಕರಣ ದಿನಾಂಕದ ಮೊದಲು ನೀವು ರದ್ದುಗೊಳಿಸದ ಹೊರತು ಪ್ರತಿ ಬಿಲ್ಲಿಂಗ್ ಅವಧಿಯ ಕೊನೆಯಲ್ಲಿ ಚಂದಾದಾರಿಕೆಗಳು ಸ್ವಯಂ-ನವೀಕರಣಗೊಳ್ಳುತ್ತವೆ. ಪಾವತಿಸಲು ವಿಫಲವಾದರೆ ಪ್ರವೇಶದ ಅಮಾನತು ಅಥವಾ ಮುಕ್ತಾಯಕ್ಕೆ ಕಾರಣವಾಗಬಹುದು.",
  "legalTermsSubscriptionHeading": "6. ಚಂದಾದಾರಿಕೆಗಳು ಮತ್ತು ಬಿಲ್ಲಿಂಗ್",
  "legalTermsTitle": "ಸೇವಾ ನಿಯಮಗಳು",
  "legalTermsTrialBody": "ಸೈನ್-ಅಪ್‌ನಲ್ಲಿ ನಿರ್ದಿಷ್ಟಪಡಿಸಿದಂತೆ ಹೊಸ ಖಾತೆಗಳಿಗೆ ಉಚಿತ ಪ್ರಯೋಗಗಳು ಲಭ್ಯವಿವೆ. ಪ್ರಾಯೋಗಿಕ ಅವಧಿಯ ಕೊನೆಯಲ್ಲಿ, ಪ್ರಾಯೋಗಿಕ ಅವಧಿ ಮುಗಿಯುವ ಮೊದಲು ನೀವು ರದ್ದುಗೊಳಿಸದ ಹೊರತು ನಿಮ್ಮ ಖಾತೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್ವಯವಾಗುವ ದರದಲ್ಲಿ ಪಾವತಿಸಿದ ಚಂದಾದಾರಿಕೆಗೆ ಪರಿವರ್ತನೆಯಾಗುತ್ತದೆ. ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಪ್ರಾಯೋಗಿಕ ಕೊಡುಗೆಗಳನ್ನು ಮಾರ್ಪಡಿಸುವ ಅಥವಾ ನಿಲ್ಲಿಸುವ ಹಕ್ಕನ್ನು ನಾವು ಕಾಯ್ದಿರಿಸಿದ್ದೇವೆ.",
  "legalTermsTrialHeading": "7. ಉಚಿತ ಪ್ರಯೋಗಗಳು",
  "legalTermsWarrantiesBody": "ನಾವು ಸಮರ್ಥಿಸುತ್ತೇವೆ: (ಎ) ನಾವು ವೇದಿಕೆಯನ್ನು ಸಮಂಜಸವಾದ ಕೌಶಲ್ಯ ಮತ್ತು ಕಾಳಜಿಯೊಂದಿಗೆ ಒದಗಿಸುತ್ತೇವೆ; (ಬಿ) ನಾವು ವಾಣಿಜ್ಯಿಕವಾಗಿ ಸಮಂಜಸವಾದ ಭದ್ರತಾ ಅಭ್ಯಾಸಗಳನ್ನು ನಿರ್ವಹಿಸುತ್ತೇವೆ. ಕಾನೂನಿನಿಂದ ಅನುಮತಿಸಲಾದ ಪೂರ್ಣ ಪ್ರಮಾಣದಲ್ಲಿ, ನಿರ್ದಿಷ್ಟ ಉದ್ದೇಶಕ್ಕಾಗಿ ಫಿಟ್‌ನೆಸ್‌ನ ವಾರಂಟಿಗಳಿಲ್ಲದೆಯೇ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಅನ್ನು \"ಇರುವಂತೆ\" ಒದಗಿಸಲಾಗಿದೆ, ಉಲ್ಲಂಘನೆಯಿಲ್ಲದ ಅಥವಾ ಅಡೆತಡೆಯಿಲ್ಲದೆ ಲಭ್ಯವಿದೆ. AI ಔಟ್‌ಪುಟ್‌ಗಳ ನಿಖರತೆ, ಸಂಪೂರ್ಣತೆ ಅಥವಾ ಕರೆನ್ಸಿಯನ್ನು ನಾವು ಖಾತರಿಪಡಿಸುವುದಿಲ್ಲ.",
