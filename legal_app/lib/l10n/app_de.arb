  "marketingCompareHarveyMetaTitle": "Umbrella vs. Harvey AI – Rechts-KI für Verbraucher und Unternehmen",
  "marketingCompareHarveyRows": "[object Object],[object Object],[object Object],[object Object],[object Object],[object Object]",
  "marketingCompareHarveySubtitle": "Harvey wurde ausschließlich für BigLaw- und Unternehmenskanzleien entwickelt. Umbrella bedient jeden – von Ihrer ersten Rechtsfrage bis hin zur Führung einer ganzen Praxis.",
  "marketingCompareHarveyTitle": "Umbrella vs. Harvey AI",
  "marketingCompareHarveyUmbrellaLabel": "Umbrella",
