  "tutorialsLawLibraryHelpB1": "பொருள் வரைவுகளில் நேரடியாக ஆதாரங்களை மேற்கோள் காட்டுங்கள்.",
  "tutorialsLawLibraryHelpB2": "உங்கள் நிறுவனத்தின் முதன்மை நாட்டிற்கு பொருந்தக்கூடிய அதிகார வரம்பிற்கு ஏற்ப வடிகட்டவும்.",
  "tutorialsLawLibraryHelpTitle": "சட்ட நூலகம்",
  "tutorialsLawLibrarySearchBody": "ஹைப்ரிட் முக்கிய சொல் + சொற்பொருள் தேடல் மூலம் உங்கள் அதிகார வரம்பிற்கான சட்டங்கள் மற்றும் விதிமுறைகளைத் தேடுங்கள்.",
  "tutorialsLawLibrarySearchTitle": "சட்ட நூலகம்",
  "tutorialsLeadsHelpB1": "கிளையன்ட் மற்றும் மேட்டர் புலங்களை முன் நிரப்புவதற்கு ஒரு படியில் ஒரு முன்னணியை மாற்றவும்.",
  "tutorialsLeadsHelpB2": "நிராகரிக்கப்பட்ட தடங்கள் புகாரளிப்பதற்காக காப்பகப்படுத்தப்பட்டுள்ளன.",
  "tutorialsLeadsHelpTitle": "வழிநடத்துகிறது",
  "tutorialsLeadsInboxBody": "உள்வரும் உட்கொள்ளல் தடங்களை மதிப்பாய்வு செய்யவும். வாடிக்கையாளர்களுக்கும் விஷயங்களுக்கும் தகுதியான வழிகளை தகுதிப்படுத்தி மாற்றவும்.",
  "tutorialsLeadsInboxTitle": "இன்பாக்ஸை வழிநடத்துகிறது",
  "tutorialsLegalFormsHelpB1": "சேமித்த வரைவுகள் சேமிக்கப்பட்ட வரைவுகளில் தோன்றும்.",
  "tutorialsLegalFormsHelpB2": "பில்லிங் மற்றும் தணிக்கைக்கான விஷயங்களுக்கு வெளியீடுகளை இணைக்கவும்.",
  "tutorialsLegalFormsHelpB3": "நீதிமன்ற-குறிப்பிட்ட வடிவங்களுக்கு இந்தியா அல்லது அமெரிக்க வரைவைப் பயன்படுத்தவும்.",
  "tutorialsLegalFormsHelpTitle": "சட்ட வடிவங்கள்",
  "tutorialsLegalFormsIntroBody": "யுஎஸ், யுகே, கென்யா மற்றும் இந்தியா முழுவதும் 10,000+ நீதிமன்றங்கள் மற்றும் அரசாங்க படிவங்களை உலாவவும் அல்லது உங்களுக்கு என்ன தேவை என்பதை விவரிக்கவும் மற்றும் AI உடன் வரைவு செய்யவும்.",
  "tutorialsLegalFormsIntroTitle": "அதிகாரப்பூர்வ படிவ பட்டியல்",
  "tutorialsLegalFormsWorkspaceBody": "பட்டியலைத் தேடவும், வழிகாட்டப்பட்ட கேள்விகளுக்குப் பதிலளிக்கவும் மற்றும் மதிப்பாய்வுக்குத் தயாராக நிரப்பப்பட்ட வரைவை உருவாக்கவும்.",
  "tutorialsLegalFormsWorkspaceTitle": "வரைவு பணியிடம்",
  "tutorialsMattersCreateBody": "புதிய வழக்கைத் தொடங்கி, அதை கிளையண்டுடன் இணைத்து, குழு உறுப்பினர்களை நியமிக்கவும்.",
  "tutorialsMattersCreateTitle": "ஒரு விஷயத்தைத் திறக்கவும்",
  "tutorialsMattersDetailHeaderBody": "இந்த வழக்கின் நிலை, கட்சிகள், முக்கிய தேதிகள் மற்றும் விரைவான நடவடிக்கைகள் ஆகியவற்றின் மேலோட்டம்.",
  "tutorialsMattersDetailHeaderTitle": "பொருள் மையம்",
  "tutorialsMattersDetailHelpB1": "துல்லியமான பில்லிங்கிற்காக விஷயத்திலிருந்து நேரம் மற்றும் செலவுகளை பதிவு செய்யவும்.",
  "tutorialsMattersDetailHelpB2": "ஆதாரங்களையும் ஆவணங்களையும் விஷய பெட்டகத்திற்கு பதிவேற்றவும்.",
  "tutorialsMattersDetailHelpB3": "தயாராக இருக்கும்போது போர்ட்டல் வழியாக வாடிக்கையாளர்களுடன் படிக்க மட்டும் அணுகலைப் பகிரவும்.",
  "tutorialsMattersDetailHelpTitle": "விஷய விவரம்",
  "tutorialsMattersDetailTabsBody": "காலவரிசை, ஆவணங்கள், பணிகள், பில்லிங் மற்றும் சிறப்புக் கருவிகளுக்கு இடையே மாறவும்.",
  "tutorialsMattersDetailTabsTitle": "பொருள் பிரிவுகள்",
  "tutorialsMattersDetailWorkbenchBody": "மேட்டர்-ஸ்கோப்டு AI அரட்டை, வரைவு மற்றும் பரிந்துரைக்கப்பட்ட அடுத்த படிகளுக்கு Quick AI ஐத் திறக்கவும்.",
  "tutorialsMattersDetailWorkbenchTitle": "AI விரைவு AI",
  "tutorialsMattersFilterBody": "செயலில் உள்ள வேலையை விரைவாகக் கண்டறிய, அந்தஸ்து, பயிற்சிப் பகுதி அல்லது ஒதுக்கப்பட்டவரின் அடிப்படையில் சுருக்கவும்.",
  "tutorialsMattersFilterTitle": "வடிகட்டி & தேடு",
  "tutorialsMattersHelpB1": "ஒரு விஷயம் திறக்கப்படும்போது, ​​பணிகளைத் தானாக உருவாக்க, பிளேபுக்குகளைப் பயன்படுத்தவும்.",
  "tutorialsMattersHelpB2": "வரைவு மற்றும் ஆராய்ச்சிக்கான ஒரு விஷயத்திலிருந்து AI Quick AI ஐத் திறக்கவும்.",
  "tutorialsMattersHelpB3": "நீதிமன்ற காலக்கெடு மற்றும் விளைவுகளை துணைப் பக்கங்களில் இருந்து கண்காணிக்கவும்.",
  "tutorialsMattersHelpTitle": "விஷயங்கள்",
  "tutorialsMattersListBody": "ஒவ்வொரு வரிசையும் நிலை, காலக்கெடு மற்றும் உரிமையாளரைக் காட்டுகிறது. விஷய மையத்தைத் திறக்க கிளிக் செய்யவும்.",
  "tutorialsMattersListTitle": "பொருள் குழாய்",
  "tutorialsMattersNewFormBody": "கிளையண்டை இணைக்கவும், பயிற்சிப் பகுதியைத் தேர்வு செய்யவும், தலைப்பு மற்றும் முக்கிய தேதிகளை அமைக்கவும்.",
  "tutorialsMattersNewFormTitle": "பொருள் அமைப்பு",
  "tutorialsMattersNewHelpB1": "கூட்டுப்பணியாளர்களை நியமிக்கவும், இதனால் அவர்கள் உடனடியாக பணிகளையும் ஆவணங்களையும் பார்க்கிறார்கள்.",
  "tutorialsMattersNewHelpB2": "பயிற்சி பகுதி வார்ப்புருக்கள், படிவங்கள் மற்றும் AI பரிந்துரைகளை இயக்குகிறது.",
  "tutorialsMattersNewHelpTitle": "புதிய விஷயம்",
  "tutorialsMattersNewSubmitBody": "சேமிப்பது மேட்டர் டைம்லைன் மற்றும் விருப்பமான பிளேபுக் பணிகளை உருவாக்குகிறது.",
  "tutorialsMattersNewSubmitTitle": "பொருளை உருவாக்குங்கள்",
  "tutorialsMeetingsHelpB1": "கோபிலட் மற்றும் வரைவிற்கான சூழலுக்கான விஷயங்களுடன் பதிவுகளை இணைக்கவும்.",
  "tutorialsMeetingsHelpB2": "கட்டளைத் தட்டு (⌘K) இலிருந்து டிரான்ஸ்கிரிப்ட்களைத் தேடவும்.",
  "tutorialsMeetingsHelpB3": "கிளையன்ட் கோப்புகள் அல்லது நீதிமன்ற சமர்ப்பிப்புகளுக்கான குறிப்புகளை ஏற்றுமதி செய்யவும்.",
  "tutorialsMeetingsHelpTitle": "கூட்டங்கள்",
  "tutorialsMeetingsListBody": "பதிவுகள், டிரான்ஸ்கிரிப்டுகள் மற்றும் AI சுருக்கங்களை உலாவவும். குறிப்புகளை மதிப்பாய்வு செய்ய எந்த மீட்டிங்கையும் திறக்கவும்.",
  "tutorialsMeetingsListTitle": "சந்திப்பு நூலகம்",
  "tutorialsMeetingsRecordBody": "கிளையன்ட் சந்திப்புகள், டெபாசிஷன்கள் அல்லது அழைப்புகளைப் பிடிக்கவும். டிரான்ஸ்கிரிப்டுகள் விஷயங்களை இணைக்கின்றன.",
  "tutorialsMeetingsRecordTitle": "பதிவு செய்யவும் அல்லது இறக்குமதி செய்யவும்",
  "tutorialsMonitorsCreateBody": "அதிகார வரம்பு மற்றும் தலைப்பு அடிப்படையில் ஒழுங்குமுறை மாற்றங்களைக் கண்காணிக்கவும். சட்டங்கள் புதுப்பிக்கப்படும் போது குடை விழிப்பூட்டல்களை சுருக்கமாகக் கூறுகிறது.",
  "tutorialsMonitorsCreateTitle": "ஒரு மானிட்டரை உருவாக்கவும்",
  "tutorialsMonitorsHelpB1": "உங்கள் முதன்மை அதிகார வரம்பு மற்றும் சிறந்த பயிற்சி பகுதிகளுடன் தொடங்கவும்.",
  "tutorialsMonitorsHelpB2": "முக்கியமான விழிப்பூட்டல்கள் உங்கள் டாஷ்போர்டிலும் அறிவிப்புகளிலும் வெளிப்படும்.",
  "tutorialsMonitorsHelpB3": "ஒரு ஒழுங்குமுறை மாற்றம் திறந்த விஷயங்களை எவ்வாறு பாதிக்கிறது என்பதை விளக்க கோபிலட்டிடம் கேளுங்கள்.",
  "tutorialsMonitorsHelpTitle": "ஒழுங்குமுறை கண்காணிப்பாளர்கள்",
  "tutorialsMonitorsListBody": "மானிட்டர்களை இயக்கவும் அல்லது முடக்கவும், விழிப்பூட்டல் வரலாற்றிற்கான விவரங்களைத் திறக்கவும் மற்றும் உங்கள் நடைமுறையில் வளரும்போது தலைப்புகளைச் சரிசெய்யவும்.",
  "tutorialsMonitorsListTitle": "உங்கள் கண்காணிப்பாளர்கள்",
  "tutorialsOnboardingHelpB1": "கூட்டாளிகளை அழைப்பதற்கு முன் கூட்டாளர்கள் அனைத்து நடவடிக்கைகளையும் முடிக்க வேண்டும்.",
  "tutorialsOnboardingHelpB2": "அமைப்புகளில் இருந்து எப்போது வேண்டுமானாலும் இங்கு திரும்பலாம்.",
  "tutorialsOnboardingHelpTitle": "ஆன்போர்டிங்",
  "tutorialsOnboardingWizardBody": "உங்கள் பணியிடத்தை செயல்படுத்த முழு சுயவிவரம், பில்லிங், குழு அழைப்புகள் மற்றும் AI கொள்கை படிகள்.",
  "tutorialsOnboardingWizardTitle": "நிறுவன அமைப்பு",
  "tutorialsPreBillHelpB1": "இறுதி விலைப்பட்டியல்களை உருவாக்கும் முன் முன் பில்களை அங்கீகரிக்கவும்.",
  "tutorialsPreBillHelpB2": "கூட்டாளர் மதிப்பாய்வு தேவைப்படும் உள்ளீடுகளைக் கொடியிடவும்.",
  "tutorialsPreBillHelpTitle": "முன் பில்",
  "tutorialsPreBillWorkspaceBody": "விலைப்பட்டியலுக்கு முன் நேர உள்ளீடுகள் மற்றும் செலவுகளை மதிப்பாய்வு செய்யவும். விவரிப்புகள், எழுதுதல்கள் மற்றும் பிளவுகளை இங்கே திருத்தவும்.",
  "tutorialsPreBillWorkspaceTitle": "முன் மசோதா மதிப்பாய்வு",
  "tutorialsProfileFormBody": "பெயர், தொடர்பு விவரங்கள், அறிவிப்பு விருப்பத்தேர்வுகள் மற்றும் கடவுச்சொல்லைப் புதுப்பிக்கவும்.",
  "tutorialsProfileFormTitle": "உங்கள் சுயவிவரம்",
  "tutorialsProfileHelpB1": "அவசர காலக்கெடு விழிப்பூட்டல்களுக்கு ஃபோனை தற்போதைய நிலையில் வைத்திருங்கள்.",
  "tutorialsProfileHelpB2": "பங்கு மற்றும் அனுமதிகள் நிறுவன நிர்வாகிகளால் நிர்வகிக்கப்படுகின்றன.",
  "tutorialsProfileHelpTitle": "சுயவிவரம்",
  "tutorialsQueuesGridBody": "உட்கொள்ளல், பில்லிங் மற்றும் பணி வரிசைகள் நிறுவனம் முழுவதும் என்ன நடவடிக்கை தேவை என்பதைக் காட்டுகின்றன - உருப்படிகளைத் தீர்க்க கிளிக் செய்யவும்.",
  "tutorialsQueuesGridTitle": "வேலை வரிசைகள்",
  "tutorialsQueuesHelpB1": "அமைப்பிற்காக காத்திருக்கும் புதிய விஷயங்களுக்கு தினசரி உட்கொள்ளும் வரிசையைச் சரிபார்க்கவும்.",
  "tutorialsQueuesHelpB2": "நிதிப் பொறுப்புகள் பில்லிங் ஒப்புதல் வரிசைகளை இங்கே பார்க்கின்றன.",
  "tutorialsQueuesHelpTitle": "வரிசைகள்",
  "tutorialsReferralsHelpB1": "நிலுவையில் உள்ள மற்றும் முடிக்கப்பட்ட பரிந்துரைகளை இங்கே கண்காணிக்கவும்.",
  "tutorialsReferralsHelpB2": "AI பயன்பாட்டிற்கு பரிந்துரை வரவுகள் பொருந்தும்.",
  "tutorialsReferralsHelpTitle": "பரிந்துரைகள்",
  "tutorialsReferralsShareBody": "உங்கள் பரிந்துரை இணைப்பைப் பகிரவும். புதிய நிறுவனங்கள் அல்லது நுகர்வோர் பதிவு செய்து குழுசேரும்போது கிரெடிட்களைப் பெறுங்கள்.",
  "tutorialsReferralsShareTitle": "சக ஊழியர்களைப் பார்க்கவும்",
  "tutorialsReportsHeaderBody": "தொழில் அளவுகோல்களுடன் ஒப்பிடும்போது பயன்பாடு, உணர்தல், சேகரிப்புகள் மற்றும் குழாய் அளவீடுகள்.",
  "tutorialsReportsHeaderTitle": "உறுதியான பகுப்பாய்வு",
  "tutorialsReportsHelpB1": "கூட்டாளர் சந்திப்புகளுக்கான சுருக்கங்களை ஏற்றுமதி செய்யவும்.",
  "tutorialsReportsHelpB2": "உங்களிடம் போதுமான மூடிய விஷயங்கள் இருக்கும்போது விளைவு வரையறைகளை ஒப்பிடவும்.",
  "tutorialsReportsHelpB3": "தொழில்முறைத் திட்டம் அல்லது அதற்கு மேற்பட்டவை தேவை.",
  "tutorialsReportsHelpTitle": "அறிக்கைகள்",
  "tutorialsReportsKpisBody": "பச்சை குறிகாட்டிகள் இலக்குகளை வெல்லும். கீழே இணைக்கப்பட்ட கார்டுகளில் இருந்து நிதி அல்லது விஷயங்களில் பயிற்சி செய்யுங்கள்.",
  "tutorialsReportsKpisTitle": "செயல்திறன் KPIகள்",
  "tutorialsResearchHelpB1": "துல்லியம் முக்கியமானதாக இருக்கும்போது சரிபார்க்கப்பட்ட பயன்முறையைப் பயன்படுத்தவும்; விரைவான நோக்குநிலைக்கான வேகமான பயன்முறை.",
  "tutorialsResearchHelpB2": "ஆராய்ச்சி உங்கள் நிறுவனத்தின் AI கிரெடிட் இருப்பைப் பயன்படுத்துகிறது.",
  "tutorialsResearchHelpB3": "வாடிக்கையாளர்களுக்குத் தாக்கல் செய்வதற்கு அல்லது ஆலோசனை வழங்குவதற்கு முன் எப்போதும் மேற்கோள்களைச் சரிபார்க்கவும்.",
  "tutorialsResearchHelpTitle": "சட்ட ஆய்வு",
  "tutorialsResearchQueryBody": "சட்டச் சிக்கல் மற்றும் அதிகார வரம்பை விவரிக்கவும். உண்மைகளைப் பற்றி குறிப்பாக இருங்கள் - சிறந்த உள்ளீடுகள் சிறந்த மேற்கோள்களை உருவாக்குகின்றன.",
  "tutorialsResearchQueryTitle": "உங்கள் ஆராய்ச்சி கேள்வியைக் கேளுங்கள்",
  "tutorialsResearchResultsBody": "நீங்கள் ஆராய்ச்சியை நடத்திய பிறகு, மேற்கோள்களை இங்கே சரிபார்க்கவும். ஒரு விஷயத்தில் சேமிக்கவும் அல்லது வரைவுகளாக ஏற்றுமதி செய்யவும்.",
  "tutorialsResearchResultsTitle": "மேற்கோள் காட்டப்பட்ட பதில்களை மதிப்பாய்வு செய்யவும்",
  "tutorialsResearchSourcesBody": "சட்டங்கள், வழக்குச் சட்டம் மற்றும் உறுதியான வால்ட் ஆதாரங்களைச் சேர்க்க வேண்டும். வேகமான, அதிக கவனம் செலுத்தும் பதில்களுக்கான குறுகிய ஆதாரங்கள்.",
  "tutorialsResearchSourcesTitle": "அறிவு ஆதாரங்களைத் தேர்ந்தெடுக்கவும்",
  "tutorialsSavedDraftsHelpB1": "வரைவுகள் குத்தகைதாரரின் நோக்கம் மற்றும் தணிக்கை செய்யக்கூடியவை.",
  "tutorialsSavedDraftsHelpB2": "தொடர்ந்து திருத்த அல்லது ஏற்றுமதி செய்ய வரைவைத் திறக்கவும்.",
  "tutorialsSavedDraftsHelpTitle": "சேமிக்கப்பட்ட வரைவுகள்",
  "tutorialsSavedDraftsListBody": "சட்டப் படிவங்கள், இந்தியா/அமெரிக்க வரைவு அல்லது கோபிலட் ஆகியவற்றிலிருந்து சேமிக்கப்பட்ட AI வரைவை மீண்டும் தொடங்கவும்.",
  "tutorialsSavedDraftsListTitle": "வரைவு வரலாறு",
  "tutorialsSectionFinderHelpB1": "மேற்கோள் காட்டுவதற்கு முன் உத்தியோகபூர்வ வெற்றுச் செயல்களுக்கு எதிரான முடிவுகளைச் சரிபார்க்கவும்.",
  "tutorialsSectionFinderHelpB2": "மேட்டர் வரைவுகளில் தேடல் முடிவுகளை ஏற்றுமதி செய்யவும்.",
  "tutorialsSectionFinderHelpTitle": "பிரிவு கண்டுபிடிப்பான்",
  "tutorialsSectionFinderWorkspaceBody": "IPC→BNS, CrPC→BNSS குறுக்குவழிகள் அல்லது US குறியீடு பிரிவுகளைத் தேடுங்கள். பிரபலமான வினவல்கள் விரைவாகத் தொடங்க உங்களுக்கு உதவுகின்றன.",
  "tutorialsSectionFinderWorkspaceTitle": "பிரிவுகளைப் பார்க்கவும்",
  "tutorialsSettingsHelpB1": "கூட்டாளர் நிர்வாகிகள் மட்டுமே நிறுவன அளவிலான நிர்வாகத்தை மாற்ற முடியும்.",
  "tutorialsSettingsHelpB2": "பயிற்சி அம்சங்களை இயக்கும் முன் AI கொள்கை மற்றும் தரவு ஒப்புதலை மதிப்பாய்வு செய்யவும்.",
  "tutorialsSettingsHelpTitle": "அமைப்புகள்",
  "tutorialsSettingsHubBody": "இந்த மையத்திலிருந்து பயனர்கள், பில்லிங், AI கொள்கை, ஒருங்கிணைப்புகள் மற்றும் இணக்கம் ஆகியவற்றை உள்ளமைக்கவும்.",
  "tutorialsSettingsHubTitle": "அமைப்புகள்",
  "tutorialsShellCommandPaletteBody": "எந்தப் பக்கத்திற்கும் செல்ல ⌘K (அல்லது Ctrl+K) ஐ அழுத்தவும், Copilot ஐத் திறக்கவும் அல்லது விஷயத்தை உருவாக்குவது போன்ற பொதுவான செயல்களைத் தொடங்கவும்.",
  "tutorialsShellCommandPaletteTitle": "கட்டளை தட்டு",
  "tutorialsShellCopilotBody": "உங்கள் தற்போதைய பக்கம் அல்லது விஷயத்தின் சூழலில் Copilot கேள்விகளைக் கேளுங்கள். மேல் பட்டியில் உள்ள பிரகாசி பொத்தானை அல்லது இந்த மிதக்கும் பொத்தானைப் பயன்படுத்தவும்.",
  "tutorialsShellCopilotTitle": "AI கோபிலட்",
  "tutorialsShellHelpB1": "முக்கிய பணிப்பாய்வுகளுக்கு பக்கப்பட்டியையும், விரைவான தாவல்களுக்கு ⌘Kஐயும் பயன்படுத்தவும்.",
  "tutorialsShellHelpB2": "நீங்கள் இருக்கும் பக்கத்தை Copilot புரிந்துகொள்கிறார்—உங்களுக்கு வழிகாட்டுதல் தேவைப்படும்போது அதைத் திறக்கவும்.",
  "tutorialsShellHelpB3": "மேல் பட்டியில் உள்ள உதவி மெனுவிலிருந்து இந்தப் பயணத்தை மீண்டும் இயக்கவும்.",
  "tutorialsShellHelpTitle": "சுற்றி வருகிறது",
  "tutorialsShellNotificationsBody": "அவசர காலக்கெடு, KYC உருப்படிகள், பில்லிங் விழிப்பூட்டல்கள் மற்றும் கணினி செய்திகள் இங்கே தோன்றும்.",
  "tutorialsShellNotificationsTitle": "அறிவிப்புகள் & எச்சரிக்கைகள்",
  "tutorialsShellProfileBody": "அமைப்புகளை நிர்வகிக்க, உங்கள் பங்கைப் பார்க்க மற்றும் வெளியேற உங்கள் சுயவிவர மெனுவைத் திறக்கவும்.",
  "tutorialsShellProfileTitle": "உங்கள் கணக்கு",
  "tutorialsShellSearchBody": "பயன்பாட்டில் எங்கிருந்தும் வாடிக்கையாளர்கள், விஷயங்கள், ஆவணங்கள் மற்றும் பணிகளைத் தேடுங்கள்.",
  "tutorialsShellSearchTitle": "உலகளாவிய தேடல்",
  "tutorialsShellSidebarBody": "கிளையண்டுகள், விஷயங்கள், பில்லிங், ஆவணங்கள் மற்றும் பலவற்றிற்கு இடையே செல்ல பக்கப்பட்டியைப் பயன்படுத்தவும். வழிசெலுத்தலை நேர்த்தியாக வைத்திருக்க பிரிவுகள் சுருக்கப்படுகின்றன.",
  "tutorialsShellSidebarTitle": "உங்கள் உறுதியான பணியிடம்",
  "tutorialsTasksCreateBody": "காலக்கெடுவைச் சேர்க்கவும், உரிமையாளர்களை ஒதுக்கவும் மற்றும் விஷயங்களுக்கு பணிகளை இணைக்கவும்.",
  "tutorialsTasksCreateTitle": "பணிகளை உருவாக்கவும்",
  "tutorialsTasksHelpB1": "தாமதமான பணிகள் உங்கள் டாஷ்போர்டில் தானாகவே தோன்றும்.",
  "tutorialsTasksHelpB2": "ஆட்டோமேஷன்கள் விளையாட்டு புத்தகங்கள் மற்றும் நீதிமன்ற காலக்கெடுவிலிருந்து பணிகளை உருவாக்க முடியும்.",
  "tutorialsTasksHelpB3": "ஒரு விஷயத்தில் திறந்த பணிகளைச் சுருக்கமாக Copilot ஐப் பயன்படுத்தவும்.",
  "tutorialsTasksHelpTitle": "பணிகள்",
  "tutorialsTasksListBody": "நிலுவைத் தேதி, முன்னுரிமை அல்லது ஒதுக்கப்பட்டவர் மூலம் வடிகட்டவும். வேலை முன்னேறும்போது முடிந்தது எனக் குறிக்கவும்.",
  "tutorialsTasksListTitle": "பணி வரிசை",
  "tutorialsTeamHelpB1": "பாத்திரங்கள் பக்கப்பட்டியின் தெரிவுநிலை மற்றும் கோபிலட் அனுமதிகளைத் தீர்மானிக்கின்றன.",
  "tutorialsTeamHelpB2": "தணிக்கை வரலாற்றைப் பாதுகாக்க பயனர்களை நீக்குவதற்குப் பதிலாக செயலிழக்கச் செய்யவும்.",
  "tutorialsTeamHelpTitle": "குழு",
  "tutorialsTeamInviteBody": "சக ஊழியர்களை அழைத்து, பில்லிங், விஷயங்கள் மற்றும் அமைப்புகளுக்கான அணுகலைக் கட்டுப்படுத்தும் பாத்திரங்களை ஒதுக்கவும்.",
  "tutorialsTeamInviteTitle": "குழு நிர்வாகம்",
  "tutorialsTemplatesHelpB1": "வேகமாக வரைவதற்கான பயிற்சி பகுதி மூலம் ஒழுங்கமைக்கவும்.",
  "tutorialsTemplatesHelpB2": "வரலாற்றை இழக்காமல் பதிப்புகளைத் திருத்தவும்.",
  "tutorialsTemplatesHelpTitle": "வார்ப்புருக்கள்",
  "tutorialsTemplatesUploadBody": "தானியங்கு உருவாக்கத்திற்காக, ஒன்றிணைப்பு மாறிகள் (எ.கா. கிளையன்ட் பெயர்) கொண்ட உறுதியான டெம்ப்ளேட்களைப் பதிவேற்றவும்.",
  "tutorialsTemplatesUploadTitle": "ஆவண வார்ப்புருக்கள்",
  "tutorialsTimeHelpB1": "துல்லியமான நேரப் பதிவுகள் பில் முன் ஆய்வு.",
  "tutorialsTimeHelpB2": "பொருள் இணைப்புகளைப் பயன்படுத்தவும், இதன் மூலம் நிதி சரியாக விலைப்பட்டியல் செய்ய முடியும்.",
  "tutorialsTimeHelpTitle": "நேரம் கண்காணிப்பு",
  "tutorialsTimeListBody": "ப்ரீ-பில் மற்றும் இன்வாய்ஸ் செய்வதற்கு முன் உள்ளீடுகளை மதிப்பாய்வு செய்து திருத்தவும்.",
  "tutorialsTimeListTitle": "நேர உள்ளீடுகள்",
  "tutorialsTimeLogBody": "விஷயங்களுக்கு எதிராக பில் செய்யக்கூடிய மற்றும் பில் செய்ய முடியாத மணிநேரங்களை பதிவு செய்யவும்.",
  "tutorialsTimeLogTitle": "பதிவு நேரம்",
  "tutorialsTrustBalancesBody": "வாடிக்கையாளர் நம்பிக்கை நிலுவைகள், நிலுவையில் உள்ள ஒப்புதல்கள் மற்றும் நல்லிணக்கம் ஆகியவற்றைக் கண்காணிக்கவும்.",
  "tutorialsTrustBalancesTitle": "நம்பிக்கை கணக்கு",
  "tutorialsTrustHelpB1": "நம்பிக்கை மற்றும் செயல்பாட்டு நிதிகளை ஒருபோதும் இணைக்க வேண்டாம்.",
  "tutorialsTrustHelpB2": "நடவடிக்கை தேவைப்படும்போது உங்கள் டாஷ்போர்டில் ஒப்புதல் விழிப்பூட்டல்கள் தோன்றும்.",
  "tutorialsTrustHelpTitle": "நம்பிக்கை",
  "tutorialsUsDraftingHelpB1": "தாக்கல் செய்வதற்கு முன் உள்ளூர் நீதிமன்ற விதிகளை உறுதிப்படுத்தவும்.",
  "tutorialsUsDraftingHelpB2": "நேரத்தைக் கண்காணிப்பதற்கான விஷயங்களில் வரைவுகளைச் சேமிக்கவும்.",
  "tutorialsUsDraftingHelpTitle": "அமெரிக்க வரைவு",
  "tutorialsUsDraftingWorkspaceBody": "ஃபெடரல் மற்றும் ஸ்டேட் மோஷன் டெம்ப்ளேட்கள், அதிகார வரம்பில் விழிப்புணர்வு தூண்டுதல்கள் மற்றும் மேற்கோள் உதவியாளர்களுடன்.",
  "tutorialsUsDraftingWorkspaceTitle": "அமெரிக்க நீதிமன்ற வரைவு",
  "tutorialsVaultHelpB1": "பதிவேற்றப்பட்ட கார்போரா முழுவதும் மொத்த விடாமுயற்சி வினவல்களை இயக்கவும்.",
  "tutorialsVaultHelpB2": "முடிவுகள் பொருள் மற்றும் வாடிக்கையாளர் அணுகல் கட்டுப்பாடுகளை மதிக்கின்றன.",
  "tutorialsVaultHelpTitle": "வால்ட்",
  "tutorialsVaultSearchBody": "உறுதியான நினைவகம் முழுவதும் பொருள் தேடல் - கடந்த கால விஷயங்கள், குறிப்புகள் மற்றும் விடாமுயற்சி தொகுப்புகள்.",
  "tutorialsVaultSearchTitle": "உறுதியான பெட்டகம்",
  "tutorialsWelcomeB1": "தேடல் அல்லது ⌘K மூலம் எங்கும் செல்லவும்",
  "tutorialsWelcomeB2": "நீங்கள் இருக்கும் பக்கத்தை Copilot புரிந்துகொள்கிறார்",
  "tutorialsWelcomeB3": "உங்களுக்கு புத்துணர்ச்சி தேவைப்படும் போதெல்லாம் உதவியிலிருந்து எந்த ஒரு சுற்றுப்பயணத்தையும் மீண்டும் இயக்கவும்",
  "tutorialsWelcomeBody": "இரண்டு நிமிட சுற்றுப்பயணம் வாடிக்கையாளர்கள், விஷயங்கள், பில்லிங் மற்றும் AI கோபிலட் ஆகியவற்றை எங்கு கண்டுபிடிப்பது என்பதைக் காட்டுகிறது.",
  "tutorialsWelcomeSkip": "இப்போதைக்கு தவிர்க்கவும்",
  "tutorialsWelcomeStart": "சுற்றுப்பயணத்தைத் தொடங்கவும்",
  "tutorialsWelcomeTitle": "குடைக்கு வரவேற்கிறோம்"
}
