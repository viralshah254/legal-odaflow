# Umbrella Flutter

APP_NAME=Umbrella
API_URL=https://legal-api.odaflow.com/api/v1
# Local development override:
# API_URL=http://localhost:4000/api/v1
WEB_URL=http://localhost:3000
APP_ENV=development

# Default jurisdiction for consumer/lawyer onboarding (ISO 3166-1 alpha-2).
# Supported: US (USD), IN (INR), KE (KES), GB (GBP). Pass via --dart-define=DEFAULT_COUNTRY=KE
DEFAULT_COUNTRY=IN
SUPPORTED_COUNTRIES=IN,US,KE,GB

ENABLE_CONSUMER_APP=true
ENABLE_LAWYER_MODE=true
ENABLE_LAWYER_APP=true
ENABLE_DOCUMENT_UPLOAD=true
ENABLE_LAWYER_REVIEW=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Firebase is configured via native files + lib/core/firebase/firebase_options.dart:
#   android/app/google-services.json
#   ios/Runner/GoogleService-Info.plist
#   ios/Runner/Info.plist (GIDClientID + URL scheme for Google Sign-In)
#
# Android Google Sign-In also needs the web OAuth client ID:
# GOOGLE_WEB_CLIENT_ID=1034275934580-rm58bb4bj2csrpasbmngbfqd1ndqv96q.apps.googleusercontent.com
# iOS Google Sign-In uses the iOS client ID (also in ios/Runner/Info.plist GIDClientID):
# GOOGLE_IOS_CLIENT_ID=1034275934580-2sn8vugf9vum4js1n7ma0s796mihfmju.apps.googleusercontent.com

SENTRY_DSN=
POSTHOG_KEY=

Local debug (Cursor / VS Code): use **Run and Debug → Umbrella (local API)**.
Copy `config/dart_defines.local.example.json` to `config/dart_defines.local.json` and edit there.

CLI equivalent:
```bash
flutter pub get
flutter run --dart-define-from-file=config/dart_defines.local.json
```

Release:
```bash
flutter build apk --release --dart-define=API_URL=https://legal-api.odaflow.com/api/v1 --dart-define=APP_ENV=production
```

See [`../shared/theme/tokens.json`](../shared/theme/tokens.json) for shared design tokens.
